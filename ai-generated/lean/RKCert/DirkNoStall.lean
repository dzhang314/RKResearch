module

public import RKCert.DirkRanks

@[expose] public section

/-! # Nonstall statements for the original unrestricted-DIRK filtrations

These statements concern the spaces of all actual stage trees and of all
same-order normalized tree differences. They do not assume a proposed
quotient stage basis or that either space is generated by a single defect.
-/
namespace RKCert.Paired
variable {K : Type*} [Field K] {s p j : ℕ} {A : Fin s → Fin s → K} {b : Vec K s}

theorem dirk_treeSpace_lt_succ (ha : ∀ i j : Fin s, i.val < j.val → A i j=0)
    (ho : HasTreeOrderAtLeast A b p) (hj : j+4≤p) :
    treeSpace A j < treeSpace A (j+1) := by
  refine lt_of_le_of_ne (treeSpace_mono A (by omega)) ?_
  intro eqn
  let W := annih (treeSpace A j)
  have hN (u) (hu : u∈W) : transMat A u ∈ W := by
    apply mem_annih.mpr; intro v hv
    rw [row_flip_mat]
    apply mem_annih.mp hu
    rw [eqn]
    exact mat_treeSpace A j hv
  have hD (u) (hu : u∈W) : diag (mirror A) u ∈ W := by
    apply mem_annih.mpr; intro v hv
    rw [row_flip_diag]
    apply mem_annih.mp hu
    rw [eqn]
    exact mirror_treeSpace A j hv
  have h₃ : q₃ (transMat A) (mirror A) b ∈ W := by
    rw [back_seed3]
    apply mem_annih.mpr
    exact reflected_treeSpace ho j 2 (by decide) (by omega)
  have h := mem_of_invariant_two_seeds Fin.revPerm (transMat A) _ (causalDiag_transpose ha)
    (mirror A) b W hN hD (backSeed2_annih ho (by omega : j+3≤p)) h₃
  exact back_target_nonzero ho (by omega)
    (mem_annih.mp h 1 (stageWeight_mem_space A .leaf (by change 1≤j+1; omega)))

theorem dirk_zeroSpace_lt_succ (ha : ∀ i j : Fin s, i.val < j.val → A i j=0)
    (ho : HasTreeOrderAtLeast A b p) (hl : 2≤j) (hj : j+1≤p) :
    zeroSpace A j < zeroSpace A (j+1) := by
  refine lt_of_le_of_ne (zeroSpace_mono A (by omega)) ?_
  intro eqn
  have hg : q₃ (mat A) (nodes A) 1 ∈ zeroSpace A j := by
    rw [eqn]; exact zeroSpace_mono A (by omega) (front_seed3 A)
  have hz := mem_of_invariant_two_seeds (Equiv.refl _) (mat A) _ (causalDiag_mat ha)
    (nodes A) 1 (zeroSpace A j)
    (fun x hx => by rw [eqn]; exact mat_zeroSpace ho j hj hx)
    (fun x hx => by rw [eqn]; exact diag_zeroSpace A j hx)
    (zeroSpace_mono A hl (forward_seed_mem A)) hg
  have ht : normTree A (Tree.bush 1) = diag (nodes A) 1 := by ext i; simp [normTree_bush]
  have hh := probe_normTree ho (Tree.bush 1) 0 (by simp; omega)
  rw [ht, show probe A b 0 (diag (nodes A) 1)=0 from probe_zeroSpace ho (by omega : 0+j+1≤p) hz,
    mul_zero] at hh
  exact zero_ne_one hh

end RKCert.Paired
