    linear_combination (-(3797046215174078563840/119217562591698293)*u^5*v + (664368769016640970880/357652687775094879)*u^5 + (9100822016821414611160/119217562591698293)*u^4*v^2 + (39970285332720156405160/357652687775094879)*u^4*v - (689568091916483582740/119217562591698293)*u^4 - (14838017670890567296000/357652687775094879)*u^3*v^3 - (160465498172752851161200/1072958063325284637)*u^3*v^2 - (170347566481014640504544/1072958063325284637)*u^3*v + (7129181018054607689656/1072958063325284637)*u^3 - (79352234176177618392880/1072958063325284637)*u^2*v^3 + (181642210803832427632940/3218874189975853911)*u^2*v^2 + (370583498794794559604228/3218874189975853911)*u^2*v - (369043645986884829149026/106222848269203179063)*u^2 + (29676035341781134592000/357652687775094879)*u*v^4 + (749691296202201043074800/3218874189975853911)*u*v^3 + (361039772162459338601600/9656622569927561733)*u*v^2 - (1483989047450995009312880/35407616089734393021)*u*v + (9435257013327826098008/11802538696578131007)*u - (84462562126607844608000/1072958063325284637)*v^4 - (382692482082852331528640/3218874189975853911)*v^3 - (240791812328778849185450/11802538696578131007)*v^2 + (200103298066418876595967/35407616089734393021)*v - (4879185821126022813461/106222848269203179063))*hz0 + (-(7594092430348157127680/357652687775094879)*u^5*v + (1328737538033281941760/1072958063325284637)*u^5 + (18201644033642829222320/357652687775094879)*u^4*v^2 + (26014015852617757842800/357652687775094879)*u^4*v - (12080041269988384003880/3218874189975853911)*u^4 - (29676035341781134592000/1072958063325284637)*u^3*v^3 - (307279763320273580405660/3218874189975853911)*u^3*v^2 - (323747627267808465657580/3218874189975853911)*u^3*v + (40203524709916782792310/9656622569927561733)*u^3 - (166123477187800520433760/3218874189975853911)*u^2*v^3 + (287806937393376471214784/9656622569927561733)*u^2*v^2 + (25299280523528261620840/357652687775094879)*u^2*v - (73749123393768933624248/35407616089734393021)*u^2 + (59352070683562269184000/10729580633252