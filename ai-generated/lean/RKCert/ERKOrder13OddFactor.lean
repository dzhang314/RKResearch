  · have hz := (mul_eq_zero.mp ((fit w).symm.trans he)).resolve_right hq
    have hp : v=u*w-w^2 := by linear_combination hz
    rw [hp] at z0 z1 h
    have hz0 : -1716*u^5*w + 6864*u^4*w^2 + 5544*u^4*w - 12012*u^3*w^3 - 16632*u^3*w^2 - 6930*u^3*w + 10296*u^2*w^4 + 22176*u^2*w^3 + 13860*u^2*w^2 + 4200*u^2*w - 5148*u*w^5 - 11088*u*w^4 - 13860*u*w^3 - 4200*u*w^2 - 1260*u*w + 1716*w^6 + 6930*w^4 + 1260*w^2 + 7=0 := by linear_combination z0
    have hz1 : 1716*u^5 - 6864*u^4*w - 5544*u^4 + 12012*u^3*w^2 + 16632*u^3*w + 6930*u^3 - 10296*u^2*w^3 - 22176*u^2*w^2 - 13860*u^2*w - 4200*u^2 + 5148*u*w^4 + 11088*u*w^3 + 13860*u*w^2 + 4200*u*w + 1260*u - 5544*w^4 - 4200*w^2 - 168=0 := by linear_combination z1
    have hm : 858*u^4*w^2 - 2002*u^3*w^3 - 2772*u^3*w^2 + 2717*u^2*w^4 + 3696*u^2*w^3 + 3465*u^2*w^2 - (3289/5)*u*w^5 - 5082*u*w^4 - 1155*u*w^3 - 2100*u*w^2 + 1573*w^6 - (14784/5)*w^5 + (10395/2)*w^4 - 1400*w^3 + 630*w^2=0 := by linear_combination h
    apply (one_ne_zero : (1:K)≠0)
    linear_combination (()*u^6*w^3 + ()*u^6*w^2 + ()*u^6*w + ()*u^6 - ()*u^5*w^4 + ()*u^5*w^3 - ()*u^5*w^2 - ()*u^5*w - ()*u^5 - ()*u^4*w^5 + ()*u^4*w^4 - ()*u^4*w^3 + ()*u^4*w^2 + ()*u^4*w + ()*u^4 + ()*u^3*w^6 - ()*u^3*w^5 - ()*u^3*w^4 + ()*u^3*w^3 - ()*u^3*w^2 - ()*u^3*w - ()*u^3 + ()*u^2*w^7 - ()*u^2*w^6 + ()*u^2*w^5 - ()*u^2*w^4 + ()*u^2*w^3 + ()*u^2*w^2 + ()*u^2*w + ()*u^2 - ()*u*w^8 + ()*u*w^7 - ()*u*w^6 - ()*u*w^5 + ()*u*w^4 - ()*u*w^3 + ()*u*w^2 - ()*u*w - ()*u + ()*w^8 - ()*w^7 + ()*w^6 - ()*w^5 + ()*w^4 - ()*w^3 + ()*w^2 + ()*w + ())*hz0 + (()*u^6*w^4 + ()*u^6*w^3 + ()*u^6*w^2 + ()*u^6*w - ()*u^5*w^5 + ()*u^5*w^4 - ()*u^5*w^3 - ()*u^5*w^2 - ()*u^5*w - ()*u^4*w^6 + ()*u^4*w^5 - ()*u^4*w^4 + ()*u^4*w^3 + ()*u^4*w^2 + ()*u^4*w + ()*u^3*w^7 + ()*u^3*w^6 - ()*u^3*w^5 + ()*u^3*w^4 - ()*u^3*w^3 - ()*u^3*w^2 - ()*u^3*w + ()*u^2*w^8 - ()*u^2*w^7 + ()*u^2*w^6 - ()*u^2*w^5 - ()*u^2*w^4 + ()*u^2*w^3 + ()*u^2*w^2 + ()*u^2*w - ()*u*w^9 + ()*u*w^8 - ()*u*w^7 - ()*u*w^6 + ()*u*w^5 - ()*u*w^4 - ()*u*w^3 + ()*u*w^2 - ()*u*w - ()*u + ()*w^9 - ()*w^8 + ()*w^7 - ()*w^6 + ()*w^5 + ()*w^4 - ()*w^3 + ()*w^2 + ()*w + ())*hz1 + (-()*u^6*w^3 + ()*u^6*w^2 - ()*u^6*w + ()*u^6 - ()*u^5*w^4 + ()*u^5*w^3 - ()*u^5*w^2 + ()*u^5*w - ()*u^5 + ()*u^4*w^5 - ()*u^4*w^4 - ()*u^4*w^3 + ()*u^4*w^2 - ()*u^4*w + ()*u^4 + ()*u^3*w^6 - ()*u^3*w^5 + ()*u^3*w^4 - ()*u^3*w^3 + ()*u^3*w^2 - ()*u^3*w - ()*u^3 - ()*u^2*w^7 + ()*u^2*w^6 - ()*u^2*w^5 + ()*u^2*w^4 + ()*u^2*w^3 - ()*u^2*w^2 + ()*u^2*w - ()*u^2 + ()*u*w^8 - ()*u*w^7 + ()*u*w^6 + ()*u*w^5 - ()*u*w^4 + ()*u*w^3 - ()*u*w^2 + ()*u*w - ()*u - ()*w^8 + ()*w^7 - ()*w^6 + ()*w^5 - ()*w^4 + ()*w^3 - ()*w^2 + ()*w + ())*hm

noncomputable def oddSixPoly : K[X] := 1716*X^6 - 5544*X^5 + 6930*X^4 - 4200*X^3 + 1260*X^2 - 168*X + 7

omit [CharZero K] in
@[simp] theorem oddSixPoly_eval (x:K) : (oddSixPoly:K[X]).eval x=oddSixValue x := by
  simp [oddSixPoly,oddSixValue]

theorem oddSixPoly_degree : (oddSixPoly:K[X]).natDegree=6 := by
  unfold oddSixPoly
  compute_degree!

theorem odd6_as_oddSix : (odd6:K[X])=X*oddSixPoly := by
  apply @Polynomial.funext K _ _ (Infinite.of_injective (fun n:ℕ=>(n:K)) Nat.cast_injective)
  intro z
  classical
  rw [odd6,from11,ofFn_eq_sum_monomial,eval_finsetSum]
  norm_num [Fin.sum_univ_succ,oddSixValue]
  ring

/-- Literal full odd p13 divisor theorem, no normalization or splitting hypothesis. -/
theorem fixed13_odd_divisor_nonzero (P:K[X]) (hP:P.natDegree=4) (hf:P∣oddSixPoly) (w:K)
    (hw:w=1 ∨ oddSixValue w=0 ∧ P.eval w≠0) :
    (Paired.primitive (X*P)).eval w≠0 := by
  obtain ⟨Q,fit⟩:=hf
  have hd := oddSixPoly_degree (K:=K)
  have Dn : (oddSixPoly:K[X])≠0 := by intro h;rw [h,natDegree_zero] at hd;omega
  have pn : P≠0 := fun h=>Dn (by simp [fit,h])
  have qn : Q≠0 := fun h=>Dn (by simp [fit,h])
  have qd : Q.natDegree=2 := by rw [fit,natDegree_mul pn qn,hP] at hd;omega
  let a := Q.leadingCoeff
  have an : a≠0 := leadingCoeff_ne_zero.mpr qn
  let u := -Q.coeff 1/a
  let v := Q.coeff 0/a
  have scale (x:K) :
      evalFour (a*P.coeff 0) (a*P.coeff 1) (a*P.coeff 2) (a*P.coeff 3) (a*P.coeff 4) x =
      a*P.eval x := by rw [evalFour_of_small P (by omega) x];unfold evalFour;ring
  have actual (x:K) : oddSixValue x=(x^2-u*x+v)*
      evalFour (a*P.coeff 0) (a*P.coeff 1) (a*P.coeff 2) (a*P.coeff 3) (a*P.coeff 4) x := by
    rw [scale,←oddSixPoly_eval,fit,eval_mul,eval_eq_sum_range' (p:=Q) (n:=3) (by omega)]
    have hl : Q.coeff 2=a := by rw [←qd];rfl
    simp only [Finset.sum_range_succ,Finset.range_zero,Finset.sum_empty,pow_zero,pow_one,
      mul_one,zero_add,hl]
    dsimp [u,v]
    field_simp
    ring
  have hsub : w=1 ∨ oddSixValue w=0 ∧
      evalFour (a*P.coeff 0) (a*P.coeff 1) (a*P.coeff 2) (a*P.coeff 3) (a*P.coeff 4) w≠0 := by
    rw [scale]
    exact hw.imp id (fun t=>⟨t.1,mul_ne_zero an t.2⟩)
  intro hm
  rw [RKCert.Paired.OrderTwelve.pure_primitive_formula P (by omega)] at hm
  apply fixed13_odd_quartic_gate u v w _ _ _ _ _ actual hsub
  unfold purePolynomialMoment pureMoment at hm
  unfold pureMoment
  linear_combination a*hm

end RKCert.Paired.FiniteMidpoint
