/-! # Fixed order-fourteen quartic factors, no root-splitting assumption
The complementary quadratic is handled by its literal two coefficients,
both at the virtual endpoint and at a supplied off-factor root. -/
namespace RKCert.Paired.FiniteMidpoint
open RKCert.Paired RKCert.OrderTwelve Polynomial
variable {K:Type*} [Field K] [CharZero K]
set_option maxHeartbeats 8000000
set_option maxRecDepth 16000

omit [CharZero K] in
def dSixValue (x:K) : K := 429*x^6 - 1287*x^5 + 1485*x^4 - 825*x^3 + 225*x^2 - 27*x + 1

/-- No normalized quartic factor of the fixed mesh has the specified zero moment. -/
theorem fixed14_quartic_gate (u v w q0 q1 q2 q3 q4:K)
    (fit : ∀ x:K,dSixValue x=(x^2-u*x+v)*evalFour q0 q1 q2 q3 q4 x)
    (hw:w=1 ∨ dSixValue w=0 ∧ evalFour q0 q1 q2 q3 q4 w≠0) :
    pureMoment q0 q1 q2 q3 q4 w≠0 := by
  have e0 := fit 0
  have e1 := fit 1
  have e2 := fit 2
  have e3 := fit 3
  have e4 := fit 4
  have e5 := fit 5
  have e6 := fit 6
  simp only [dSixValue,evalFour] at e0 e1 e2 e3 e4 e5 e6
  have h0 : q0=429*u^4 - 1287*u^3 - 1287*u^2*v + 1485*u^2 + 2574*u*v - 825*u + 429*v^2 - 1485*v + 225 := by
    linear_combination (-(1/720)*u^4 + (7/240)*u^3 + (1/240)*u^2*v - (35/144)*u^2 - (7/120)*u*v + (49/48)*u - (1/720)*v^2 + (35/144)*v - (203/90))*e0 + ((1/120)*u^4 - (1/6)*u^3 - (1/40)*u^2*v + (31/24)*u^2 + (1/3)*u*v - (29/6)*u + (1/120)*v^2 - (31/24)*v + (87/10))*e1 + (-(1/48)*u^4 + (19/48)*u^3 + (1/16)*u^2*v - (137/48)*u^2 - (19/24)*u*v + (461/48)*u - (1/48)*v^2 + (137/48)*v - (117/8))*e2 + ((1/36)*u^4 - (1/2)*u^3 - (1/12)*u^2*v + (121/36)*u^2 + u*v - (31/3)*u + (1/36)*v^2 - (121/36)*v + (127/9))*e3 + (-(1/48)*u^4 + (17/48)*u^3 + (1/16)*u^2*v - (107/48)*u^2 - (17/24)*u*v + (307/48)*u - (1/48)*v^2 + (107/48)*v - (33/4))*e4 + ((1/120)*u^4 - (2/15)*u^3 - (1/40)*u^2*v + (19/24)*u^2 + (4/15)*u*v - (13/6)*u + (1/120)*v^2 - (19/24)*v + (27/10))*e5 + (-(1/720)*u^4 + (1/48)*u^3 + (1/240)*u^2*v - (17/144)*u^2 - (1/24)*u*v + (5/16)*u - (1/720)*v^2 + (17/144)*v - (137/360))*e6
  have h1 : q1=429*u^3 - 1287*u^2 - 858*u*v + 1485*u + 1287*v - 825 := by
    linear_combination (-(1/720)*u^3 + (7/240)*u^2 + (1/360)*u*v - (35/144)*u - (7/240)*v + (49/48))*e0 + ((1/120)*u^3 - (1/6)*u^2 - (1/60)*u*v + (31/24)*u + (1/6)*v - (29/6))*e1 + (-(1/48)*u^3 + (19/48)*u^2 + (1/24)*u*v - (137/48)*u - (19/48)*v + (461/48))*e2 + ((1/36)*u^3 - (1/2)*u^2 - (1/18)*u*v + (121/36)*u + (1/2)*v - (31/3))*e3 + (-(1/48)*u^3 + (17/48)*u^2 + (1/24)*u*v - (107/48)*u - (17/48)*v + (307/48))*e4 + ((1/120)*u^3 - (2/15)*u^2 - (1/60)*u*v + (19/24)*u + (2/15)*v - (13/6))*e5 + (-(1/720)*u^3 + (1/48)*u^2 + (1/360)*u*v - (17/144)*u - (1/48)*v + (5/16))*e6
  have h2 : q2=429*u^2 - 1287*u - 429*v + 1485 := by
    linear_combination (-(1/720)*u^2 + (7/240)*u + (1/720)*v - (35/144))*e0 + ((1/120)*u^2 - (1/6)*u - (1/120)*v + (31/24))*e1 + (-(1/48)*u^2 + (19/48)*u + (1/48)*v - (137/48))*e2 + ((1/36)*u^2 - (1/2)*u - (1/36)*v + (121/36))*e3 + (-(1/48)*u^2 + (17/48)*u + (1/48)*v - (107/48))*e4 + ((1/120)*u^2 - (2/15)*u - (1/120)*v + (19/24))*e5 + (-(1/720)*u^2 + (1/48)*u + (1/720)*v - (17/144))*e6
  have h3 : q3=429*u - 1287 := by
    linear_combination (-(1/720)*u + (7/240))*e0 + ((1/120)*u - (1/6))*e1 + (-(1/48)*u + (19/48))*e2 + ((1/36)*u - (1/2))*e3 + (-(1/48)*u + (17/48))*e4 + ((1/120)*u - (2/15))*e5 + (-(1/720)*u + (1/48))*e6
  have h4 : q4=429 := by
    linear_combination (-(1/720))*e0 + ((1/120))*e1 + (-(1/48))*e2 + ((1/36))*e3 + (-(1/48))*e4 + ((1/120))*e5 + (-(1/720))*e6

  intro h
  have z0 : -429*u^4*v + 1287*u^3*v + 1287*u^2*v^2 - 1485*u^2*v - 2574*u*v^2 + 825*u*v - 429*v^3 + 1485*v^2 - 225*v + 1=0 := by
    rw [h0,h1,h2,h3,h4] at e0
    linear_combination e0
  have z1 : 429*u^5 - 1287*u^4 - 1716*u^3*v + 1485*u^3 + 3861*u^2*v - 825*u^2 + 1287*u*v^2 - 2970*u*v + 225*u - 1287*v^2 + 825*v - 27=0 := by
    rw [h0,h1,h2,h3,h4] at e0 e1
    linear_combination e1-e0
