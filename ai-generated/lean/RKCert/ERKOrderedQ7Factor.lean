    linear_combination ((40153154656139754372000/3147617741790094289)*u^5*v - (5504900212202250109500/1296077893678274119)*u^5 + (396625838193206816851800/3147617741790094289)*u^4*v^2 - (1734955253011594897320600/22033324192530660023)*u^4*v + (30633110609583208122600/1296077893678274119)*u^4 - (448748429896701625462200/3147617741790094289)*u^3*v^3 - (7021027129589040676816800/22033324192530660023)*u^3*v^2 + (3333980002346276801898720/22033324192530660023)*u^3*v - (735744163126269616954120/16849012617817563547)*u^3 - (45337626558577591266600/3147617741790094289)*u^2*v^3 + (8569446506046989688591000/22033324192530660023)*u^2*v^2 - (43994699349903294614945100/286433214502898580299)*u^2*v + (608507488261741260924300/16849012617817563547)*u^2 + (897496859793403250924400/3147617741790094289)*u*v^4 + (5444555637207194632109400/22033324192530660023)*u*v^3 - (75620557349438255188677480/286433214502898580299)*u*v^2 + (26985453756023713753211092/286433214502898580299)*u*v - (2588747261557816486183332/185339138795993199017)*u - (747914049827836042437000/3147617741790094289)*v^4 - (2504932652818862411024520/22033324192530660023)*v^3 + (21132080520569705188442490/286433214502898580299)*v^2 - (83891716961129917600114254/3150765359531884383289)*v + (398622479321179439075019/185339138795993199017))*hz0 + ((26768769770759836248000/3147617741790094289)*u^5*v - (3669933474801500073000/1296077893678274119)*u^5 + (264417225462137877901200/3147617741790094289)*u^4*v^2 - (1141021719641453360402400/22033324192530660023)*u^4*v + (2873749421450763867950/185153984811182017)*u^4 - (299165619931134416974800/3147617741790094289)*u^3*v^3 - (4526441371539780022435500/22033324192530660023)*u^3*v^2 + (2134594993658887878247380/22033324192530660023)*u^3*v - (470492601540477183256380/16849012617817563547)*u^3 - (55155552699979595592300/3147617741790094289)*u^2*v^3 + (774397932445680841135920/3147617741790094289)*u^2*v^2 - (27587871104299618549038150/286433214502898580299)*u^2*v + (375226974614925130460