module
public import RKCert.EndpointJacobi
@[expose] public section

/-! # The two fixed order-16/17 characteristic-zero knot gates
These are the literal rational knot polynomials in the no-alias full-tableau
cases: the Lobatto polynomial divided by x, or the Jacobi polynomial for x dx.
A Bézout certificate excludes the nonreal quartic exceptional ratio directly
in an arbitrary characteristic-zero field, with no embedding or ordering.
-/
namespace RKCert.Endpoint
variable {K : Type*} [Field K] [CharZero K]
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000

