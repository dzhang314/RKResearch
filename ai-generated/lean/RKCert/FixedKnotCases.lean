/-- A degree-≤4 head satisfying the 3+2 tests cannot survive when both
contrast endpoints are roots of this same fixed mesh polynomial. -/
theorem lobatto9_quartic_gate (c : Fin 5 → K) (a u : K) (ha : a ≠ 0) (ha1 : a ≠ 1)
    (h : twoTests c a 3) (hu : lobatto9 u = 0) (hau : lobatto9 (a*u) = 0) : c = 0 := by
  rcases quartic_three_two c a ha ha1 h with z | q
  · exact z
  · exact False.elim (lobatto9_noRatio a u q hu hau)

