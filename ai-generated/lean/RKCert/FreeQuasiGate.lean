/-- If the actual sextic made of the matching quartic head and both endpoint
factors divides the rescaled arbitrary-parameter Jacobi pencil, its normalized
3+2 moments force its head to vanish. The free parameter is unrestricted. -/
theorem freeQuasi17_quartic_gate (c : Fin 5 → K) (a u th : K)
    (ha : a ≠ 0) (ha1 : a ≠ 1) (hu : u ≠ 0) (h : twoTests c a 3)
    (hfit : ∃ q0 q1 q2 : K, ∀ x : K, jacDerivative8 (u*x) + th*jacDerivative7 (u*x) =
      (x-1)*(x-a)*value c x*(q0+q1*x+q2*x^2)) : c = 0 := by
  rcases quartic_three_two c a ha ha1 h with z | q
  · exact z
  obtain ⟨q0,q1,q2,fit⟩ := hfit
  have sc := shape_forced c a ha ha1 h q
  have val (x:K) : value c x = c 4 * monicShape a x := by
    rw [←norm_shape, value,value,Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    rw [sc j]; ring
  have fit' (x:K) : jacDerivative8 (u*x) + th*jacDerivative7 (u*x) =
      sixFactor a x*(c 4*q0+(c 4*q1)*x+(c 4*q2)*x^2) := by
    rw [fit x, val]; dsimp [sixFactor]; ring
  have z0 := row0 a u th _ _ _ q fit'
  have z1 := row1 a u th _ _ _ q fit'
  have z2 := row2 a u th _ _ _ q fit'
  exact False.elim (finalConflict u (norm1 a u q (minor1 a u th hu q z0 z1))
    (norm2 a u q (minor2 a u th hu q z0 z2)))

