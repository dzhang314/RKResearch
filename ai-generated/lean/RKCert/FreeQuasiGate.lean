module
public import RKCert.FixedKnotCases

@[expose] public section
/-! # The free-parameter characteristic-zero p17 quasi-rule gate
The pencil and the quartic are represented by their actual polynomial values.
The hypothesis asserts an identity in X with an arbitrary quadratic quotient;
the proof uses just its nine values at 0, …, 8. The terminal Bézout identity
is checked by the Lean kernel over the integers and transferred to K.
-/
namespace RKCert.Endpoint
variable {K : Type*} [Field K] [CharZero K]
set_option maxRecDepth 32768
set_option maxHeartbeats 9000000
set_option exponentiation.threshold 256

def value {n : ℕ} (c : Fin n → K) (x : K) : K := ∑ j, c j*x^j.val

private def shape (a : K) (i : Fin 5) : K :=
  match i.val with
  | 0 => (12*a-5)/70
  | 1 => (5-18*a)/14
  | 2 => 18*a/7
  | 3 => -(5+6*a)/4
  | _ => 1

private lemma shape_tests (a : K) (hq : 15*a^2 - 24*a +10=0) : twoTests (shape a) a 3 := by
  constructor
  · intro k; fin_cases k <;> norm_num [moment,shape,Fin.sum_univ_succ] <;> ring
  constructor
  · norm_num [moment,shape,Fin.sum_univ_succ]
    linear_combination -a^2*(a-1)^2*(2*a-1)/280*hq
  · norm_num [moment,shape,Fin.sum_univ_succ]
    linear_combination -a^3*(a-1)^2*(5*a-2)/840*hq

private lemma shape_forced (c : Fin 5 → K) (a : K) (ha : a ≠ 0) (ha1 : a ≠ 1)
    (h : twoTests c a 3) (hq : 15*a^2-24*a+10=0) :
    ∀ i, c i = c 4*shape a i := by
  let v : Fin 4 → K := fun j => c j.castSucc - c 4*shape a j.castSucc
  have e (t : K) (k : ℕ) : moment v t k = moment c t k - c 4*moment (shape a) t k := by
    simp [v,moment,Fin.sum_univ_succ,shape]
    ring
  have s := shape_tests a hq
  have vh : twoTests v a 3 := by
    refine ⟨?_,?_,?_⟩
    · intro k; rw [e,h.1 k,s.1 k]; ring
    · rw [e,e]; linear_combination h.2.1 - c 4*s.2.1
    · rw [e,e]; linear_combination h.2.2 - c 4*s.2.2
  have vv := match3 v a ha ha1 vh
  have z (i : Fin 4) : c i.castSucc = c 4*shape a i.castSucc := sub_eq_zero.mp (congrFun vv i)
  intro i; fin_cases i
  · exact z 0
  · exact z 1
  · exact z 2
  · exact z 3
  · simp [shape]


