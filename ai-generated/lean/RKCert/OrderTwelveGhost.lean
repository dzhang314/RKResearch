/-! # No nonzero cubic and leakage scalar solve the five p12 endpoint tests
The cofactors below are checked directly against the original five linear
equations. No characteristic assumption is hidden in a modular lift. -/
namespace RKCert.OrderTwelve
variable {K : Type*} [Field K] [CharZero K]
set_option maxHeartbeats 12000000
set_option maxRecDepth 32768

/-- Formal integral from zero to x of X^k times the actual cubic. -/
def cubicMoment (x : K) (k : ℕ) (v : Fin 4 → K) : K :=
  ∑ j, v j*x^(j.val+k+1)/((j.val+k+1:ℕ):K)

/-- Characteristic-zero Appendix B ghost determinant gate, for all ordered distinct physical endpoints. -/
theorem ghost_five_tests_zero (u a : K) (hu : endpoint u=0) (ha : endpoint a=0) (hne : a≠u)
    (v : Fin 4 → K) (h : K)
    (e0 : cubicMoment u 1 v=0) (e1 : cubicMoment u 2 v=0)
    (e2 : cubicMoment u 3 v+h*leakSeven u=0)
    (e3 : cubicMoment a 2 v-u*cubicMoment a 1 v=0)
    (e4 : cubicMoment a 3 v-u*cubicMoment a 2 v+h*leakSeven a=0) : v=0 ∧ h=0 := by
  have ua : u≠0 := by rintro rfl; norm_num [endpoint,dFive] at hu
  have aa : a≠0 := by rintro rfl; norm_num [endpoint,dFive] at ha
  have nz : a^3*u^7*(u-a)^3*ghostKernel u a ≠ 0 :=
    mul_ne_zero (mul_ne_zero (mul_ne_zero (pow_ne_zero 3 aa) (pow_ne_zero 7 ua))
      (pow_ne_zero 3 (sub_ne_zero.mpr hne.symm))) (ghost_gate u a hu ha hne)
  norm_num [cubicMoment, Fin.sum_univ_succ,leakSeven] at e0 e1 e2 e3 e4
  have z0 : v 0=0 := by
    apply (mul_eq_zero.mp (show (a^3*u^7*(u-a)^3*ghostKernel u a)*(v 0)=0 from ?_)).resolve_left nz
