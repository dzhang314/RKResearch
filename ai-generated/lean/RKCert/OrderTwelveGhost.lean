    linear_combination ((-60)*((a))^3*((u))^4*(u - a)*(194040*u^9*a^4 - 309078*u^8*a^5 - 453600*u^8*a^4 - 75600*u^8*a^3 + 33600*u^8*a^2 - 6300*u^8*a + 360*u^8 + 73458*u^7*a^6 + 792540*u^7*a^5 + 504000*u^7*a^4 + 11200*u^7*a^3 - 2100*u^7*a^2 + 120*u^7*a + 133056*u^6*a^7 - 483840*u^6*a^6 - 509040*u^6*a^5 - 350000*u^6*a^4 + 21525*u^6*a^3 - 1230*u^6*a^2 - 83160*u^5*a^8 + 75600*u^5*a^7 + 45360*u^5*a^6 + 421120*u^5*a^5 + 29085*u^5*a^4 + 858*u^5*a^3 + 50400*u^4*a^8 + 100800*u^4*a^7 - 98560*u^4*a^6 - 64260*u^4*a^5 - 2502*u^4*a^4 - 50400*u^3*a^8 - 44800*u^3*a^7 + 18480*u^3*a^6 + 3672*u^3*a^5 + 22400*u^2*a^8 + 8400*u^2*a^7 - 1056*u^2*a^6 - 4200*u*a^8 - 480*u*a^7 + 240*a^8))*e0 + ((180)*((a))^3*((u))^3*(u - a)*(77616*u^9*a^4 - 144144*u^8*a^5 - 136080*u^8*a^4 - 75600*u^8*a^3 + 33600*u^8*a^2 - 6300*u^8*a + 360*u^8 + 24948*u^7*a^6 + 342720*u^7*a^5 + 186480*u^7*a^4 + 11200*u^7*a^3 - 2100*u^7*a^2 + 120*u^7*a + 134442*u^6*a^7 - 408240*u^6*a^6 - 2520*u^6*a^5 - 234080*u^6*a^4 + 26250*u^6*a^3 - 1500*u^6*a^2 - 90090*u^5*a^8 + 170100*u^5*a^7 - 128520*u^5*a^6 + 239680*u^5*a^5 - 840*u^5*a^4 + 1056*u^5*a^3 + 25200*u^4*a^8 + 50400*u^4*a^7 - 40880*u^4*a^6 - 26565*u^4*a^5 - 1002*u^4*a^4 - 25200*u^3*a^8 - 22400*u^3*a^7 + 7665*u^3*a^6 + 1518*u^3*a^5 + 11200*u^2*a^8 + 4200*u^2*a^7 - 438*u^2*a^6 - 2100*u*a^8 - 240*u*a^7 + 120*a^8))*e1 + ((2520)*((a))^3*((u))^7*((u - a))^2*(3*u^2 + 4*u*a - 10*a^2)*(462*a^5 - 1260*a^4 + 1260*a^3 - 560*a^2 + 105*a - 6))*e2 + ((180)*(a)*((u))^8*(u - a)*(12936*u^8*a^2 + 3234*u^7*a^3 - 35280*u^7*a^2 - 74382*u^6*a^4 - 8820*u^6*a^3 + 35280*u^6*a^2 + 55440*u^5*a^5 + 201600*u^5*a^4 + 10080*u^5*a^3 - 16240*u^5*a^2 + 105*u^5*a - 6*u^5 - 151200*u^4*a^5 - 201600*u^4*a^4 - 4480*u^4*a^3 + 3045*u^4*a^2 - 6*u^4*a + 151200*u^3*a^5 + 89600*u^3*a^4 + 840*u^3*a^3 - 174*u^3*a^2 - 67200*u^2*a^5 - 16800*u^2*a^4 - 48*u^2*a^3 + 12600*u*a^5 + 960*u*a^4 - 720*a^5))*e3 + ((-2520)*((a))^2*((u))^8*((u - a))^2*(3*u^2 + 4*u*a - 10*a^2)*(462*u^5 - 1260*u^4 + 1260*u^3 - 560*u^2 + 105*u - 6))*e4
  have z2 : v 2=0 := by
    apply (mul_eq_zero.mp (show (a^3*u^7*(u-a)^3*ghostKernel u a)*(v 2)=0 from ?_)).resolve_left nz
    unfold ghostKernel
    linear_combination ((60)*((a))^3*((u))^4*(u - a)*(161700*u^9*a^3 - 32340*u^8*a^4 - 441000*u^8*a^3 - 358050*u^7*a^5 + 315000*u^7*a^4 + 214200*u^7*a^3 + 100800*u^7*a^2 - 18900*u^7*a + 1080*u^7 + 339570*u^6*a^6 + 447300*u^6*a^5 + 214200*u^6*a^4 - 330400*u^6*a^3 + 25200*u^6*a^2 - 1440*u^6*a - 45738*u^5*a^7 - 642600*u^5*a^6 - 730800*u^5*a^5 + 30800*u^5*a^4 + 38325*u^5*a^3 - 90*u^5*a^2 - 48510*u^4*a^8 + 283500*u^4*a^7 + 483840*u^4*a^6 + 395360*u^4*a^5 - 19005*u^4*a^4 - 1434*u^4*a^3 - 151200*u^3*a^7 - 273840*u^3*a^6 - 63105*u^3*a^5 + 456*u^3*a^4 + 67200*u^2*a^7 + 51345*u^2*a^6 + 3606*u^2*a^5 - 12600*u*a^7 - 2934*u*a^6 + 720*a^7))*e0 + ((-360)*((a))^3*((u))^3*(u - a)*(32340*u^9*a^3 - 6468*u^8*a^4 - 88200*u^8*a^3 - 105798*u^7*a^5 + 138600*u^7*a^4 - 32760*u^7*a^3 + 53760*u^7*a^2 - 10080*u^7*a + 576*u^7 + 122430*u^6*a^6 - 18900*u^6*a^5 + 168840*u^6*a^4 - 122080*u^6*a^3 + 15540*u^6*a^2 - 888*u^6*a - 7392*u^5*a^7 - 163800*u^5*a^6 - 151200*u^5*a^5 + 560*u^5*a^4 + 8715*u^5*a^3 - 78*u^5*a^2 - 32340*u^4*a^8 + 126000*u^4*a^7 + 57960*u^4*a^6 + 114240*u^4*a^5 - 8925*u^4*a^4 + 6*u^4*a^3 - 37800*u^3*a^7 - 64960*u^3*a^6 - 14070*u^3*a^5 + 90*u^3*a^4 + 16800*u^2*a^7 + 12180*u^2*a^6 + 804*u^2*a^5 - 3150*u*a^7 - 696*u*a^6 + 180*a^7))*e1 + ((-4200)*((a))^3*((u))^6*((u - a))^2*(6*u^2 - 4*u*a - 5*a^2)*(462*a^5 - 1260*a^4 + 1260*a^3 - 560*a^2 + 105*a - 6))*e2 + ((-120)*(a)*((u))^7*(u - a)*(64680*u^8*a^2 - 129360*u^7*a^3 - 176400*u^7*a^2 - 12936*u^6*a^4 + 352800*u^6*a^3 + 176400*u^6*a^2 + 69300*u^5*a^5 + 31500*u^5*a^4 - 349020*u^5*a^3 - 80080*u^5*a^2 + 315*u^5*a - 18*u^5 - 189000*u^4*a^5 - 31500*u^4*a^4 + 155120*u^4*a^3 + 15015*u^4*a^2 - 18*u^4*a + 189000*u^3*a^5 + 14000*u^3*a^4 - 29085*u^3*a^3 - 858*u^3*a^2 - 84000*u^2*a^5 - 2625*u^2*a^4 + 1662*u^2*a^3 + 15750*u*a^5 + 150*u*a^4 - 900*a^5))*e3 + ((4200)*((a))^2*((u))^7*((u - a))^2*(6*u^2 - 4*u*a - 5*a^2)*(462*u^5 - 1260*u^4 + 1260*u^3 - 560*u^2 + 105*u - 6))*e4
