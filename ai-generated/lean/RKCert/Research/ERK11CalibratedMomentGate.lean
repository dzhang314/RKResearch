import Lean
/-!
# The repaired dense family with coupled exact receivers is obstructed

This file checks scalar identities in the six-grade positive moment
test. The geometric bridge is supplied separately. The Bézout
coefficients are explicit; no Gröbner solver or floating calculation
enters the trusted proof.
-/
namespace RKResearch.ERK11CalibratedMomentGate
open Lean.Grind
attribute [local instance] Ring.intCast
variable {K : Type} [Field K]

structure Four (K : Type) where
  m1 : K
  m2 : K
  m3 : K
  m4 : K

def det3 (a b c d e f g h i : K) : K :=
  a*(e*i-f*h)-b*(d*i-f*g)+c*(d*h-e*g)

def det123 (a b c : Four K) : K := det3 a.m1 b.m1 c.m1 a.m2 b.m2 c.m2 a.m3 b.m3 c.m3
def det124 (a b c : Four K) : K := det3 a.m1 b.m1 c.m1 a.m2 b.m2 c.m2 a.m4 b.m4 c.m4
def det1234 (a b c d : Four K) : K :=
    a.m1*det3 b.m2 c.m2 d.m2 b.m3 c.m3 d.m3 b.m4 c.m4 d.m4
   -b.m1*det3 a.m2 c.m2 d.m2 a.m3 c.m3 d.m3 a.m4 c.m4 d.m4
   +c.m1*det3 a.m2 b.m2 d.m2 a.m3 b.m3 d.m3 a.m4 b.m4 d.m4
   -d.m1*det3 a.m2 b.m2 c.m2 a.m3 b.m3 c.m3 a.m4 b.m4 c.m4

def k4 (x : K) : K := (x-1)*(3*x-1)*(4*x-1)
def f4 (x : K) : K := 24*x^4-530*x^3+865*x^2-410*x+75

def cN (u v : K) : K := (u-v)*k4 u*k4 v
def cX (u v : K) : K := -k4 v*f4 u+k4 u*f4 v
def c0 (u v : K) : K := v*k4 v*f4 u-u*k4 u*f4 v

/- Row scales for the four unnormalized weighted integrals are
420, 2520, 10080, 138600, each a product of paid primes. -/

def clock9 (u v : K) : Four K :=
  ⟨(-880)*cN u v+(4)*cX u v+(8)*c0 u v,
    (-3150)*cN u v+(9)*cX u v+(24)*c0 u v,
    (-8692)*cN u v+(16)*cX u v+(60)*c0 u v,
    (-90025)*cN u v+(115)*cX u v+(605)*c0 u v⟩

def clock10 (u v : K) : Four K :=
  ⟨(-9)-(-13)*(u+v)+(-21)*u*v,
    (-15)-(-24)*(u+v)+(-48)*u*v,
    (-20)-(-36)*(u+v)+(-96)*u*v,
    (-105)-(-220)*(u+v)+(-825)*u*v⟩

def unary11 (u : K) : Four K :=
  ⟨(-2)-(-4)*u,
    (-3)-(-8)*u,
    (-4)-(-15)*u,
    (-23)-(-121)*u⟩

def model11 (u : K) : Four K :=
  ⟨(-13)-(-21)*u,
    (-24)-(-48)*u,
    (-36)-(-96)*u,
    (-220)-(-825)*u⟩

def unary10 (v : K) : Four K :=
  ⟨(-2)-(-4)*v,
    (-3)-(-8)*v,
    (-4)-(-15)*v,
    (-23)-(-121)*v⟩

def p0c0 (u : K) : K := -7620 * u^4 + 13686 * u^3 - 8816 * u^2 + 2299 * u - 204
def p0c1 (u : K) : K := 79872 * u^4 - 153240 * u^3 + 104705 * u^2 - 28292 * u + 2400
def p0c2 (u : K) : K := -212652 * u^4 + 434802 * u^3 - 312912 * u^2 + 88218 * u - 7512
def p0c3 (u : K) : K := 159120 * u^4 - 360252 * u^3 + 277008 * u^2 - 81636 * u + 7056
def p0 (u v : K) : K := p0c0 u+p0c1 u*v+p0c2 u*v^2+p0c3 u*v^3
def p1c0 (u : K) : K := -129756 * u^4 + 232078 * u^3 - 149185 * u^2 + 38955 * u - 3495
def p1c1 (u : K) : K := 1295184 * u^4 - 2537728 * u^3 + 1767098 * u^2 - 482950 * u + 40890
def p1c2 (u : K) : K := -3251556 * u^4 + 7004202 * u^3 - 5236123 * u^2 + 1509193 * u - 128205
def p1c3 (u : K) : K := 2139984 * u^4 - 5524848 * u^3 + 4568412 * u^2 - 1397748 * u + 121068
def p1 (u v : K) : K := p1c0 u+p1c1 u*v+p1c2 u*v^2+p1c3 u*v^3
def qA (u : K) : K := 210276 * u^4 - 168402 * u^3 + 16533 * u^2 + 10093 * u - 697
def qB (u : K) : K := -194688 * u^4 + 196476 * u^3 - 51804 * u^2 + 216 * u + 516
def q (u v : K) : K := qA u*v+qB u
def after0 (u : K) : K := 96042776275817088768 * u^16 - 786527551618646485248 * u^15 + 2500905099925904938560 * u^14 - 4406065844688278643744 * u^13 + 4936087966554019318032 * u^12 - 3756418020478264623192 * u^11 + 2003015474622936614520 * u^10 - 753736040393998743378 * u^9 + 196763222008414236780 * u^8 - 33646079315172289941 * u^7 + 3156128944085128497 * u^6 - 24196378178733584 * u^5 - 26314949229091295 * u^4 + 1899349920019698 * u^3 + 36027892377737 * u^2 - 4908239235799 * u - 107879855700
def after1 (u : K) : K := -180863892009342938880 * u^16 - 5592660529803487501824 * u^15 + 27734850978845921372160 * u^14 - 58588603857608196268224 * u^13 + 72422841341355711402096 * u^12 - 58551039895258328741424 * u^11 + 32485696050874251210552 * u^10 - 12557629722080325246228 * u^9 + 3338482357052812668255 * u^8 - 577661189873909483880 * u^7 + 54528199547683546210 * u^6 - 406804480618081084 * u^5 - 457034498785858071 * u^4 + 32582722446934280 * u^3 + 657066674128570 * u^2 - 84508663790412 * u - 1907725395993
def baseFactor (u v : K) : K := -24*(u-1)*(u-v)*(v-1)

set_option maxHeartbeats 0 in
theorem factor0 (u v : K) :
    det123 (clock9 u v) (clock10 u v) (unary11 u) = baseFactor u v*p0 u v := by
  simp only [det123,det3,clock9,clock10,unary11,cN,cX,c0,k4,f4,baseFactor,
    p0,p0c0,p0c1,p0c2,p0c3]
  grind (ringSteps := 1000000)

set_option maxHeartbeats 0 in
theorem factor1 (u v : K) :
    det124 (clock9 u v) (clock10 u v) (unary11 u) = baseFactor u v*p1 u v := by
  simp only [det124,det3,clock9,clock10,unary11,cN,cX,c0,k4,f4,baseFactor,
    p1,p1c0,p1c1,p1c2,p1c3]
  grind (ringSteps := 1000000)

set_option maxHeartbeats 0 in
theorem factor2 (u v : K) :
    det1234 (clock9 u v) (clock10 u v) (model11 u) (unary10 v) =
      (baseFactor u v*(3*v-1)*(4*v-1))*q u v := by
  simp only [det1234,det3,clock9,clock10,model11,unary10,cN,cX,c0,k4,f4,baseFactor,q,qA,qB]
  grind (ringSteps := 1000000)


set_option maxHeartbeats 0 in
theorem clear0 (u v : K) (z : q u v=0) :
    (qA u)^3*p0 u v=after0 u := by
  have ve : qA u*v= -qB u := by unfold q at z; grind
  calc
    (qA u)^3*p0 u v =
      p0c0 u*(qA u)^3+p0c1 u*(qA u)^2*(qA u*v)+
      p0c2 u*qA u*(qA u*v)^2+p0c3 u*(qA u*v)^3 := by
        unfold p0
        grind
    _ = after0 u := by
        rw [ve]
        simp only [after0,qA,qB,p0c0,p0c1,p0c2,p0c3]
        grind (ringSteps := 1000000)


set_option maxHeartbeats 0 in
theorem clear1 (u v : K) (z : q u v=0) :
    (qA u)^3*p1 u v=after1 u := by
  have ve : qA u*v= -qB u := by unfold q at z; grind
  calc
    (qA u)^3*p1 u v =
      p1c0 u*(qA u)^3+p1c1 u*(qA u)^2*(qA u*v)+
      p1c2 u*qA u*(qA u*v)^2+p1c3 u*(qA u*v)^3 := by
        unfold p1
        grind
    _ = after1 u := by
        rw [ve]
        simp only [after1,qA,qB,p1c0,p1c1,p1c2,p1c3]
        grind (ringSteps := 1000000)

