def denomGuard : Int := 85611201819597299682708103611150741599630272799033629737884672685401975204616248059235478680673034395307555798569364286452928659607946131479120237194453131057165739712290566331019008000000

set_option maxHeartbeats 0 in
theorem bezout (u : K) :
    bez0 u*after0 u+bez1 u*after1 u=(denomGuard:K) := by
  simp only [bez0,bez1,after0,after1,denomGuard]
  grind (ringSteps := 1000000)

theorem noCalibratedFamily (u v : K)
    (factorN : baseFactor u v≠0) (factor4N : baseFactor u v*(3*v-1)*(4*v-1)≠0)
    (paid : (denomGuard:K)≠0)
    (h0 : det123 (clock9 u v) (clock10 u v) (unary11 u)=0)
    (h1 : det124 (clock9 u v) (clock10 u v) (unary11 u)=0)
    (h2 : det1234 (clock9 u v) (clock10 u v) (model11 u) (unary10 v)=0) : False := by
  rw [factor0] at h0
  rw [factor1] at h1
  rw [factor2] at h2
  have p0z := (Field.of_mul_eq_zero h0).resolve_left factorN
  have p1z := (Field.of_mul_eq_zero h1).resolve_left factorN
  have qz := (Field.of_mul_eq_zero h2).resolve_left factor4N
  have r0z := clear0 u v qz
  have r1z := clear1 u v qz
  rw [p0z,Semiring.mul_zero] at r0z
  rw [p1z,Semiring.mul_zero] at r1z
  have e := bezout u
  rw [←r0z,←r1z,Semiring.mul_zero,Semiring.mul_zero,AddCommMonoid.zero_add] at e
  exact paid e.symm

def factorial : Nat → Nat
  | 0 => 1
  | n+1 => (n+1)*factorial n

def monomialWeight : Nat → Nat → Rat := fun m k =>
    ((factorial k*factorial m : Nat) : Rat)/(factorial (k+m+1):Rat)

def basisWeights : Array (Array Rat) := #[#[0,-75,485,-1275,1395,-554,24],#[0,1,-9,27,-31,12,0],#[0,0,1,-9,27,-31,12],#[0,-1,8,-19,12,0,0],#[0,0,-1,8,-19,12,0],#[0,0,0,-1,8,-19,12],#[0,0,-1/2,8/3,-19/4,12/5,0],#[0,0,0,-1/3,2,-19/5,2]]
def scaledMoments : Array (Array Rat) := #[#[-880,8,4,-21,-13,-9,-4,-2],#[-3150,24,9,-48,-24,-15,-8,-3],#[-8692,60,16,-96,-36,-20,-15,-4],#[-90025,605,115,-825,-220,-105,-121,-23]]
def scales : Array Rat := #[420,2520,10080,138600]

def weightEntry (m : Fin 4) (j : Fin 8) : Rat :=
    scales[m.val]!*((List.range 7).map (fun k =>
          (basisWeights[j.val]![k]!)*monomialWeight (m.val+1) k)).foldr (·+·) 0

theorem momentRows : ∀ (m : Fin 4) (j : Fin 8), weightEntry m j=scaledMoments[m.val]![j.val]! := by
  decide +kernel

end RKResearch.ERK11CalibratedMomentGate
