def rootden : Int := 132984843803701111084755487750028773712626992326900845222721631503421536172242485130186197807889987591426757400780800

private def residual : Poly :=
  productPoly roota0 rootp0 ++ productPoly roota1 rootp1 ++
  productPoly roota2 rootp2 ++ productPoly roota3 rootp3 ++ [⟨-rootden,0,0,0⟩]

set_option maxHeartbeats 0 in
set_option maxRecDepth 30000 in
private theorem checked : allZero (normalized residual) = true := by
  decide +kernel

private theorem eliminate (u w s : K) (paid : (rootden:K)≠0)
    (h0 : evaluate u w s rootp0=0) (h1 : evaluate u w s rootp1=0)
    (h2 : evaluate u w s rootp2=0) (h3 : evaluate u w s rootp3=0) : False := by
  have h := certificateSound u w s residual checked
  simp only [residual,evalAppend,evalProduct,h0,h1,h2,h3,Semiring.mul_zero,AddCommMonoid.zero_add,
    evaluate,evaluateMon,Ring.intCast_neg,Semiring.pow_zero,Semiring.mul_one,Semiring.add_zero] at h
  apply paid
  grind
/-! ## The weighted reflected row identities -/
private theorem nonzeroMul {x y : K} (hx : x≠0) (hy : y≠0) : x*y≠0 :=
  fun h => hy ((Field.of_mul_eq_zero h).resolve_left hx)

theorem twoVisibleWeights (s t b x L : K) (sN : s≠0)
    (mode : 3*t=2*s) (first : 4*x-b*s^2=L) (second : 5*t*x-b*s^3=t*L) :
    L=b*s^2 ∧ 6*t^2*x-b*s^4=(2*s*t-s^2)*L := by
  have e := congrArg (fun z => t*z) first
  have f := congrArg (fun z => (x+b*s^2)*z) mode
  have a : s*(2*x-b*s^2)=0 := by grind
  have a' := (Field.of_mul_eq_zero a).resolve_left sN
  have a0 : L=b*s^2 := by grind
  have r := congrArg (fun z => b*s^2*t*z) mode
  have f' : 2*x=b*s^2 := by grind
  have r' := congrArg (fun z => 3*t^2*z) f'
  exact ⟨a0,by grind⟩

theorem affineMode (s t p q : K) (diff : s-t≠0)
    (atT : p+q*t=t^2) (atS : p+q*s=2*s*t-s^2) :
    p=s*t ∧ q=-(s-t) := by
  have d : (s-t)*(q+s-t)=0 := by grind
  have ds := (Field.of_mul_eq_zero d).resolve_left diff
  exact ⟨by grind,by grind⟩

/-- Eliminate the only two later clean feeds at the second early clean
site. The three displayed equations are the gathered actual reflected
residuals on the strict first-ten prefix. -/
theorem eliminateSecondClean (s t r b x y L : K) (twenty : (20:K)≠0)
    (rS : r-s≠0) (resonance : 3*t=2*s)
    (e1 : 4*(x+y)-b*r^2=L)
    (e2 : 5*(s*x+t*y)-b*r^3=t*L)
    (e3 : 6*(s^2*x+t^2*y)-b*r^4=(s*t-(s-t)*r)*L) :
    3*b*r^2*(r-s)=s*L := by
  let f1 := 4*(x+y)-b*r^2-L
  let f2 := 5*(s*x+t*y)-b*r^3-t*L
  let f3 := 6*(s^2*x+t^2*y)-b*r^4-(s*t-(s-t)*r)*L
  have f1z : f1=0 := by dsimp [f1]; grind
  have f2z : f2=0 := by dsimp [f2]; grind
  have f3z : f3=0 := by dsimp [f3]; grind
  have calcIdentity :
      60*f3-72*(s+t)*f2+90*s*t*f1+20*(r-s)*(3*b*r^2*(r-s)-s*L) =
        (3*t-2*s)*(2*(12*b*r^3-15*b*r^2*s-10*L*r-5*L*s+12*L*t)) := by
    dsimp [f1,f2,f3]; grind
  have effect : (20*(r-s))*(3*b*r^2*(r-s)-s*L)=0 := by grind
  have v := (Field.of_mul_eq_zero effect).resolve_left (nonzeroMul twenty rS)
  grind

/-- Comparisons of the two genuine barycentric rows on the clean sites.
The quadrature row and defect-weighted detector row have different
normalizers; neither head values nor quadrature weights are divided. -/
theorem cleanHeadEquations
    (s t r Hθ Hξ Hw ℓθ ℓξ ℓw Lθ Lξ Lw
      bθ bξ bw pθ pξ pw T D : K)
    (sN : s≠0) (TN : T≠0) (resonance : 3*t=2*s)
    (qθ : bθ*s*pθ*Lθ=T) (qξ : bξ*t*pξ*Lξ=T) (qw : bw*r*pw*Lw=T)
    (dθ : ℓθ*Hθ*pθ=D) (dξ : ℓξ*Hξ*pξ=D) (dw : ℓw*Hw*pw=D)
    (hθ : ℓθ=bθ*s^2) (hξ : ℓξ=-(bξ*t^2))
    (hw : 3*bw*r^2*(r-s)=s*ℓw) :
    3*Hθ*Lξ+2*Hξ*Lθ=0 ∧ 3*r*(r-s)*Hw*Lθ=s^2*Hθ*Lw := by
  have a : D*Lθ=T*s*Hθ := by
    have x := congrArg (fun z => z*Lθ) dθ
    have y := congrArg (fun z => z*s*Hθ) qθ
    grind
  have b : D*Lξ=-(T*t*Hξ) := by
    have x := congrArg (fun z => z*Lξ) dξ
    have y := congrArg (fun z => z*t*Hξ) qξ
    grind
  have u : (T*s)*(3*Hθ*Lξ+2*Hξ*Lθ)=0 := by
    have aa := congrArg (fun v => 3*v*Lξ) a
    have bb := congrArg (fun v => 3*v*Lθ) b
    have rr := congrArg (fun v => T*Hξ*Lθ*v) resonance
    grind
  have m1 := (Field.of_mul_eq_zero u).resolve_left (nonzeroMul TN sN)
  have e : s*D*Lw=3*T*r*(r-s)*Hw := by
    have x := congrArg (fun z => s*Lw*z) dw
    have y := congrArg (fun z => 3*r*(r-s)*Hw*z) qw
    have w := congrArg (fun z => Hw*pw*Lw*z) hw
    grind
  have v : T*(3*r*(r-s)*Hw*Lθ-s^2*Hθ*Lw)=0 := by
    have x := congrArg (fun z => Lθ*z) e
    have y := congrArg (fun z => s*Lw*z) a
    grind
  have v' := (Field.of_mul_eq_zero v).resolve_left TN
  exact ⟨m1,by grind⟩

/-! ## The homogeneous head system and the three scalar moments -/

structure Row3 (K : Type) where
  x0 : K
  x1 : K
  x2 : K

def dot3 (a g : Row3 K) : K := a.x0*g.x0+a.x1*g.x1+a.x2*g.x2
def det3 (a b c : Row3 K) : K :=
  a.x0*(b.x1*c.x2-b.x2*c.x1)-a.x1*(b.x0*c.x2-b.x2*c.x0)+a.x2*(b.x0*c.x1-b.x1*c.x0)

theorem singular (a b c g : Row3 K)
    (gN : g.x0≠0 ∨ g.x1≠0 ∨ g.x2≠0)
    (h0 : dot3 a g=0) (h1 : dot3 b g=0) (h2 : dot3 c g=0) : det3 a b c=0 := by
  rcases gN with x | y | z
  · have e : (det3 a b c)*g.x0=0 := by
      have e0 := congrArg (fun v => (b.x1*c.x2-b.x2*c.x1)*v) h0
      have e1 := congrArg (fun v => (c.x1*a.x2-c.x2*a.x1)*v) h1
      have e2 := congrArg (fun v => (a.x1*b.x2-a.x2*b.x1)*v) h2
      unfold det3 dot3 at *
      grind
    exact (Field.of_mul_eq_zero e).resolve_right x
  · have e : (det3 a b c)*g.x1=0 := by
      have e0 := congrArg (fun v => (b.x2*c.x0-b.x0*c.x2)*v) h0
      have e1 := congrArg (fun v => (c.x2*a.x0-c.x0*a.x2)*v) h1
      have e2 := congrArg (fun v => (a.x2*b.x0-a.x0*b.x2)*v) h2
      unfold det3 dot3 at *
      grind
    exact (Field.of_mul_eq_zero e).resolve_right y
  · have e : (det3 a b c)*g.x2=0 := by
      have e0 := congrArg (fun v => (b.x0*c.x1-b.x1*c.x0)*v) h0
      have e1 := congrArg (fun v => (c.x0*a.x1-c.x1*a.x0)*v) h1
      have e2 := congrArg (fun v => (a.x0*b.x1-a.x1*b.x0)*v) h2
      unfold det3 dot3 at *
      grind
    exact (Field.of_mul_eq_zero e).resolve_right z

def cθ (s : K) : K := 1-s
def cξ3 (s : K) : K := 3-2*s
def cubic (x : K) : K := 30*x^3-36*x^2+12*x-1
def cubic27 (j : K) : K := 30*j^3-108*j^2+108*j-27

def earlyRow (u : K) : Row3 K := ⟨6,4*u,3*u^2⟩
def lateRow (s : K) : Row3 K :=
  let θ := cθ s
  let j := cξ3 s
  let L := cubic θ
  let L' := cubic27 j
  ⟨L'+18*L, L'*θ+6*L*j, L'*θ^2+2*L*j^2⟩
def secondRow (w s : K) : Row3 K :=
  let θ := cθ s
  let r := 1-w
  let p := 3*r*(r-s)*cubic θ
  let q := s^2*cubic w
  ⟨p-q,p*w-q*θ,p*w^2-q*θ^2⟩

def headAt (g : Row3 K) (x : K) : K := g.x0+g.x1*x+g.x2*x^2

theorem lateRowEvaluation (s ξ : K) (g : Row3 K) (atξ : 3*ξ=cξ3 s) :
    dot3 (lateRow s) g =
      9*(3*headAt g (cθ s)*cubic ξ+2*headAt g ξ*cubic (cθ s)) := by
  rw [lateRow,←atξ]
  dsimp [dot3,headAt,cubic,cubic27]
  grind

theorem secondRowEvaluation (w s : K) (g : Row3 K) :
    dot3 (secondRow w s) g =
      3*(1-w)*(1-w-s)*headAt g w*cubic (cθ s)-s^2*headAt g (cθ s)*cubic w := by
  dsimp [dot3,secondRow,headAt]
  grind

/-- Coefficients of the cubic-times-linear, denominator-cleared clean hull
(X-u)(X-w)(X-(1-s))(3X-(3-2s)). -/
def lc1 (s : K) : K := -(3*cθ s+cξ3 s)
def lc0 (s : K) : K := cθ s*cξ3 s
def c0 (u w s : K) : K := u*w*lc0 s
def c1 (u w s : K) : K := u*w*lc1 s-(u+w)*lc0 s
def c2 (u w s : K) : K := 3*u*w-(u+w)*lc1 s+lc0 s
def c3 (u w s : K) : K := lc1 s-3*(u+w)

def moment0 (u w s : K) : K :=
  126*c0 u w s+42*c1 u w s+18*c2 u w s+9*c3 u w s+15
def moment1 (u w s : K) : K :=
  42*c0 u w s+18*c1 u w s+9*c2 u w s+5*c3 u w s+9
def moment2 (u w s : K) : K :=
  198*c0 u w s+99*c1 u w s+55*c2 u w s+33*c3 u w s+63

theorem moment0Expansion (u w s : K) : moment0 u w s=3*evaluate u w s rootp0 := by
  simp only [moment0,c0,c1,c2,c3,lc0,lc1,cθ,cξ3,evaluate,evaluateMon,rootp0]
  grind
theorem moment1Expansion (u w s : K) : moment1 u w s=evaluate u w s rootp1 := by
  simp only [moment1,c0,c1,c2,c3,lc0,lc1,cθ,cξ3,evaluate,evaluateMon,rootp1]
  grind
theorem moment2Expansion (u w s : K) : moment2 u w s=evaluate u w s rootp2 := by
  simp only [moment2,c0,c1,c2,c3,lc0,lc1,cθ,cξ3,evaluate,evaluateMon,rootp2]
  grind

set_option maxHeartbeats 1200000 in
theorem determinantFactor (u w s : K) :
    det3 (earlyRow u) (lateRow s) (secondRow w s) =
     -(2*s+3*w-3)*cubic (cθ s)*evaluate u w s rootp3 := by
  simp only [det3,earlyRow,lateRow,secondRow,cθ,cξ3,cubic,cubic27,evaluate,evaluateMon,rootp3]
  grind

/-- A genuinely nonzero head cannot meet the two weighted reflected
relations, the first-clean chronology, and the three shifted moments.
The scalar factor cancellation uses only distinct late/early clean
clocks and the paid nonvanishing of the cubic at theta. -/
theorem fiveSixImpossible (u w s ξ : K) (g : Row3 K)
    (three : (3:K)≠0) (Dnonzero : (rootden:K)≠0)
    (gN : g.x0≠0 ∨ g.x1≠0 ∨ g.x2≠0) (distinct : w-ξ≠0)
    (cN : cubic (cθ s)≠0) (atξ : 3*ξ=cξ3 s)
    (early : dot3 (earlyRow u) g=0)
    (late : 3*headAt g (cθ s)*cubic ξ+2*headAt g ξ*cubic (cθ s)=0)
    (mid : 3*(1-w)*(1-w-s)*headAt g w*cubic (cθ s)=s^2*headAt g (cθ s)*cubic w)
    (m0 : moment0 u w s=0) (m1 : moment1 u w s=0) (m2 : moment2 u w s=0) :
    False := by
  have f : dot3 (lateRow s) g=0 := by rw [lateRowEvaluation s ξ g atξ,late,Semiring.mul_zero]
  have h : dot3 (secondRow w s) g=0 := by rw [secondRowEvaluation,mid]; grind
  have det := singular (earlyRow u) (lateRow s) (secondRow w s) g gN early f h
  rw [determinantFactor] at det
  have dw : -(2*s+3*w-3)≠0 := by
    intro hz
    apply nonzeroMul three distinct
    unfold cξ3 at atξ
    grind
  have out := (Field.of_mul_eq_zero det).resolve_left (nonzeroMul dw cN)
  have b0 : 3*evaluate u w s rootp0=0 := (moment0Expansion u w s).symm.trans m0
  exact eliminate u w s Dnonzero ((Field.of_mul_eq_zero b0).resolve_left three)
    ((moment1Expansion u w s).symm.trans m1) ((moment2Expansion u w s).symm.trans m2) out

