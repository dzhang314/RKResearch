/-! ## The mathematical scalar interfaces -/

private theorem nnMul {x y : K} (hx : x ≠ 0) (hy : y ≠ 0) : x*y ≠ 0 :=
  fun h => hy ((Field.of_mul_eq_zero h).resolve_left hx)

def radau4 (x : K) : K := 66*x^4-120*x^3+72*x^2-16*x+1
def radau5 (x : K) : K := x*radau4 x
def cubic3 (x : K) : K := 30*x^3-36*x^2+12*x-1

def chrono (g h u : K) : K := 6*h+4*u*g+3*u^2

def remainder1 (g h : K) : K := -66*g^3-120*g^2+132*g*h-72*g+120*h-16
def remainder0 (g h : K) : K := -66*g^2*h-120*g*h+66*h^2-72*h+1

theorem radauDivision (g h x : K) :
    radau4 x = (x^2+g*x+h)*(66*x^2+(-66*g-120)*x+66*g^2+120*g-66*h+72)
      + remainder1 g h*x+remainder0 g h := by
  unfold radau4 remainder1 remainder0
  grind

set_option maxHeartbeats 1200000 in
/-- The anchored Radau quartic cannot contain the chronologically
calibrated quadratic divisor, regardless of where its two roots lie. -/
theorem anchoredQuarticImpossible (g h u : K) (two : (2:K) ≠ 0) (three : (3:K) ≠ 0)
    (paid : (anchorden : K) ≠ 0) (root : radau4 u = 0)
    (rm1 : remainder1 g h = 0) (rm0 : remainder0 g h = 0) (j : chrono g h u = 0) : False := by
  have a0 : evaluate g 0 u anchorp0 = 0 := by
    simp only [anchorp0,evaluate,evaluateMon] at *
    unfold radau4 at root
    grind
  have e1 : 6*remainder1 g h =
      12*evaluate g 0 u anchorp1 + (132*g+120)*chrono g h u := by
    simp only [anchorp1,evaluate,evaluateMon,remainder1,chrono]
    grind
  have e0 : 36*remainder0 g h =
      6*evaluate g 0 u anchorp2 +
      chrono g h u * (66*(6*h-(4*u*g+3*u^2))+6*(-66*g^2-120*g-72)) := by
    simp only [anchorp2,evaluate,evaluateMon,remainder0,chrono]
    grind
  have twelve : (12 : K) ≠ 0 := by
    intro hz
    apply nnMul (nnMul two two) three
    grind
  have six : (6:K) ≠ 0 := by
    intro z
    apply twelve
    grind
  have a1 : evaluate g 0 u anchorp1 = 0 := by
    have z : 12*evaluate g 0 u anchorp1 = 0 := by grind
    exact (Field.of_mul_eq_zero z).resolve_left twelve
  have a2 : evaluate g 0 u anchorp2 = 0 := by
    have z : 6*evaluate g 0 u anchorp2 = 0 := by grind
    exact (Field.of_mul_eq_zero z).resolve_left six
  exact anchorcontra g 0 u paid a0 a1 a2

theorem lobattoCubicPairImpossible (u w : K) (paid : (cubicden : K) ≠ 0)
    (r : 3*w = 2*u) (h0 : cubic3 u = 0) (h1 : cubic3 w = 0) : False := by
  have e0 : evaluate (0:K) 0 u cubicp0 = cubic3 u := by
    clear paid r h0 h1 w
    simp only [cubicp0,evaluate,evaluateMon,cubic3]
    grind
  have a0 := e0.trans h0
  have h : 9*cubic3 w = evaluate (0:K) 0 u cubicp1 := by
    calc
      9*cubic3 w = 10*(3*w)^3-36*(3*w)^2+36*(3*w)-9 := by
        unfold cubic3; grind
      _ = 10*(2*u)^3-36*(2*u)^2+36*(2*u)-9 := by rw [r]
      _ = evaluate (0:K) 0 u cubicp1 := by
        simp only [cubicp1,evaluate,evaluateMon]
        grind
  have a1 : evaluate (0:K) 0 u cubicp1 = 0 := by
    rw [←h,h1,Semiring.mul_zero]
  exact cubiccontra 0 0 u paid a0 a1

/-- Numerators of the three exact moments of (X-u)(X-v)(X²+gX+h)
against the weight X(1-X)^3. Normalizing divisors: 2520, 2520, 27720. -/
def moment0 (g h v u : K) : K :=
  42*g*u*v-18*g*u-18*g*v+9*g+126*h*u*v-42*h*u-42*h*v+18*h+18*u*v-9*u-9*v+5
def moment1 (g h v u : K) : K :=
  18*g*u*v-9*g*u-9*g*v+5*g+42*h*u*v-18*h*u-18*h*v+9*h+9*u*v-5*u-5*v+3
def moment2 (g h v u : K) : K :=
  99*g*u*v-55*g*u-55*g*v+33*g+198*h*u*v-99*h*u-99*h*v+55*h+55*u*v-33*u-33*v+21

/-- 60 times the primitive of X(X-u)(X²+gX+h), evaluated at x. -/
def prim60 (g h u x : K) : K :=
  12*x^5+15*(g-u)*x^4+20*(h-g*u)*x^3-30*h*u*x^2

def determinant (g h v u : K) : K :=
  prim60 g h u u*radau5 v - prim60 g h u v*radau5 u

private def transDet (v u : K) : K :=
  10*(198*u^4*v+66*u^3*v^2-360*u^3*v+66*u^2*v^3-120*u^2*v^2+216*u^2*v-32*u*v-u+2*v)

/-- Guarded transfer: the exact three quartic moments and clean primitive
minor are inconsistent on the chart with distinct nonzero clean clocks.
No elimination divides by any polynomial parameter or resultant. -/
theorem lobattoQuarticImpossible (g h v u : K)
    (two : (2:K) ≠ 0) (three : (3:K) ≠ 0) (paid : (pencilden : K) ≠ 0)
    (uN : u ≠ 0) (vN : v ≠ 0) (dN : u-v ≠ 0)
    (m0 : moment0 g h v u = 0) (m1 : moment1 g h v u = 0) (m2 : moment2 g h v u = 0)
    (j : chrono g h u = 0) (e : determinant g h v u = 0) : False := by
  have a0 : 6*moment0 g h v u =
      6*evaluate g v u pencilp0+(126*u*v-42*u-42*v+18)*chrono g h u := by
    simp only [pencilp0,evaluate,evaluateMon,moment0,chrono]; grind
  have a1 : 6*moment1 g h v u =
      3*evaluate g v u pencilp1+(42*u*v-18*u-18*v+9)*chrono g h u := by
    simp only [pencilp1,evaluate,evaluateMon,moment1,chrono]; grind
  have a2 : 6*moment2 g h v u =
      evaluate g v u pencilp2+(198*u*v-99*u-99*v+55)*chrono g h u := by
    simp only [pencilp2,evaluate,evaluateMon,moment2,chrono]; grind
  have a3 : 6*determinant g h v u =
      u*v*(u-v)*(2*evaluate g v u pencilp3+transDet v u*chrono g h u) := by
    simp only [determinant,prim60,radau5,radau4,pencilp3,evaluate,evaluateMon,transDet,chrono]
    grind
  have six : (6:K) ≠ 0 := by
    intro h
    apply nnMul two three
    grind
  have k0 : evaluate g v u pencilp0 = 0 := by
    have p : 6*evaluate g v u pencilp0=0 := by grind
    exact (Field.of_mul_eq_zero p).resolve_left six
  have k1 : evaluate g v u pencilp1 = 0 := by
    have p : 3*evaluate g v u pencilp1=0 := by grind
    exact (Field.of_mul_eq_zero p).resolve_left three
  have k2 : evaluate g v u pencilp2 = 0 := by grind
  have k3 : evaluate g v u pencilp3 = 0 := by
    have p : (u*v*(u-v))*(2*evaluate g v u pencilp3)=0 := by grind
    exact (Field.of_mul_eq_zero ((Field.of_mul_eq_zero p).resolve_left
      (nnMul (nnMul uN vN) dN))).resolve_left two
  exact pencilcontra g v u paid k0 k1 k2 k3

def wMoment (k : Nat) : Rat :=
  6 / (((k+2)*(k+3)*(k+4)*(k+5) : Nat) : Rat)

theorem cubicMoments : ∀ k : Fin 3,
    30*wMoment (k.val+3)-36*wMoment (k.val+2)+12*wMoment (k.val+1)-wMoment k.val = 0 := by
  decide +kernel

def momentIntegers : Fin 3 → Fin 5 → Rat := fun i j =>
  (#[#[126,42,18,9,5],#[42,18,9,5,3],#[198,99,55,33,21]] : Array (Array Rat))[i.val]![j.val]!
def momentScale : Fin 3 → Rat := fun i => (#[2520,2520,27720] : Array Rat)[i.val]!
theorem momentIntegersCorrect : ∀ i : Fin 3, ∀ j : Fin 5,
    momentScale i * wMoment (i.val+j.val) = momentIntegers i j := by
  decide +kernel

end RKResearch.HighOffGate
