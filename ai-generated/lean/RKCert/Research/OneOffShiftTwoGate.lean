/-! ## Masked forward scalar identities, independent of the weight -/

def m1scaled (x H : K) : K := 6*x^2+24*H
def m2scaled (d x H : K) : K := 4*x^3+16*d*H
def m3scaled (d x H : K) : K := 3*x^4+12*(2*d^2-d*x)*H

/-- 48d times the masked J-action. -/
def jNumerator (d z x H : K) : K :=
  96*d^2*(d-x)*H+(z-d)*m3scaled d x H
    -d*(3*z-2*d)*m2scaled d x H+2*d^2*z*m1scaled x H

/-- 60 times the masked V-action. -/
def vNumerator (d z x H : K) : K :=
  5*((3*d+z)*m3scaled d x H-(2*d^2+3*d*z)*m2scaled d x H+2*d^2*z*m1scaled x H)
    -12*x^5

theorem doubledIntercept (d z H : K) :
    jNumerator d z (2*d) H=16*d^5-64*d^3*H := by
  unfold jNumerator m1scaled m2scaled m3scaled
  grind

/-- The cancellation of the two fifth-degree masked profiles leaves a
pure head polynomial and this weight-independent nonlinear residual. -/
theorem masterResidual (d z x H : K) :
    vNumerator d z x H-jNumerator d z x H =
      -48*d*(x^2-2*d^2)*H+12*(x-2*d)*(x-z)*(4*d*H-x^2*(x-2*d)) := by
  unfold jNumerator vNumerator m1scaled m2scaled m3scaled
  grind

/-! ## First placement: a repeated root in a fixed orthogonal cubic -/

def simpleCubic (x : K) : K := 33*x^3-45*x^2+18*x-2
def simpleCubicDeriv (x : K) : K := 99*x^2-90*x+18

theorem simpleCubicBezout (x : K) :
    (138-297*x)*simpleCubic x+(99*x^2-91*x+16)*simpleCubicDeriv x=12 := by
  unfold simpleCubic simpleCubicDeriv
  grind

theorem noDoubleRoot (x : K) (paid : (12:K)≠0)
    (root : simpleCubic x=0) (deriv : simpleCubicDeriv x=0) : False := by
  have e := simpleCubicBezout x
  rw [root,deriv,Semiring.mul_zero,Semiring.mul_zero,Semiring.add_zero] at e
  exact paid e.symm

def cubicMoment (k : Nat) : Rat :=
  6 / (((k+3)*(k+4)*(k+5)*(k+6) : Nat) : Rat)

/-- The exact three orthogonality checks with weight X²(1-X)^3. -/
theorem simpleCubicOrthogonal : ∀ i : Fin 3,
    33*cubicMoment (i.val+3)-45*cubicMoment (i.val+2)+18*cubicMoment (i.val+1)
      -2*cubicMoment i.val=0 := by
  decide +kernel

/-! ## Second placement: actual two preceding doubled clock fibres -/

def c0 (d z w : K) : K := 2*d^2*z*w
def c1 (d z w : K) : K := -3*d*z*w-2*d^2*(z+w)
def c2 (d z w : K) : K := z*w+3*d*(z+w)+2*d^2
def c3 (d z w : K) : K := -(3*d+z+w)

def moment0 (d z w : K) : K :=
  126*c0 d z w+42*c1 d z w+18*c2 d z w+9*c3 d z w+5
def moment1 (d z w : K) : K :=
  42*c0 d z w+18*c1 d z w+9*c2 d z w+5*c3 d z w+3
def moment2 (d z w : K) : K :=
  198*c0 d z w+99*c1 d z w+55*c2 d z w+33*c3 d z w+21

def radau5 (x : K) : K := x*(66*x^4-120*x^3+72*x^2-16*x+1)
/-- 60 times the lower primitive of X(X-d)(X-2d)(X-z). -/
def prim60 (d z x : K) : K :=
  12*x^5-15*(3*d+z)*x^4+20*(2*d^2+3*d*z)*x^3-60*d^2*z*x^2
def primitiveMinor (d z : K) : K :=
  prim60 d z (2*d)*radau5 z-prim60 d z z*radau5 (2*d)

theorem moment0Expansion (d z w : K) : moment0 d z w=evaluate d z w rootp0 := by
  simp only [moment0,c0,c1,c2,c3,evaluate,evaluateMon,rootp0]; grind
theorem moment1Expansion (d z w : K) : moment1 d z w=evaluate d z w rootp1 := by
  simp only [moment1,c0,c1,c2,c3,evaluate,evaluateMon,rootp1]; grind
theorem moment2Expansion (d z w : K) : moment2 d z w=evaluate d z w rootp2 := by
  simp only [moment2,c0,c1,c2,c3,evaluate,evaluateMon,rootp2]; grind
theorem primitiveMinorExpansion (d z w : K) :
    primitiveMinor d z=2*d*z*(z-2*d)*evaluate d z w rootp3 := by
  simp only [primitiveMinor,radau5,prim60,evaluate,evaluateMon,rootp3]
  grind

private theorem mulN {x y : K} (xN : x≠0) (yN : y≠0) : x*y≠0 :=
  fun h => yN ((Field.of_mul_eq_zero h).resolve_left xN)

/-- A genuine doubled pair at both 2d and z makes the late primitive
minor zero. This contradicts the three clean moments in the physical
tied-clock branch, with no ordering assumption. -/
theorem twiceDoubledImpossible (d z w : K) (two : (2:K)≠0)
    (paid : (rootden:K)≠0)
    (dN : d≠0) (zN : z≠0) (diff : z-2*d≠0)
    (m0 : moment0 d z w=0) (m1 : moment1 d z w=0) (m2 : moment2 d z w=0)
    (minor : primitiveMinor d z=0) : False := by
  rw [primitiveMinorExpansion d z w] at minor
  have nz := mulN (mulN (mulN two dN) zN) diff
  exact eliminate d z w paid ((moment0Expansion d z w).symm.trans m0)
    ((moment1Expansion d z w).symm.trans m1) ((moment2Expansion d z w).symm.trans m2)
    ((Field.of_mul_eq_zero minor).resolve_left nz)

end RKResearch.OneOffShiftTwoGate
