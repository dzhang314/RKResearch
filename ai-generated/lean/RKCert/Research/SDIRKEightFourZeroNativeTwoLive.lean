def gapCubic {R : Type*} [CommRing R] (v : R) : R := 4*v^3-12*v^2+3*v+2
def centeredGauss {R : Type*} [CommRing R] (y : R) : R := 35*y^4-30*y^2+3
def mateSquares {R : Type*} [CommRing R] (y z : R) : R := 7*(z^2+y^2)-6

def gate3 {R : Type*} [CommRing R] (v t : R) : R :=
  (2*v^2-4*v-1)*t^3+(-18*v^2+30*v+9)*t^2+(48*v^2-60*v-21)*t-24*v^2+24*v+9

def homGate {R : Type*} [CommRing R] (v y z : R) : R :=
  let a := (1+z)*(1+2*v)
  let b := 1+y
  (2*v^2-4*v-1)*a^3+(-18*v^2+30*v+9)*a^2*b+(48*v^2-60*v-21)*a*b^2+
    (-24*v^2+24*v+9)*b^3

def quad {R : Type*} [CommRing R] (v t : R) : R := (t-1)*(t-1-v)
def affine {R : Type*} [CommRing R] (v t : R) : R := 1+(2-v)*(t-1)

def sixPsi {R : Type*} [CommRing R] (v t : R) : R :=
  quad v (1+2*v) * (3*(2-v)*t^2+6*(v-1)*t-6*affine v t) -
    affine v (1+2*v) * (2*t^3-3*(2+v)*t^2+6*(1+v)*t-6*quad v t)

