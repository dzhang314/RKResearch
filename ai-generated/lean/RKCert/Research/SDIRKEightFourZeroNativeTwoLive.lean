theorem sixPsi_reduce {R : Type*} [CommRing R] (v t : R) :
    sixPsi v t - 2*gate3 v t = -3*(t^2-4*t+2)*gapCubic v := by
  unfold sixPsi gate3 gapCubic quad affine
  ring

theorem homogenize {R : Type*} [CommRing R] {v t y z : R}
    (hh : (1+z)*(1+2*v)=t*(1+y)) :
    homGate v y z = (1+y)^3*gate3 v t := by
  unfold homGate gate3
  rw [hh]
  ring

theorem gauss_difference {R : Type*} [CommRing R] (y z : R) :
    centeredGauss z-centeredGauss y = (z-y)*(z+y)*(5*mateSquares y z) := by
  unfold centeredGauss mateSquares
  ring

theorem two_live_chart_forces_constants {F : Type*} [CommRing F] [IsDomain F]
    {v t y z : F} (h₂ : (2 : F) ≠ 0) (h₅ : (5 : F) ≠ 0)
    (hv : gapCubic v=0) (hy : centeredGauss y=0) (hz : centeredGauss z=0)
    (hneq : z ≠ y) (hh : (1+z)*(1+2*v)=t*(1+y)) (hp : sixPsi v t=0) :
    (z = -y ∧ (546756048 : F)=0) ∨ (z ≠ -y ∧ (1071212373482742144 : F)=0) := by
  have h2g := sixPsi_reduce v t
  rw [hv, hp, mul_zero, zero_sub] at h2g
  have hG : gate3 v t = 0 :=
    (mul_eq_zero.mp (neg_eq_zero.mp h2g)).resolve_left h₂
  have hH : homGate v y z = 0 := by rw [homogenize hh, hG, mul_zero]
  by_cases hm : z = -y
  · left
    rw [hm] at hH
    exact ⟨hm, by simpa [hy,hv,hH] using (mirrorBézout y v).symm⟩
  · right
    have hplus : z+y ≠ 0 := by
      intro he
      exact hm (eq_neg_of_add_eq_zero_left he)
    have hdiff := gauss_difference y z
    rw [hy,hz,sub_zero] at hdiff
    have he : mateSquares y z = 0 :=
      (mul_eq_zero.mp ((mul_eq_zero.mp hdiff.symm).resolve_left
        (mul_ne_zero (sub_ne_zero.mpr hneq) hplus))).resolve_left h₅
    exact ⟨hm, by simpa [hy,hv,he,hH] using (oppositeSitesBézout z y v).symm⟩

theorem integer_factorizations :
    (546756048 : Nat) = 2^4*3^3*1265639 ∧
    (1071212373482742144 : Nat) = 2^7*3^3*1174307*263949107 := by
  decide +kernel

theorem two_live_chart_no_characteristic_zero {F : Type*}
    [CommRing F] [IsDomain F] [CharZero F] {v t y z : F}
    (hv : gapCubic v=0) (hy : centeredGauss y=0) (hz : centeredGauss z=0)
    (hneq : z ≠ y) (hh : (1+z)*(1+2*v)=t*(1+y)) (hp : sixPsi v t=0) :
    False := by
  rcases two_live_chart_forces_constants (by norm_num) (by norm_num) hv hy hz hneq hh hp with
    ⟨_, h⟩ | ⟨_, h⟩ <;> norm_num at h

