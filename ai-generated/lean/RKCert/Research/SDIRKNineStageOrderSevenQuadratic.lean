  decide +kernel

private def δ : K := ⟨(-26022475375), 71656598⟩
private def δConjNeg : K := ⟨(-(-26022475375)), 71656598⟩

private theorem defect_product : δ * δConjNeg = (defectNorm : K) := by decide +kernel

private theorem eighth_bush_relation :
    (13671482834240 : K) *
        (((bushyTree 8).factorial : K) * (bNum ⬝ᵥ Φ (bushyTree 8) ANum) -
          (bDen : K) * (aDen : K)^7) =
    ((bDen : K) * (aDen : K)^7) * δ := by
  rw [factorial_bushyTree, Φ_bushyTree, numerator_row_sums]
  decide +kernel

/-- Any root of the defining quadratic gives the same exact order
provided the two denominators are units and the defect norm is nonzero. -/
theorem exists_exact_of_root {R : Type*} [CommRing R] {ρ : R}
    (hr : ρ * ρ = (radicand : R))
    (hd : IsUnit (aDen : R)) (he : IsUnit (bDen : R))
    (hn : (defectNorm : R) ≠ 0) :
    ∃ (A : Matrix (Fin 9) (Fin 9) R) (b : Fin 9 → R) (γ : R),
      A.IsLowerTriangular ∧ (∀ i, A i i = γ) ∧ IsUnit γ ∧ (4 : R) * γ = 1 ∧
      HasOrder 7 A b ∧ ¬ HasOrder 8 A b := by
  have hρ : ρ * ρ = radicand • (1 : R) + (0 : ℤ) • ρ := by simpa [Algebra.smul_def] using hr
  let f : K →+* R := (QuadraticAlgebra.lift ⟨ρ,hρ⟩).toRingHom
  obtain ⟨du, hdu⟩ := hd
  obtain ⟨eu, heu⟩ := he
  let A : Matrix (Fin 9) (Fin 9) R := ((↑du⁻¹ : R)) • ANum.map f
  let b : Fin 9 → R := ((↑eu⁻¹ : R)) • (f ∘ bNum)
  let γ : R := (↑du⁻¹ : R) * (gNum : R)
  have hA : ANum.map f = f (aDen : K) • A := by
    ext i j
    simp only [map_natCast]
    change f (ANum i j) = (aDen : R) * ((↑du⁻¹ : R) * f (ANum i j))
    rw [← hdu, ← mul_assoc]
    simp
  have hb : f ∘ bNum = f (bDen : K) • b := by
    funext i
    simp only [map_natCast]
    change f (bNum i) = (bDen : R) * ((↑eu⁻¹ : R) * f (bNum i))
    rw [← heu, ← mul_assoc]
    simp
  have hds : IsUnit (f (aDen : K)) := by rw [map_natCast, ← hdu]; exact du.isUnit
  have hes : IsUnit (f (bDen : K)) := by rw [map_natCast, ← heu]; exact eu.isUnit
  have h4n : (4 : ℕ) * gNum = aDen := by decide +kernel
  have h4 : (4 : R) * γ = 1 := by
    have h4r : (4 : R) * (gNum : R) = (aDen : R) := by
      simpa only [Nat.cast_mul, Nat.cast_ofNat] using congrArg (Nat.cast : ℕ → R) h4n
    change (4 : R) * ((↑du⁻¹ : R) * (gNum : R)) = 1
    rw [mul_left_comm, h4r, ← hdu]
    simp
  refine ⟨A,b,γ,?_,?_,IsUnit.of_mul_eq_one 4 (by rw [mul_comm, h4]),h4,?_,?_⟩
  · intro i j hij
    change (↑du⁻¹ : R) * f (ANum i j) = 0
    rw [numeratorTriangular hij, map_zero, mul_zero]
  · intro i
    change (↑du⁻¹ : R) * f (ANum i i) = γ
    rw [numeratorDiagonal, map_natCast]
  · exact hasOrder_of_scaled_check f (fun _ => rfl) (fun _ => rfl) hA hb hds hes checked
  · intro H
    have ho := H (bushyTree 8) (by rw [order_bushyTree]; decide)
    have hh := congrArg f eighth_bush_relation
    simp only [map_mul, map_sub, map_pow, map_natCast, RingHom.map_dotProduct, RKResearch.map_Φ,
      hA, hb, Φ_matrix_smul, smul_dotProduct, dotProduct_smul, smul_eq_mul, order_bushyTree] at hh
    rw [show (((8 : ℕ+) : ℕ) - 1) = 7 by decide +kernel] at hh
    have hΩ : IsUnit ((bDen : R) * (aDen : R)^7) := by
      simpa only [map_natCast] using hes.mul (hds.pow 7)
    have zero : ((bDen : R) * (aDen : R)^7) * f δ = 0 := by
      rw [← hh]
      have hEl :
          ((bushyTree 8).factorial : R) * ((aDen : R)^7 * ((bDen : R) *
            (b ⬝ᵥ Φ (bushyTree 8) A))) = (bDen : R) * (aDen : R)^7 := by
        linear_combination (norm := ring) ((bDen : R) * (aDen : R)^7) * ho
      rw [hEl,sub_self,mul_zero]
    have hf0 : f δ = 0 := hΩ.mul_left_cancel (zero.trans (mul_zero _).symm)
    apply hn
    have hc := congrArg f defect_product
    rw [map_mul, map_natCast, hf0, zero_mul] at hc
    exact hc.symm

theorem simple_root_mod19 :
    (4 : ZMod 19)^2 = (radicand : ZMod 19) ∧ 2 * (4 : ZMod 19) ≠ 0 := by
  decide +kernel

/-- Explicit simple-root lifting. The first root is 4 modulo 19.
At each step the new root is congruent to the old one. -/
theorem exists_int_lift (k : ℕ) :
    ∃ t v : ℤ, (4+19*t)^2 - radicand = (19 : ℤ)^(k+1)*v := by
  induction k with
  | zero => exact ⟨0, -22787, by decide +kernel⟩
  | succ k ih =>
      obtain ⟨t,v,h⟩ := ih
      refine ⟨t-12*(19:ℤ)^k*v, (-5-24*t)*v+144*(19:ℤ)^k*v^2, ?_⟩
      rw [pow_succ (19 : ℤ) (k+1), pow_succ (19 : ℤ) k] at *
      linear_combination (norm := ring) h

private theorem units_at_power {R : Type*} [CommRing R] (k n : ℕ)
    (h0 : (19 : R)^(k+1) = 0) (hc : n.Coprime 19) : IsUnit (n : R) := by
  have hm : (((19 : ℕ)^(k+1) : ℕ) : R) = 0 := by simpa using h0
  let f : ZMod (19^(k+1)) →+* R := ZMod.castHom (ringChar.dvd hm) R
  have hu : IsUnit (n : ZMod (19^(k+1))) :=
    (ZMod.isUnit_iff_coprime _ _).mpr (hc.pow_right (k+1))
  simpa only [map_natCast] using hu.map f

/-- The coefficient ring need not be reduced, local, or a field. -/
theorem exists_exact_of_nineteen_nilpotent (R : Type*) [CommRing R] [Nontrivial R]
    (h : IsNilpotent (19 : R)) :
    ∃ (A : Matrix (Fin 9) (Fin 9) R) (b : Fin 9 → R) (γ : R),
      A.IsLowerTriangular ∧ (∀ i, A i i = γ) ∧ IsUnit γ ∧ (4 : R) * γ = 1 ∧
      HasOrder 7 A b ∧ ¬ HasOrder 8 A b := by
  obtain ⟨k,hk⟩ := h
  have hz : (19 : R) ^ (k+1) = 0 := by rw [pow_succ,hk,zero_mul]
  obtain ⟨t,v,hh⟩ := exists_int_lift k
  have hr : (((4+19*t : ℤ) : R)) * (((4+19*t : ℤ) : R)) = (radicand : R) := by
    have hh' := congrArg (Int.castRingHom R) hh
    simp only [map_sub, map_mul, map_pow, Int.coe_castRingHom, Int.cast_ofNat, hz, zero_mul] at hh'
    simpa only [pow_two] using sub_eq_zero.mp hh'
  exact exists_exact_of_root hr
    (units_at_power k _ hz (by decide +kernel))
    (units_at_power k _ hz (by decide +kernel))
    (units_at_power k _ hz (by decide +kernel)).ne_zero

/-- With the independent F19 lower bound, every positive power of 19
has strict SDIRK order-seven minimum nine. -/
theorem exists_exact_mod_power (k : ℕ) :
    ∃ (A : Matrix (Fin 9) (Fin 9) (ZMod (19^(k+1))))
      (b : Fin 9 → ZMod (19^(k+1))) (γ : ZMod (19^(k+1))),
      A.IsLowerTriangular ∧ (∀ i, A i i = γ) ∧ IsUnit γ ∧ (4 : ZMod (19^(k+1))) * γ = 1 ∧
      HasOrder 7 A b ∧ ¬ HasOrder 8 A b := by
  let n : ℕ := 19^(k+1)
  let : Fact (1 < n) := ⟨Nat.one_lt_pow (by omega) (by decide)⟩
  apply exists_exact_of_nineteen_nilpotent (R := ZMod n)
  exact ⟨k+1, by rw [← Nat.cast_ofNat, ← Nat.cast_pow]; exact ZMod.natCast_self n⟩

abbrev CoeffField := QuadraticAlgebra ℚ (432969 : ℚ) 0

theorem radicand_not_square : ¬ IsSquare (432969 : ℚ) := by
  rw [← Nat.cast_ofNat (R := ℚ), Rat.isSquare_natCast_iff]
  rintro ⟨s, hs⟩
  have h0 := congrArg Nat.sqrt hs
  rw [Nat.sqrt_eq] at h0
  have h1 : Nat.sqrt 432969 = 658 := by decide +kernel
  rw [h1] at h0
  exact (by decide +kernel : (432969 : ℕ) ≠ 658*658) (by rwa [← h0] at hs)

instance irrationalRoot : Fact (∀ r : ℚ, r^2 ≠ (432969 : ℚ) + 0*r) := by
  constructor
  intro r hr
  apply radicand_not_square
  exact ⟨r, by simpa [pow_two] using hr.symm⟩

