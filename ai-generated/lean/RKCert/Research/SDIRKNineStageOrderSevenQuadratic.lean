/-- A characteristic-zero witness in an explicit real quadratic field. -/
theorem exists_exact_quadratic :
    ∃ (A : Matrix (Fin 9) (Fin 9) CoeffField)
      (b : Fin 9 → CoeffField) (γ : CoeffField),
      A.IsLowerTriangular ∧ (∀ i, A i i = γ) ∧ IsUnit γ ∧ (4 : CoeffField) * γ = 1 ∧
      HasOrder 7 A b ∧ ¬ HasOrder 8 A b := by
  let ρ : CoeffField := ⟨0,1⟩
  have hρ : ρ * ρ = (radicand : CoeffField) := by decide +kernel
  exact exists_exact_of_root hρ
    (isUnit_iff_ne_zero.mpr (by decide +kernel))
    (isUnit_iff_ne_zero.mpr (by decide +kernel))
    (by decide +kernel)

