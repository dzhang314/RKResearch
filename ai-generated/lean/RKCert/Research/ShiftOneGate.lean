def pencilDen : Int := 19443497358891130087432166062370387383976122519321875687230682651062323832938540409939491709621111893980003298098780
private def pencilResidual : Poly :=
  productPoly pencila0 pencilp0 ++ productPoly pencila1 pencilp1 ++ productPoly pencila2 pencilp2 ++ productPoly pencila3 pencilp3 ++ [⟨-pencilDen,0,0,0⟩]


set_option maxHeartbeats 0 in
set_option maxRecDepth 30000 in
private theorem pencilChecked : allZero (normalized pencilResidual) = true := by
  decide +kernel

private theorem pencilEliminate (g v u : K) (paid : (pencilDen:K)≠0)
    (h0 : evaluate g v u pencilp0=0)
    (h1 : evaluate g v u pencilp1=0)
    (h2 : evaluate g v u pencilp2=0)
    (h3 : evaluate g v u pencilp3=0) : False := by
  have h := certificateSound g v u pencilResidual pencilChecked
  simp only [pencilResidual,evalAppend,evalProduct,h0,h1,h2,h3,
    Semiring.mul_zero,AddCommMonoid.zero_add,evaluate,evaluateMon,
    Ring.intCast_neg,Semiring.pow_zero,Semiring.mul_one,Semiring.add_zero] at h
  apply paid
  grind


def pencilMoment0 (g h v u : K) : K :=
  28 * g * u * v - 14 * g * u - 14 * g * v + 8 * g + 70 * h * u * v - 28 * h * u - 28 * h * v + 14 * h + 14 * u * v - 8 * u - 8 * v + 5


theorem pencilExpansion0 (g h v u : K) :
    3*pencilMoment0 g h v u=
      (1*evaluate g v u pencilp0+(35 * u * v - 14 * u - 14 * v + 7)*chrono g h u) := by
  simp only [pencilMoment0,chrono,pencilp0,evaluate,evaluateMon]
  grind


def pencilMoment1 (g h v u : K) : K :=
  42 * g * u * v - 24 * g * u - 24 * g * v + 15 * g + 84 * h * u * v - 42 * h * u - 42 * h * v + 24 * h + 24 * u * v - 15 * u - 15 * v + 10


theorem pencilExpansion1 (g h v u : K) :
    1*pencilMoment1 g h v u=
      (1*evaluate g v u pencilp1+(14 * u * v - 7 * u - 7 * v + 4)*chrono g h u) := by
  simp only [pencilMoment1,chrono,pencilp1,evaluate,evaluateMon]
  grind


def pencilMoment2 (g h v u : K) : K :=
  48 * g * u * v - 30 * g * u - 30 * g * v + 20 * g + 84 * h * u * v - 48 * h * u - 48 * h * v + 30 * h + 30 * u * v - 20 * u - 20 * v + 14


theorem pencilExpansion2 (g h v u : K) :
    1*pencilMoment2 g h v u=
      (1*evaluate g v u pencilp2+(14 * u * v - 8 * u - 8 * v + 5)*chrono g h u) := by
  simp only [pencilMoment2,chrono,pencilp2,evaluate,evaluateMon]
  grind


def pencilPrim60 (g h u x : K) : K :=
  -20 * g * u * x^3 + 15 * g * x^4 - 30 * h * u * x^2 + 20 * h * x^3 - 15 * u * x^4 + 12 * x^5


def pencilMinor (g h v u : K) : K :=
  pencilPrim60 g h u u*radau5 v-pencilPrim60 g h u v*radau5 u


theorem pencilExpansion3 (g h v u : K) :
    3*pencilMinor g h v u=
      (u*v*(u-v)) * (1*evaluate g v u pencilp3+(630 * u^4 * v + 210 * u^3 * v^2 - 1260 * u^3 * v + 210 * u^2 * v^3 - 420 * u^2 * v^2 + 840 * u^2 * v - 140 * u * v - 5 * u + 10 * v)*chrono g h u) := by
  simp only [pencilMinor,chrono,pencilp3,evaluate,evaluateMon,pencilPrim60,radau5,radau4]
  grind



/-- First clean clock is not a root of the head in the high-pencilled
or six-off / six-clean case. Uses no ordering and no head-value divisions. -/
theorem pencilImpossible (g h v u : K)
    (paid : (pencilDen:K)≠0)
    (uN : u≠0) (vN : v≠0) (dN : u-v≠0) (j : chrono g h u=0)
    (a0 : pencilMoment0 g h v u=0) (a1 : pencilMoment1 g h v u=0)
    (a2 : pencilMoment2 g h v u=0) (a3 : pencilMinor g h v u=0) : False := by
  have e0 := pencilExpansion0 g h v u
  have e1 := pencilExpansion1 g h v u
  have e2 := pencilExpansion2 g h v u
  have e3 := pencilExpansion3 g h v u
  have v0 : evaluate g v u pencilp0=0 := by grind
  have v1 : evaluate g v u pencilp1=0 := by grind
  have v2 : evaluate g v u pencilp2=0 := by grind
  have ep : u*v*(u-v)*evaluate g v u pencilp3=0 := by grind
  have v3 := cancelFactor (nnMul (nnMul uN vN) dN) ep
  exact pencilEliminate g v u paid v0 v1 v2 v3


