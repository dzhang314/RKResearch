def fiveSixMoment2 (u w s : K) : K :=
  126 * s^2 * u * w - 72 * s^2 * u - 72 * s^2 * w + 45 * s^2 - 144 * s * u * w + 72 * s * u + 72 * s * w - 40 * s + 45 * u * w - 20 * u - 20 * w + 10


theorem fiveSixExpansion2 (u w s : K) :
    1*fiveSixMoment2 u w s=(1*evaluate u w s fiveSixp2) := by
  simp only [fiveSixMoment2,fiveSixp2,evaluate,evaluateMon]
  grind


def fiveSixL125 (x : K) : K :=
  42 * x^3 - 280 * x^2 + 525 * x - 250


structure Row3 (K : Type) where
  x0 : K
  x1 : K
  x2 : K

def dot3 (a g : Row3 K) : K := a.x0*g.x0+a.x1*g.x1+a.x2*g.x2
def det3 (a b c : Row3 K) : K :=
  a.x0*(b.x1*c.x2-b.x2*c.x1)-a.x1*(b.x0*c.x2-b.x2*c.x0)+a.x2*(b.x0*c.x1-b.x1*c.x0)

theorem singular (a b c g : Row3 K)
    (gN : g.x0≠0 ∨ g.x1≠0 ∨ g.x2≠0)
    (h0 : dot3 a g=0) (h1 : dot3 b g=0) (h2 : dot3 c g=0) : det3 a b c=0 := by
  rcases gN with x | y | z
  · have e : (det3 a b c)*g.x0=0 := by
      have e0 := congrArg (fun v => (b.x1*c.x2-b.x2*c.x1)*v) h0
      have e1 := congrArg (fun v => (c.x1*a.x2-c.x2*a.x1)*v) h1
      have e2 := congrArg (fun v => (a.x1*b.x2-a.x2*b.x1)*v) h2
      unfold det3 dot3 at *
      grind
    exact (Field.of_mul_eq_zero e).resolve_right x
  · have e : (det3 a b c)*g.x1=0 := by
      have e0 := congrArg (fun v => (b.x2*c.x0-b.x0*c.x2)*v) h0
      have e1 := congrArg (fun v => (c.x2*a.x0-c.x0*a.x2)*v) h1
      have e2 := congrArg (fun v => (a.x2*b.x0-a.x0*b.x2)*v) h2
      unfold det3 dot3 at *
      grind
    exact (Field.of_mul_eq_zero e).resolve_right y
  · have e : (det3 a b c)*g.x2=0 := by
      have e0 := congrArg (fun v => (b.x0*c.x1-b.x1*c.x0)*v) h0
      have e1 := congrArg (fun v => (c.x0*a.x1-c.x1*a.x0)*v) h1
      have e2 := congrArg (fun v => (a.x0*b.x1-a.x1*b.x0)*v) h2
      unfold det3 dot3 at *
      grind
    exact (Field.of_mul_eq_zero e).resolve_right z




def theta (s : K) : K := 1-s
def xi5 (s : K) : K := 5-3*s
def fiveSixEarly (u : K) : Row3 K := ⟨6,4*u,3*u^2⟩
def fiveSixLate (s : K) : Row3 K :=
  let θ := theta s
  let j := xi5 s
  let L := lobatto3 θ
  let L' := fiveSixL125 j
  ⟨L'+75*L,L'*θ+15*L*j,L'*θ^2+3*L*j^2⟩
def fiveSixSecond (w s : K) : Row3 K :=
  let θ := theta s
  let r := 1-w
  let p := 5*r*(r-s)*lobatto3 θ
  let q := 2*s^2*lobatto3 w
  ⟨p-q,p*w-q*θ,p*w^2-q*θ^2⟩
def headAt (g : Row3 K) (x : K) : K := g.x0+g.x1*x+g.x2*x^2
def fiveSixDet (u w s : K) : K := det3 (fiveSixEarly u) (fiveSixLate s) (fiveSixSecond w s)

theorem fiveSixLateExpansion (s ξ : K) (g : Row3 K) (atξ : 5*ξ=xi5 s) :
    dot3 (fiveSixLate s) g =
      25*(5*headAt g (theta s)*lobatto3 ξ+3*headAt g ξ*lobatto3 (theta s)) := by
  rw [fiveSixLate,←atξ]
  dsimp [dot3,headAt,lobatto3,fiveSixL125]
  grind

theorem fiveSixSecondExpansion (w s : K) (g : Row3 K) :
    dot3 (fiveSixSecond w s) g =
      5*(1-w)*(1-w-s)*headAt g w*lobatto3 (theta s)
       -2*s^2*headAt g (theta s)*lobatto3 w := by
  dsimp [dot3,headAt,fiveSixSecond]
  grind


theorem fiveSixExpansion3 (u w s : K) :
    1*fiveSixDet u w s=((5*w+3*s-5)*lobatto3 (theta s)) * (2*evaluate u w s fiveSixp3) := by
  simp only [fiveSixDet,fiveSixp3,evaluate,evaluateMon, fiveSixEarly, fiveSixLate, fiveSixSecond, det3, xi5, theta, lobatto3, fiveSixL125]
  grind



/-- Five off / six clean: shifted moments and the actual homogeneous head constraints. -/
theorem fiveSixImpossible (u w s xi : K) (g : Row3 K)
    (two : (2:K)≠0) (paid : (fiveSixDen:K)≠0)
    (gN : g.x0≠0 ∨ g.x1≠0 ∨ g.x2≠0) (xiAt : 5*xi=xi5 s)
    (distinct : 5*w+3*s-5≠0) (cubicNonzero : lobatto3 (theta s)≠0)
    (a0 : fiveSixMoment0 u w s=0) (a1 : fiveSixMoment1 u w s=0)
    (a2 : fiveSixMoment2 u w s=0) (j : 6*g.x0+4*u*g.x1+3*u^2*g.x2=0)
    (late : 5*headAt g (theta s)*lobatto3 xi+3*headAt g xi*lobatto3 (theta s)=0)
    (sec : 5*(1-w)*(1-w-s)*headAt g w*lobatto3 (theta s)
       -2*s^2*headAt g (theta s)*lobatto3 w=0) : False := by
  have j0 : dot3 (fiveSixEarly u) g=0 := by
    simpa only [dot3,fiveSixEarly] using j
  have j1 := fiveSixLateExpansion s xi g xiAt
  have j2 := fiveSixSecondExpansion w s g
  have d : fiveSixDet u w s=0 := singular _ _ _ g gN j0 (by grind) (by grind)
  have e0 := fiveSixExpansion0 u w s
  have e1 := fiveSixExpansion1 u w s
  have e2 := fiveSixExpansion2 u w s
  have e3 := fiveSixExpansion3 u w s
  have p : ((5*w+3*s-5)*lobatto3 (theta s))*(2*evaluate u w s fiveSixp3)=0 := by grind
  exact fiveSixEliminate u w s paid (by grind) (by grind) (by grind)
     (cancelFactor two (cancelFactor (nnMul distinct cubicNonzero) p))



/-- Terminal reads on the shift-one reflected resonance 5t=3s. -/
theorem fiveSixVisible (s t b x L : K) (sN : s≠0)
    (res : 5*t=3*s) (e1 : 3*x-b*s^2=L) (e2 : 4*t*x-b*s^3=t*L) :
    L=b*s^2 ∧ 5*t^2*x-b*s^4=(2*s*t-s^2)*L := by
  have et := congrArg (fun z => t*z) e1
  have ex := congrArg (fun z => (x+b*s^2)*z) res
  have eq0 : s*(3*x-2*b*s^2)=0 := by grind
  have eq1 := cancelFactor sN eq0
  have eq2 : 3*x=2*b*s^2 := by grind
  have eq3 : L=b*s^2 := by grind
  have h1 := congrArg (fun z => t*x*z) res
  have h2 := congrArg (fun z => s*t*z) eq2
  exact ⟨eq3,by grind⟩

/-- The recalibrated two-feed identity at the second early clean row. -/
theorem fiveSixSecondFeed (s t r b x y L : K) (twelve : (12:K)≠0)
    (rS : r-s≠0) (res : 5*t=3*s)
    (e1 : 3*(x+y)-b*r^2=L)
    (e2 : 4*(s*x+t*y)-b*r^3=t*L)
    (e3 : 5*(s^2*x+t^2*y)-b*r^4=(s*t-(s-t)*r)*L) :
    5*b*r^2*(r-s)=2*s*L := by
  let f1 := 3*(x+y)-b*r^2-L
  let f2 := 4*(s*x+t*y)-b*r^3-t*L
  let f3 := 5*(s^2*x+t^2*y)-b*r^4-(s*t-(s-t)*r)*L
  have f1z : f1=0 := by dsimp [f1]; grind
  have f2z : f2=0 := by dsimp [f2]; grind
  have f3z : f3=0 := by dsimp [f3]; rw [e3,AddCommGroup.sub_self]
  have e :
      60*f3-75*(s+t)*f2+100*s*t*f1+12*(r-s)*(5*b*r^2*(r-s)-2*s*L) =
        (5*t-3*s)*(-12*L*r-8*L*s+15*L*t+15*b*r^3-20*b*r^2*s) := by
    dsimp [f1,f2,f3]; grind
  have hres : 5*t-3*s=0 := by rw [res,AddCommGroup.sub_self]
  have hv : (12*(r-s))*(5*b*r^2*(r-s)-2*s*L)=0 := by
    simpa only [f1z,f2z,f3z,hres,Semiring.mul_zero,Semiring.zero_mul,
      AddCommMonoid.zero_add,AddCommGroup.sub_self] using e
  exact AddCommGroup.sub_eq_zero_iff.mp (cancelFactor (nnMul twelve rS) hv)

/-- Barycentric comparisons with the shift-one resonance and two-feed mode. -/
theorem fiveSixComparisons
    (s t r Hθ Hξ Hw ℓθ ℓξ ℓw Lθ Lξ Lw bθ bξ bw pθ pξ pw T D : K)
    (sN : s≠0) (TN : T≠0) (res : 5*t=3*s)
    (qθ : bθ*s*pθ*Lθ=T) (qξ : bξ*t*pξ*Lξ=T) (qw : bw*r*pw*Lw=T)
    (dθ : ℓθ*Hθ*pθ=D) (dξ : ℓξ*Hξ*pξ=D) (dw : ℓw*Hw*pw=D)
    (hθ : ℓθ=bθ*s^2) (hξ : ℓξ=-(bξ*t^2))
    (hw : 5*bw*r^2*(r-s)=2*s*ℓw) :
    5*Hθ*Lξ+3*Hξ*Lθ=0 ∧ 5*r*(r-s)*Hw*Lθ=2*s^2*Hθ*Lw := by
  have a : D*Lθ=T*s*Hθ := by
    have x := congrArg (fun z => z*Lθ) dθ
    have y := congrArg (fun z => z*s*Hθ) qθ
    grind
  have b : D*Lξ=-(T*t*Hξ) := by
    have x := congrArg (fun z => z*Lξ) dξ
    have y := congrArg (fun z => z*t*Hξ) qξ
    grind
  have h : (T*s)*(5*Hθ*Lξ+3*Hξ*Lθ)=0 := by
    have aa := congrArg (fun z => 5*z*Lξ) a
    have bb := congrArg (fun z => 5*z*Lθ) b
    have rr := congrArg (fun z => T*Hξ*Lθ*z) res
    grind
  have v1 := cancelFactor (nnMul TN sN) h
  have e : 2*s*D*Lw=5*T*r*(r-s)*Hw := by
    have x := congrArg (fun z => 2*s*Lw*z) dw
    have y := congrArg (fun z => 5*r*(r-s)*Hw*z) qw
    have w := congrArg (fun z => Hw*pw*Lw*z) hw
    grind
  have v : T*(5*r*(r-s)*Hw*Lθ-2*s^2*Hθ*Lw)=0 := by
    have x := congrArg (fun z => Lθ*z) e
    have y := congrArg (fun z => 2*s*Lw*z) a
    grind
  have v2 := cancelFactor TN v
  exact ⟨v1,by grind⟩


