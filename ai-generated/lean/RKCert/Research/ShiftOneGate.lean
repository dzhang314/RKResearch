def fibresPrim60 (d z x : K) : K :=
  40 * d^2 * x^3 - 60 * d^2 * x^2 * z - 45 * d * x^4 + 60 * d * x^3 * z + 12 * x^5 - 15 * x^4 * z


def fibresMinor (d z : K) : K :=
  fibresPrim60 d z (2*d)*radau5 z-fibresPrim60 d z z*radau5 (2*d)


theorem fibresExpansion3 (d z v : K) :
    1*fibresMinor d z=(d*z*(2*d-z)) * (2*evaluate d z v fibresp3) := by
  simp only [fibresMinor,fibresp3,evaluate,evaluateMon,fibresPrim60,radau5,radau4]
  grind



/-- Single off clock with two genuine early doubled clean fibres. -/
theorem fibresImpossible (d z v : K)
    (p2 : (2:K)≠0) (paid : (fibresDen:K)≠0)
    (dN : d≠0) (zN : z≠0) (dz : 2*d-z≠0)
    (a0 : fibresMoment0 d z v=0) (a1 : fibresMoment1 d z v=0)
    (a2 : fibresMoment2 d z v=0) (a3 : fibresMinor d z=0) : False := by
  have e0 := fibresExpansion0 d z v
  have e1 := fibresExpansion1 d z v
  have e2 := fibresExpansion2 d z v
  have e3 := fibresExpansion3 d z v
  have ep : d*z*(2*d-z)*(2*evaluate d z v fibresp3)=0 := by grind
  exact fibresEliminate d z v paid (by grind) (by grind) (by grind)
    (cancelFactor p2 (cancelFactor (nnMul (nnMul dN zN) dz) ep))


