private theorem anchoredChecked : allZero (normalized anchoredResidual) = true := by
  decide +kernel

private theorem anchoredEliminate (g sx u : K) (paid : (anchoredDen:K)≠0)
    (h0 : evaluate g sx u anchoredp0=0)
    (h1 : evaluate g sx u anchoredp1=0)
    (h2 : evaluate g sx u anchoredp2=0) : False := by
  have h := certificateSound g sx u anchoredResidual anchoredChecked
  simp only [anchoredResidual,evalAppend,evalProduct,h0,h1,h2,
    Semiring.mul_zero,AddCommMonoid.zero_add,evaluate,evaluateMon,
    Ring.intCast_neg,Semiring.pow_zero,Semiring.mul_one,Semiring.add_zero] at h
  apply paid
  grind


def remainder1 (g h : K) : K :=
  -42 * g^3 - 84 * g^2 + 84 * g * h - 56 * g + 84 * h - 14


def remainder0 (g h : K) : K :=
  -42 * g^2 * h - 84 * g * h + 42 * h^2 - 56 * h + 1


theorem radauDivision (g h x : K) :
    radau4 x=(x^2+g*x+h)*(42 * g^2 - 42 * g * x + 84 * g - 42 * h + 42 * x^2 - 84 * x + 56)
      + remainder1 g h*x+remainder0 g h := by
  unfold radau4 remainder1 remainder0
  grind


theorem anchoredExpansion0 (g h u : K) :
    1*radau4 u=
      (1*evaluate g (0:K) u anchoredp0+(0)*chrono g h u) := by
  simp only [radau4,chrono,anchoredp0,evaluate,evaluateMon]
  grind


theorem anchoredExpansion1 (g h u : K) :
    1*remainder1 g h=
      (14*evaluate g (0:K) u anchoredp1+(14 * g + 14)*chrono g h u) := by
  simp only [remainder1,chrono,anchoredp1,evaluate,evaluateMon]
  grind


theorem anchoredExpansion2 (g h u : K) :
    6*remainder0 g h=
      (1*evaluate g (0:K) u anchoredp2+(-42 * g^2 - 28 * g * u - 84 * g + 42 * h - 21 * u^2 - 56)*chrono g h u) := by
  simp only [remainder0,chrono,anchoredp2,evaluate,evaluateMon]
  grind



/-- Calibrated quadratic head dividing the anchored Radau quartic. -/
theorem anchoredImpossible (g h u : K)
    (p14 : (14:K)≠0) (paid : (anchoredDen:K)≠0)
    (r : radau4 u=0) (r1 : remainder1 g h=0) (r0 : remainder0 g h=0)
    (j : chrono g h u=0) : False := by
  have e0 := anchoredExpansion0 g h u
  have e1 := anchoredExpansion1 g h u
  have e2 := anchoredExpansion2 g h u
  have v0 : evaluate g 0 u anchoredp0=0 := by grind
  have v1 := cancelFactor p14 (show 14*evaluate g 0 u anchoredp1=0 by grind)
  have v2 : evaluate g 0 u anchoredp2=0 := by grind
  exact anchoredEliminate g 0 u paid v0 v1 v2


