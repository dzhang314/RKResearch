def fibresMoment2 (d z v : K) : K :=
  84 * d^2 * v * z - 48 * d^2 * v - 48 * d^2 * z + 30 * d^2 - 72 * d * v * z + 45 * d * v + 45 * d * z - 30 * d + 15 * v * z - 10 * v - 10 * z + 7


theorem fibresExpansion2 (d z v : K) :
