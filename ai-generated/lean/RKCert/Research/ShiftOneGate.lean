private theorem headRootChecked : allZero (normalized headRootResidual) = true := by
  decide +kernel

private theorem headRootEliminate (t z a : K) (paid : (headRootDen:K)≠0)
    (h0 : evaluate t z a headRootp0=0)
    (h1 : evaluate t z a headRootp1=0)
    (h2 : evaluate t z a headRootp2=0)
    (h3 : evaluate t z a headRootp3=0) : False := by
  have h := certificateSound t z a headRootResidual headRootChecked
  simp only [headRootResidual,evalAppend,evalProduct,h0,h1,h2,h3,
    Semiring.mul_zero,AddCommMonoid.zero_add,evaluate,evaluateMon,
    Ring.intCast_neg,Semiring.pow_zero,Semiring.mul_one,Semiring.add_zero] at h
  apply paid
  grind


def headRootMoment0 (a t z : K) : K :=
  35 * a^2 * t * z - 14 * a^2 * t - 14 * a^2 * z + 7 * a^2 - 42 * a * t * z + 21 * a * t + 21 * a * z - 12 * a + 14 * t * z - 8 * t - 8 * z + 5


theorem headRootExpansion0 (a t z : K) :
    1*headRootMoment0 a t z=(1*evaluate t z a headRootp0) := by
  simp only [headRootMoment0,headRootp0,evaluate,evaluateMon]
  grind


def headRootMoment1 (a t z : K) : K :=
  84 * a^2 * t * z - 42 * a^2 * t - 42 * a^2 * z + 24 * a^2 - 126 * a * t * z + 72 * a * t + 72 * a * z - 45 * a + 48 * t * z - 30 * t - 30 * z + 20


theorem headRootExpansion1 (a t z : K) :
    1*headRootMoment1 a t z=(1*evaluate t z a headRootp1) := by
  simp only [headRootMoment1,headRootp1,evaluate,evaluateMon]
  grind


def headRootMoment2 (a t z : K) : K :=
  42 * a^2 * t * z - 24 * a^2 * t - 24 * a^2 * z + 15 * a^2 - 72 * a * t * z + 45 * a * t + 45 * a * z - 30 * a + 30 * t * z - 20 * t - 20 * z + 14


theorem headRootExpansion2 (a t z : K) :
    1*headRootMoment2 a t z=(1*evaluate t z a headRootp2) := by
  simp only [headRootMoment2,headRootp2,evaluate,evaluateMon]
  grind


def headRootPrim60 (a t x : K) : K :=
  -30 * a^2 * t * x^2 + 20 * a^2 * x^3 + 60 * a * t * x^3 - 45 * a * x^4 - 30 * t * x^4 + 24 * x^5


def headRootMinor (a t z : K) : K :=
  headRootPrim60 a t a*radau5 z-headRootPrim60 a t z*radau5 a


theorem headRootExpansion3 (a t z : K) :
    1*headRootMinor a t z=(a*z*(a-z)) * (1*evaluate t z a headRootp3) := by
  simp only [headRootMinor,headRootp3,evaluate,evaluateMon,headRootPrim60,radau5,radau4]
  grind



/-- Six off / six clean, first nonzero clean clock is a root of the head. -/
theorem headRootImpossible (a t z : K) (paid : (headRootDen:K)≠0)
    (aN : a≠0) (zN : z≠0) (dN : a-z≠0)
    (a0 : headRootMoment0 a t z=0) (a1 : headRootMoment1 a t z=0)
    (a2 : headRootMoment2 a t z=0) (a3 : headRootMinor a t z=0) : False := by
  have e0 := headRootExpansion0 a t z
  have e1 := headRootExpansion1 a t z
  have e2 := headRootExpansion2 a t z
  have e3 := headRootExpansion3 a t z
  exact headRootEliminate t z a paid (by grind) (by grind) (by grind)
    (cancelFactor (nnMul (nnMul aN zN) dN)
      (show a*z*(a-z)*evaluate t z a headRootp3=0 by grind))


