def fibresMoment0 (d z v : K) : K :=
  140 * d^2 * v * z - 56 * d^2 * v - 56 * d^2 * z + 28 * d^2 - 84 * d * v * z + 42 * d * v + 42 * d * z - 24 * d + 14 * v * z - 8 * v - 8 * z + 5


theorem fibresExpansion0 (d z v : K) :
    1*fibresMoment0 d z v=(1*evaluate d z v fibresp0) := by
  simp only [fibresMoment0,fibresp0,evaluate,evaluateMon]
  grind


def fibresMoment1 (d z v : K) : K :=
  168 * d^2 * v * z - 84 * d^2 * v - 84 * d^2 * z + 48 * d^2 - 126 * d * v * z + 72 * d * v + 72 * d * z - 45 * d + 24 * v * z - 15 * v - 15 * z + 10


theorem fibresExpansion1 (d z v : K) :
