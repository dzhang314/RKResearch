import Lean

/-!
# Shift-one weighted order-nine scalar atlas

Checks the exact endpoint moment polynomials, paid factor reductions,
and explicit integer certificates for the scalar leaves of the twelve-row
branch atlas. Construction from rooted tableau order is in the separate
mathematical proof. No external Gröbner computation is trusted in Lean.
-/
namespace RKResearch.ShiftOneGate
open Lean.Grind
attribute [local instance] Ring.intCast
variable {K : Type} [Field K]

structure Mon where
  c : Int
  g : Nat
  v : Nat
  u : Nat
deriving DecidableEq

abbrev Poly := List Mon

def evaluateMon (g v u : K) (t : Mon) : K := (t.c : K) * g^t.g * v^t.v * u^t.u

def evaluate (g v u : K) : Poly → K
  | [] => 0
  | x::xs => evaluateMon g v u x + evaluate g v u xs

def productMon (a b : Mon) : Mon := ⟨a.c*b.c, a.g+b.g, a.v+b.v, a.u+b.u⟩
def productPoly (a b : Poly) : Poly := a.flatMap (fun x => b.map (productMon x))

theorem evalAppend (g v u : K) (p q : Poly) :
    evaluate g v u (p++q) = evaluate g v u p + evaluate g v u q := by
  induction p with
  | nil => simp [evaluate]; grind
  | cons m xs ih =>
    simp only [List.cons_append,evaluate,ih,Semiring.add_assoc]

theorem evalProductMon (g v u : K) (a b : Mon) :
    evaluateMon g v u (productMon a b) = evaluateMon g v u a * evaluateMon g v u b := by
  unfold evaluateMon productMon
  simp only [Ring.intCast_mul,Semiring.pow_add]
  grind

theorem evalProductMap (g v u : K) (a : Mon) (p : Poly) :
    evaluate g v u (p.map (productMon a)) = evaluateMon g v u a * evaluate g v u p := by
  induction p with
  | nil => simp [evaluate,Semiring.mul_zero]
  | cons m p ih =>
    simp only [List.map_cons,evaluate,evalProductMon,ih,Semiring.left_distrib]

theorem evalProduct (g v u : K) (p q : Poly) :
    evaluate g v u (productPoly p q) = evaluate g v u p * evaluate g v u q := by
  induction p with
  | nil => simp [evaluate,productPoly,Semiring.zero_mul]
  | cons m p ih =>
    simp only [productPoly,List.flatMap_cons,evalAppend,evalProductMap,evaluate,
      Semiring.right_distrib]
    rw [← productPoly]
    exact congrArg (fun x => evaluateMon g v u m * evaluate g v u q + x) ih

def same (a b : Mon) : Prop := a.g=b.g ∧ a.v=b.v ∧ a.u=b.u
instance (a b : Mon) : Decidable (same a b) := by unfold same; infer_instance

def compact (m : Mon) : Poly → Poly
  | [] => [m]
  | n::ns => if same m n then compact {n with c:=m.c+n.c} ns else m::compact n ns

theorem evalCompact (g v u : K) (m : Mon) (xs : Poly) :
    evaluate g v u (compact m xs) = evaluate g v u (m::xs) := by
  induction xs generalizing m with
  | nil => rfl
  | cons n ns ih =>
    by_cases h : same m n
    · obtain ⟨h1,h2,h3⟩ := h
      simp only [compact,ite_eq_left (show same m n from ⟨h1,h2,h3⟩),ih,evaluate,
        evaluateMon,Ring.intCast_add, h1,h2,h3]
      grind
    · simp only [compact,ite_eq_right h,evaluate]
      have hh := ih n
      rw [hh]
      rfl

def key (m : Mon) : Nat := m.g+32*(m.v+32*m.u)
def fuelMerge : Nat → Poly → Poly → Poly
  | 0, a, b => a++b
  | _+1, [], b => b
  | _+1, a, [] => a
  | n+1, a::as, b::bs =>
    if key a ≤ key b then a::fuelMerge n as (b::bs)
    else b::fuelMerge n (a::as) bs

theorem evalFuelMerge (g v u : K) (n : Nat) (p q : Poly) :
    evaluate g v u (fuelMerge n p q) = evaluate g v u p + evaluate g v u q := by
  induction n generalizing p q with
  | zero => exact evalAppend g v u p q
  | succ n ih =>
    cases p with
    | nil => simp only [fuelMerge,evaluate]; grind
    | cons a as =>
      cases q with
      | nil =>
        simp only [fuelMerge,evaluate,Semiring.add_zero]
      | cons b bs =>
        unfold fuelMerge
        split
        · rw [evaluate,ih]
          simp only [evaluate,Semiring.add_assoc]
        · rw [evaluate,ih]
          simp only [evaluate]
          grind

def fuelSort : Nat → Poly → Poly
  | 0, p => p
  | _+1, [] => []
  | _+1, [a] => [a]
  | n+1, a::b::p =>
    let xs := a::b::p
    let t := xs.length/2
    fuelMerge xs.length (fuelSort n (xs.take t)) (fuelSort n (xs.drop t))

theorem evalFuelSort (g v u : K) (n : Nat) (p : Poly) :
    evaluate g v u (fuelSort n p) = evaluate g v u p := by
  induction n generalizing p with
  | zero => rfl
  | succ n ih =>
    cases p with
    | nil => rfl
    | cons a xs =>
      cases xs with
      | nil => rfl
      | cons b xs =>
        rw [fuelSort,evalFuelMerge,ih,ih,←evalAppend,List.take_append_drop]

def normalized (p : Poly) : Poly :=
  match fuelSort 16 p with
  | [] => []
  | a::as => compact a as

theorem evalNormalized (g v u : K) (p : Poly) :
    evaluate g v u (normalized p) = evaluate g v u p := by
  have hh := evalFuelSort g v u 16 p
  cases hs : fuelSort 16 p with
  | nil =>
    rw [hs] at hh
    simpa [normalized,hs] using hh
  | cons x xs =>
    rw [hs] at hh
    simpa [normalized,hs,evalCompact] using hh

def allZero (p : Poly) : Bool := p.all (fun m => m.c == 0)

theorem zeroEval (g v u : K) (p : Poly) (h : allZero p = true) :
    evaluate g v u p = 0 := by
  induction p with
  | nil => rfl
  | cons m p ih =>
    have hh : m.c = 0 ∧ allZero p = true := by
      simpa only [allZero,List.all_cons,Bool.and_eq_true,beq_iff_eq] using h
    rw [evaluate, ih hh.2]
    simp [evaluateMon,hh.1,Ring.intCast_zero,Semiring.zero_mul,Semiring.add_zero]

theorem certificateSound (g v u : K) (p : Poly) (hc : allZero (normalized p) = true) :
    evaluate g v u p = 0 := (evalNormalized g v u p).symm.trans (zeroEval _ _ _ _ hc)




private theorem nnMul {x y : K} (hx : x ≠ 0) (hy : y ≠ 0) : x*y ≠ 0 :=
  fun h => hy ((Field.of_mul_eq_zero h).resolve_left hx)

private theorem cancelFactor {b p : K} (nz : b ≠ 0) (e : b*p=0) : p=0 :=
  (Field.of_mul_eq_zero e).resolve_left nz

def radau4 (x : K) : K := 42*x^4-84*x^3+56*x^2-14*x+1
def radau5 (x : K) : K := x*radau4 x
def lobatto3 (x : K) : K := 42*x^3-56*x^2+21*x-2
def repeated3 (x : K) : K := 12*x^3-18*x^2+8*x-1
def repeatedDeriv (x : K) : K := 9*x^2-9*x+2

theorem radauAtOne : radau5 (1:K)=1 := by
  unfold radau5 radau4
  grind

theorem radauReflection (x : K) : radau4 (1-x)=radau4 x := by
  unfold radau4
  grind

private theorem reflectedScale (s t : K) (r : 5*t=3*s) :
    625*radau4 t=3402*s^4-11340*s^3+12600*s^2-5250*s+625 := by
  have e : 625*radau4 t =
      42*(5*t)^4-420*(5*t)^3+1400*(5*t)^2-1750*(5*t)+625 := by
    unfold radau4
    grind
  rw [r] at e
  grind

/-- Five off / five clean: two reflected clean clocks cannot resonate. -/
theorem reflectedRadauImpossible (s t : K) (paid : (503606:K) ≠ 0)
    (r : 5*t=3*s) (a : radau4 (1-s)=0) (b : radau4 (1-t)=0) : False := by
  rw [radauReflection] at a b
  have e := reflectedScale s t r
  have ident :
      (52586415*s^3-147323610*s^2+117044109*s-20750769)*radau4 s
      +(-649215*s^3+953190*s^2-366429*s+34007)*
        (3402*s^4-11340*s^3+12600*s^2-5250*s+625)=503606 := by
    unfold radau4
    grind
  grind

/-- Six off / five clean, with a degree-one head. -/
theorem directRadauImpossible (u v : K) (paid : (9287:K) ≠ 0)
    (r : 3*v=2*u) (a : radau4 u=0) (b : radau4 v=0) : False := by
  have e : 27*radau4 v =
      14*(3*v)^4-84*(3*v)^3+168*(3*v)^2-126*(3*v)+27 := by
    unfold radau4
    grind
  rw [r] at e
  have ident :
      (720384*u^3-1901312*u^2+1454656*u-264304)*radau4 u
      +(-135072*u^3+221424*u^2-96348*u+10133)*
        (224*u^4-672*u^3+672*u^2-252*u+27)=9287 := by
    unfold radau4
    grind
  grind




/-- Four effective clean labels, degree-one head. -/
theorem directLobattoImpossible (u v : K) (paid : (233:K) ≠ 0)
    (two : (2:K)≠0) (r : 3*v=2*u) (a : lobatto3 u=0) (b : lobatto3 v=0) : False := by
  have e : 9*lobatto3 v =
      14*(3*v)^3-56*(3*v)^2+63*(3*v)-18 := by
    unfold lobatto3
    grind
  rw [r] at e
  have eq0 : 2*(56*u^3-112*u^2+63*u-9)=0 := by grind
  have eq1 := cancelFactor two eq0
  have ident :
      (4088*u^2-6216*u+1823)*lobatto3 u
      +(-3066*u^2+2618*u-431)*(56*u^3-112*u^2+63*u-9)=233 := by
    unfold lobatto3
    grind
  grind

/-- The one-off, new-seventh-clock cubic and its quarter derivative. -/
theorem repeatedCubicImpossible (u : K) (h : repeated3 u=0)
    (p : repeatedDeriv u=0) : False := by
  have identity :
      (27-54*u)*repeated3 u+(72*u^2-72*u+14)*repeatedDeriv u=1 := by
    unfold repeated3 repeatedDeriv
    grind
  grind

def wAnchor (k : Nat) : Rat := 1 / (((k+2)*(k+3) : Nat) : Rat)
def wLobatto (k : Nat) : Rat := 2 / (((k+2)*(k+3)*(k+4) : Nat) : Rat)
def wSquare (k : Nat) : Rat := 2 / (((k+3)*(k+4)*(k+5) : Nat) : Rat)

theorem radauMoments : ∀ k : Fin 4,
    42*wAnchor (k.val+4)-84*wAnchor (k.val+3)+56*wAnchor (k.val+2)
      -14*wAnchor (k.val+1)+wAnchor k.val=0 := by
  decide +kernel

theorem lobattoMoments : ∀ k : Fin 3,
    42*wLobatto (k.val+3)-56*wLobatto (k.val+2)+21*wLobatto (k.val+1)
      -2*wLobatto k.val=0 := by
  decide +kernel

theorem repeatedMoments : ∀ k : Fin 3,
    12*wSquare (k.val+3)-18*wSquare (k.val+2)+8*wSquare (k.val+1)
      -wSquare k.val=0 := by
  decide +kernel

def momentsZ : Fin 3 → Fin 5 → Rat := fun i j =>
  (#[#[70,28,14,8,5],#[84,42,24,15,10],#[84,48,30,20,14]] :
    Array (Array Rat))[i.val]![j.val]!
def momentScale : Fin 3 → Rat := fun i => (#[840,2520,5040] : Array Rat)[i.val]!

theorem momentsZCorrect : ∀ i : Fin 3, ∀ j : Fin 5,
    momentScale i * wLobatto (i.val+j.val) = momentsZ i j := by
  decide +kernel


def chrono (g h u : K) : K :=
  4 * g * u + 6 * h + 3 * u^2


