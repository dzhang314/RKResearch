def fiveSixDen : Int := 1621679820846283676525876655192978442995925401010634434091666890061123250231151135596924494030432360156245021240272000
private def fiveSixResidual : Poly :=
  productPoly fiveSixa0 fiveSixp0 ++ productPoly fiveSixa1 fiveSixp1 ++ productPoly fiveSixa2 fiveSixp2 ++ productPoly fiveSixa3 fiveSixp3 ++ [⟨-fiveSixDen,0,0,0⟩]


set_option maxHeartbeats 0 in
set_option maxRecDepth 30000 in
private theorem fiveSixChecked : allZero (normalized fiveSixResidual) = true := by
  decide +kernel

private theorem fiveSixEliminate (u w s : K) (paid : (fiveSixDen:K)≠0)
    (h0 : evaluate u w s fiveSixp0=0)
    (h1 : evaluate u w s fiveSixp1=0)
    (h2 : evaluate u w s fiveSixp2=0)
    (h3 : evaluate u w s fiveSixp3=0) : False := by
  have h := certificateSound u w s fiveSixResidual fiveSixChecked
  simp only [fiveSixResidual,evalAppend,evalProduct,h0,h1,h2,h3,
    Semiring.mul_zero,AddCommMonoid.zero_add,evaluate,evaluateMon,
    Ring.intCast_neg,Semiring.pow_zero,Semiring.mul_one,Semiring.add_zero] at h
  apply paid
  grind


def fiveSixMoment0 (u w s : K) : K :=
  210 * s^2 * u * w - 84 * s^2 * u - 84 * s^2 * w + 42 * s^2 - 336 * s * u * w + 112 * s * u + 112 * s * w - 48 * s + 140 * u * w - 40 * u - 40 * w + 15


theorem fiveSixExpansion0 (u w s : K) :
    1*fiveSixMoment0 u w s=(1*evaluate u w s fiveSixp0) := by
  simp only [fiveSixMoment0,fiveSixp0,evaluate,evaluateMon]
  grind


def fiveSixMoment1 (u w s : K) : K :=
  252 * s^2 * u * w - 126 * s^2 * u - 126 * s^2 * w + 72 * s^2 - 336 * s * u * w + 144 * s * u + 144 * s * w - 72 * s + 120 * u * w - 45 * u - 45 * w + 20


theorem fiveSixExpansion1 (u w s : K) :
    1*fiveSixMoment1 u w s=(1*evaluate u w s fiveSixp1) := by
