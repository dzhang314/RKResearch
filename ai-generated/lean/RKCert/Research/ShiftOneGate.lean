private def headRootResidual : Poly :=
  productPoly headRoota0 headRootp0 ++ productPoly headRoota1 headRootp1 ++ productPoly headRoota2 headRootp2 ++ productPoly headRoota3 headRootp3 ++ [⟨-headRootDen,0,0,0⟩]


