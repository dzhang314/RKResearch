/-! ## Interfaces in the actual clock names -/

/-- Coefficients of (X-t)(X-z)(2X²-3aX+a²), from degree 0 to 3;
the top coefficient is 2. -/
def c0 (a t z : K) : K := a^2*t*z
def c1 (a t z : K) : K := -3*a*t*z-a^2*(t+z)
def c2 (a t z : K) : K := 2*t*z+3*a*(t+z)+a^2
def c3 (a t z : K) : K := -2*(t+z)-3*a

def moment0 (a t z : K) : K :=
  126*c0 a t z+42*c1 a t z+18*c2 a t z+9*c3 a t z+10
def moment1 (a t z : K) : K :=
  42*c0 a t z+18*c1 a t z+9*c2 a t z+5*c3 a t z+6
def moment2 (a t z : K) : K :=
  198*c0 a t z+99*c1 a t z+55*c2 a t z+33*c3 a t z+42

def radau5 (x : K) : K := x*(66*x^4-120*x^3+72*x^2-16*x+1)
/-- 60 times the actual lower primitive of X(X-t)(2X²-3aX+a²). -/
def prim60 (a t x : K) : K :=
  24*x^5-15*(2*t+3*a)*x^4+20*(a^2+3*a*t)*x^3-30*a^2*t*x^2
def theMinor (a t z : K) : K :=
  prim60 a t a*radau5 z-prim60 a t z*radau5 a

private theorem mulN {x y : K} (hx : x≠0) (hy : y≠0) : x*y≠0 :=
  fun h => hy ((Field.of_mul_eq_zero h).resolve_left hx)

/-- If a is the first nonzero clean clock and a root of the quadratic head,
the chronological primitive forces the remaining head root to be a/2. -/
theorem rootChronology (a b : K) (aN : a≠0)
    (paid : a^3*(2*b-a)=0) : 2*b=a := by
  have h : a^3 ≠ 0 := by
    have r := mulN (mulN aN aN) aN
    intro hz
    apply r
    grind
  have o := (Field.of_mul_eq_zero paid).resolve_left h
  grind

theorem moment0Expansion (a t z : K) : moment0 a t z=evaluate t z a rootp0 := by
  simp only [moment0,c0,c1,c2,c3,evaluate,evaluateMon,rootp0]
  grind
theorem moment1Expansion (a t z : K) : moment1 a t z=evaluate t z a rootp1 := by
  simp only [moment1,c0,c1,c2,c3,evaluate,evaluateMon,rootp1]
  grind
theorem moment2Expansion (a t z : K) : moment2 a t z=evaluate t z a rootp2 := by
  simp only [moment2,c0,c1,c2,c3,evaluate,evaluateMon,rootp2]
  grind
theorem minorExpansion (a t z : K) :
    theMinor a t z=a*z*(a-z)*evaluate t z a rootp3 := by
  simp only [theMinor,prim60,radau5,evaluate,evaluateMon,rootp3]
  grind

/-- Exact exclusion in the six/six clock placement where the first
nonzero clean clock is a root of the head. The only polynomial
factor cancelled in the reduction is a*z*(a-z). -/
theorem calibratedRootImpossible (a t z : K) (constant : (rootden:K)≠0)
    (aN : a≠0) (zN : z≠0) (dN : a-z≠0)
    (m0 : moment0 a t z=0) (m1 : moment1 a t z=0) (m2 : moment2 a t z=0)
    (minor : theMinor a t z=0) : False := by
  have h0 := (moment0Expansion a t z).symm.trans m0
  have h1 := (moment1Expansion a t z).symm.trans m1
  have h2 := (moment2Expansion a t z).symm.trans m2
  rw [minorExpansion a t z] at minor
  have h3 := (Field.of_mul_eq_zero minor).resolve_left (mulN (mulN aN zN) dN)
  exact eliminate t z a constant h0 h1 h2 h3

end RKResearch.SixOffSixGate
