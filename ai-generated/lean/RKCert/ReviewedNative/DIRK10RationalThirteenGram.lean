private theorem extOfCheck (X Y : Cov 13)
    (h : (List.finRange 14).all (fun i => (List.finRange 14).all (fun j => decide (X i j = Y i j))) = true) :
    X = Y := by
  ext i j
  have hi := List.all_eq_true.mp h _ (List.mem_finRange i)
  exact of_decide_eq_true (List.all_eq_true.mp hi j (List.mem_finRange j))

private theorem checkedBase : covScale 0 • cov 0 = outer 1 := by
  exact extOfCheck _ _ (by decide +kernel)

private theorem prodL0 : branch M D 1 * cov 0 = leftScale 0 • left 0 := by
  exact extOfCheck _ _ (by decide +kernel)
private theorem prodR0 : left 0 * (branch M D 1)ᵀ = rightScale 0 • right 0 := by
  exact extOfCheck _ _ (by decide +kernel)
private theorem hLhs0 : covScale (0+1) = common 0 * lhs 0 := by decide +kernel
private theorem hCoeff0 : ∀ i : Fin (0+1),
    covScale i.val * (covScale (0-i.val) * leftScale (0-i.val) * rightScale (0-i.val)) =
      common 0 * coeff 0 i.val := by decide +kernel
private theorem hNext0 : lhs 0 • cov (0+1) =
    ((List.finRange (0+1)).map fun i => coeff 0 i.val •
      entryMul (cov i.val) (reweight (0-i.val+1) (right (0-i.val)))).sum := by
  exact extOfCheck _ _ (by decide +kernel)

