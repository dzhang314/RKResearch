private theorem extOfCheck (X Y : Cov 12)
    (h : (List.finRange 13).all (fun i => (List.finRange 13).all (fun j => decide (X i j = Y i j))) = true) :
    X = Y := by
  ext i j
  have hi := List.all_eq_true.mp h _ (List.mem_finRange i)
  exact of_decide_eq_true (List.all_eq_true.mp hi j (List.mem_finRange j))

