private theorem hCoeff7 : ∀ i : Fin (7+1),
    covScale i.val * (covScale (7-i.val) * leftScale (7-i.val) * rightScale (7-i.val)) =
      common 7 * coeff 7 i.val := by decide +kernel
private theorem hNext7 : lhs 7 • cov (7+1) =
    ((List.finRange (7+1)).map fun i => coeff 7 i.val •
      entryMul (cov i.val) (reweight (7-i.val+1) (right (7-i.val)))).sum := by
  exact extOfCheck _ _ (by decide +kernel)

#check hNext7
private theorem prodL8 : branch M D 1 * cov 8 = leftScale 8 • left 8 := by
  exact extOfCheck _ _ (by decide +kernel)
private theorem prodR8 : left 8 * (branch M D 1)ᵀ = rightScale 8 • right 8 := by
  exact extOfCheck _ _ (by decide +kernel)
private theorem hLhs8 : covScale (8+1) = common 8 * lhs 8 := by decide +kernel
private theorem hCoeff8 : ∀ i : Fin (8+1),
    covScale i.val * (covScale (8-i.val) * leftScale (8-i.val) * rightScale (8-i.val)) =
      common 8 * coeff 8 i.val := by decide +kernel
private theorem hNext8 : lhs 8 • cov (8+1) =
    ((List.finRange (8+1)).map fun i => coeff 8 i.val •
      entryMul (cov i.val) (reweight (8-i.val+1) (right (8-i.val)))).sum := by
  exact extOfCheck _ _ (by decide +kernel)

#check hNext8
private theorem hEnergy0 : energy (cov 0) (output w D (0+1)) = 0 := by decide +kernel
private theorem hEnergy1 : energy (cov 1) (output w D (1+1)) = 0 := by decide +kernel
private theorem hEnergy2 : energy (cov 2) (output w D (2+1)) = 0 := by decide +kernel
private theorem hEnergy3 : energy (cov 3) (output w D (3+1)) = 0 := by decide +kernel
private theorem hEnergy4 : energy (cov 4) (output w D (4+1)) = 0 := by decide +kernel
private theorem hEnergy5 : energy (cov 5) (output w D (5+1)) = 0 := by decide +kernel
private theorem hEnergy6 : energy (cov 6) (output w D (6+1)) = 0 := by decide +kernel
private theorem hEnergy7 : energy (cov 7) (output w D (7+1)) = 0 := by decide +kernel
private theorem hEnergy8 : energy (cov 8) (output w D (8+1)) = 0 := by decide +kernel
private theorem hEnergy9 : energy (cov 9) (output w D (9+1)) = 0 := by decide +kernel
private theorem prodLAll (n : Fin 9) : branch M D 1 * cov n.val = leftScale n.val • left n.val := by
  fin_cases n
  · exact prodL0
  · exact prodL1
  · exact prodL2
  · exact prodL3
  · exact prodL4
  · exact prodL5
  · exact prodL6
  · exact prodL7
  · exact prodL8

private theorem prodRAll (n : Fin 9) : left n.val * (branch M D 1)ᵀ = rightScale n.val • right n.val := by
  fin_cases n
  · exact prodR0
  · exact prodR1
  · exact prodR2
  · exact prodR3
  · exact prodR4
  · exact prodR5
  · exact prodR6
  · exact prodR7
  · exact prodR8

private theorem hLhsAll (n : Fin 9) : covScale (n.val+1) = common n.val * lhs n.val := by
  fin_cases n
  · exact hLhs0
  · exact hLhs1
  · exact hLhs2
  · exact hLhs3
  · exact hLhs4
  · exact hLhs5
  · exact hLhs6
  · exact hLhs7
  · exact hLhs8

private theorem hCoeffAll (n : Fin 9) : ∀ i : Fin (n.val+1),
    covScale i.val * (covScale (n.val-i.val) * leftScale (n.val-i.val) * rightScale (n.val-i.val)) =
      common n.val * coeff n.val i.val := by
  fin_cases n
  · exact hCoeff0
  · exact hCoeff1
  · exact hCoeff2
  · exact hCoeff3
  · exact hCoeff4
  · exact hCoeff5
  · exact hCoeff6
  · exact hCoeff7
  · exact hCoeff8

private theorem hNextAll (n : Fin 9) : lhs n.val • cov (n.val+1) =
    ((List.finRange (n.val+1)).map fun i => coeff n.val i.val •
      entryMul (cov i.val) (reweight (n.val-i.val+1) (right (n.val-i.val)))).sum := by
  fin_cases n
  · exact hNext0
  · exact hNext1
  · exact hNext2
  · exact hNext3
  · exact hNext4
  · exact hNext5
  · exact hNext6
  · exact hNext7
  · exact hNext8

private theorem hEnergyAll (n : Fin 10) : energy (cov n.val) (output w D (n.val+1)) = 0 := by
  fin_cases n
  · exact hEnergy0
  · exact hEnergy1
  · exact hEnergy2
  · exact hEnergy3
  · exact hEnergy4
  · exact hEnergy5
  · exact hEnergy6
  · exact hEnergy7
  · exact hEnergy8
  · exact hEnergy9

private def trace : FactoredTrace M D 10 where
  cov := cov
  left := left
  right := right
  covScale := covScale
  leftScale := leftScale
  rightScale := rightScale
  common := common
  lhs := lhs
  coeff := coeff
  base := checkedBase
  hleft n hn := prodLAll ⟨n, by omega⟩
  hright n hn := prodRAll ⟨n, by omega⟩
  hlhs n hn := hLhsAll ⟨n, by omega⟩
  hcoeff n hn := hCoeffAll ⟨n, by omega⟩
  next n hn := hNextAll ⟨n, by omega⟩

theorem order_scaled {R : Type*} [CommRing R]
    (f : ℤ →+* R) (U : Matrix (Fin 12) (Fin 12) R) (b : Fin 12 → R)
    (hA : M.map f = f D • U) (hb : f ∘ w = f D • b) (hd : IsUnit (f D)) :
    HasOrder 10 U b :=
  trace.hasOrder (fun n hn => hEnergyAll ⟨n,hn⟩) f U b hA hb hd hd

end RKResearch.Certified.DIRK10RationalTwelve
