set_option maxRecDepth 20000
set_option maxHeartbeats 0

theorem pack32 :
    Packing.read (base:Int) (gate R3 2) = eval Q (base:Int)*eval quotient32 (base:Int) := by
  decide +kernel

theorem bound32 : bound (gate R3 2) + norm Q * norm quotient32 < base := by
  decide +kernel

theorem gate32_checked {K : Type*} [CommRing K] {x : K} (hx : eval Q x = 0) :
    Packing.read x (gate R3 2) = 0 := quotient_from_packed x hx pack32 bound32

