set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
theorem frobenius_nine :
    frobStates[0]! = X29 ∧ frobStates[9]! = X29 ∧
    (List.zipWith (fun a b => decide (frobenius a = b)) frobStates (frobStates.drop 1)).all id = true := by
  decide +kernel

def Frob3MinusX : List Int :=
  List.zipWith (fun a b => (a-b)%29) (frobStates[3]!) X29

def BezoutA : List Int := [11,21,7,17,15,6,22,25]
def BezoutB : List Int := [2,18,17,24,28,5,15,19,21]

set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
theorem frobenius_three_bezout :
    List.zipWith (fun a b => (a+b)%29) (polyMul BezoutA F29) (polyMul BezoutB Frob3MinusX)
      = (1 : Int)::List.replicate 16 0 := by
  decide +kernel

def horner17 (x : Int) (cs : List Int) : Int :=
  cs.foldl (fun a c => (a*x+c)%17) 0

def N : List Int :=
  [5376000,-10590720,9105600,-4477616,1385568,-279450,36720,-3036,144,-3]

theorem monic_reduction :
    (N.reverse.map (fun z => (z*13)%29)) = F29 := by
  decide +kernel

def derivN : List Int :=
  (List.range 9).map fun i => N[i]! * Int.ofNat (9-i)

def B : List Int := [896,-840,300,-48,3]
def MN : List Int := [5600,-5400,1984,-327,21]
def NN : List Int := [1600,-1600,611,-105,7]

theorem other_17_place :
  horner17 14 N=0 ∧ horner17 14 derivN=4 ∧ horner17 14 B=13 ∧
  (5*horner17 14 B*12+horner17 14 MN)%17=0 ∧
  (5*horner17 14 B*5-horner17 14 NN)%17=0 ∧ (12^2-4*5:Int)%17=5 := by
  decide +kernel

theorem five_nonsquare_mod17 :
  (List.range 17).all (fun x => !((x*x)%17 == 5)) = true := by
  decide +kernel

