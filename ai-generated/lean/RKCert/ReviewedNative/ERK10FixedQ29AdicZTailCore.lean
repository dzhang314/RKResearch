/-! Exact fraction-free checks of the normalized terminal observer at the
fixed-q decic; no local-ring or imported Mathlib proof is used here. -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000

def decic : List Int := [8840760201800, (-253467892079060), 3137934176909504, (-22147907712268517), 99189988063653812, (-295624157281470449), 595327896073372740, (-801391965499578390), 691140376781707950, (-345177595434956400), 75851682979590000]

def leading : Nat := 75851682979590000

structure Rep where
  nums : List Int
  den : Nat

def zipSum : List Int → List Int → List Int
  | [], ys => ys
  | xs, [] => xs
  | x::xs, y::ys => (x+y)::zipSum xs ys

def scale (n : Int) (xs : List Int) : List Int := xs.map (n * ·)

def conv : List Int → List Int → List Int
  | [], _ => []
  | a::as, bs => zipSum (scale a bs) (0::conv as bs)

/-- At index m+10 eliminate the leading coefficient by the precise operation
"leading * numerator - top * X^m * decic". -/
def reduce (n : Nat) (xs : List Int) (den : Nat) : Rep :=
  match n with
  | 0 => ⟨xs, den⟩
  | m+1 =>
    let top := xs[m+10]?.getD 0
    let next := zipSum (scale leading xs) (List.replicate m 0 ++ scale (-top) decic)
    reduce m (next.take (m+10)) (den*leading)

def add (a b : Rep) : Rep :=
  ⟨zipSum (scale (Int.ofNat b.den) a.nums) (scale (Int.ofNat a.den) b.nums), a.den*b.den⟩

def mul (a b : Rep) : Rep :=
  let xs := conv a.nums b.nums
  reduce (xs.length-10) xs (a.den*b.den)

def neg (a : Rep) : Rep := ⟨scale (-1) a.nums, a.den⟩
def con (n : Int) : Rep := ⟨[n], 1⟩
def zero (a : Rep) : Bool := a.nums.all (· == 0)

instance : Add Rep := ⟨add⟩
instance : Mul Rep := ⟨mul⟩
instance : Neg Rep := ⟨neg⟩
instance : Sub Rep := ⟨fun a b => a + -b⟩
instance (n : Nat) : OfNat Rep n := ⟨con (Int.ofNat n)⟩

def pow (a : Rep) : Nat → Rep
  | 0 => 1
  | n+1 => pow a n*a
instance : Pow Rep Nat := ⟨pow⟩

def eval (p : List Rep) (y : Rep) : Rep :=
  p.foldr (fun coeff acc => coeff+y*acc) 0

