def jac (y : Rep) : Rep := (y*(1+y*(-14+y*(56+y*(-84+42*y)))))

def pZ (y : Rep) : Rep := jac c*y^3*(10*c^2+y*(-15*c+6*y))-c^5*jac y
def nZ (y : Rep) : Rep := 2*Q*c+2*((-2)*Q+c*S-c^2)*y
def vZ (y : Rep) : Rep := eval [v0,v1,v2] y
def qZ (y : Rep) : Rep := eval [q0,q1,q2,q3] y
def d3 (y : Rep) : Rep := (y^2-S*y+Q)*(y-26)
def mu (y : Rep) : Rep := eval [mu0,mu1,mu2,mu3,mu4,mu5,mu6] y

def divGate (y : Rep) : Rep := y^2*(y-c)^2*vZ y+nZ y*pZ y-d3 y*qZ y
def scaleGate : Rep := (26-1)*nZ 26*sigma-mu 26*26*(26-15)*(26-c)
def outGate (y : Rep) : Rep := mu y*(y-15)*pZ y+(y-1)*y*sigma*(y-c)*vZ y

def paidDen (r : Rep) : Bool := r.den % 29 != 0

theorem den_paid : ((leading % 29 != 0) &&
    [S,Q,E,F,sigma,v0,v1,v2,q0,q1,q2,q3,mu0,mu1,mu2,mu3,mu4,mu5,mu6].all paidDen) =
      true := by decide +kernel

theorem div_0_exact : zero (divGate 0) = true := by decide +kernel
