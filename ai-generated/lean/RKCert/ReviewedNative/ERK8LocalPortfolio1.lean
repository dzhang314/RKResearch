module

public import RKCert.ReviewedNative.ERKSparseIntegerReplay

@[expose] public section

/-! Order-eight eleven-stage rational witness 1 for the complementary
denominator portfolio. Each check is an exact integer kernel computation. -/
namespace RKResearch.Certified.ERK8LocalPortfolio1

open ERKQuadraticIntegerReplay

def D : Nat := 

def rows : Array (Array Int) := #[
  #[],
  #[],
  #[0, ],
  #[, -, ],
  #[, 0, , ],
  #[-, , , , -],
  #[-, 0, , -, , -],
  #[, 0, -, , -, , ],
  #[, 0, -, , -, , , -],
  #[-, 0, , -, , -, -, , ],
  #[-, 0, , -, , -, -, , , ] ]
def nums : Array Int := #[,0,0,0,-,0,,,,,]

def M (i j : Fin 11) : Pair := if j < i then pack rows[i.val]![j.val]! else pack 0
def w (i : Fin 11) : Pair := pack nums[i.val]!

set_option maxRecDepth 50000
set_option maxHeartbeats 0
private theorem pay0 : ERKSparseIntegerReplay.checkOn 0 (D : Int) M w 0 = true := by decide +kernel
private theorem pay1 : ERKSparseIntegerReplay.checkOn 0 (D : Int) M w 1 = true := by decide +kernel
private theorem pay2 : ERKSparseIntegerReplay.checkOn 0 (D : Int) M w 2 = true := by decide +kernel
private theorem pay3 : ERKSparseIntegerReplay.checkOn 0 (D : Int) M w 3 = true := by decide +kernel
private theorem pay4 : ERKSparseIntegerReplay.checkOn 0 (D : Int) M w 4 = true := by decide +kernel
private theorem pay5 : ERKSparseIntegerReplay.checkOn 0 (D : Int) M w 5 = true := by decide +kernel
private theorem pay6 : ERKSparseIntegerReplay.checkOn 0 (D : Int) M w 6 = true := by decide +kernel
private theorem pay7 : ERKSparseIntegerReplay.checkOn 0 (D : Int) M w 7 = true := by decide +kernel

variable {R : Type*} [CommRing R]

def A (d : R) : Matrix (Fin 11) (Fin 11) R := tableau 0 d M
def b (d : R) : Fin 11 → R := weights 0 d w

theorem explicit (d : R) : ERK (A d) := by
  intro i j hij
  change val (0 : R) (if j < i then _ else pack 0) * d = 0
  simp [Fin.not_lt.mpr hij, val_pack]

theorem order_eight (d : R) (hd : (D : R) * d = 1) : HasOrder 8 (A d) (b d) := by
  apply order_of_check (D : Int) (s := 0) (δ := 0) (by simp) d
    (by simpa only [Int.cast_natCast] using hd)
  intro k hk
  rw [←ERKSparseIntegerReplay.checkOn_eq]
  have h8 : k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5 ∨ k = 6 ∨ k = 7 := by omega
  rcases h8 with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    first | exact pay0 | exact pay1 | exact pay2 | exact pay3 | exact pay4 | exact pay5 | exact pay6 | exact pay7

theorem exists_order_eight_of_denom_unit (hd : IsUnit (D : R)) :
    ∃ A' : Matrix (Fin 11) (Fin 11) R, ∃ b' : Fin 11 → R, ERK A' ∧ HasOrder 8 A' b' := by
  obtain ⟨u, hu⟩ := hd
  let d : R := ↑(u⁻¹)
  have hd' : (D : R) * d = 1 := by rw [←hu]; exact Units.mul_inv u
  exact ⟨A d, b d, explicit d, order_eight d hd'⟩

end RKResearch.Certified.ERK8LocalPortfolio1

