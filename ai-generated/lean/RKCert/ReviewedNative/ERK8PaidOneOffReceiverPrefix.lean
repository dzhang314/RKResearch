module
public import RKCert.ReviewedNative.ERK8PaidArithmetic

public import RKCert.ReviewedNative.ERK8PaidOneOffConstantAmplitude
public import RKCert.ReviewedNative.FiniteOrderCheck

@[expose] public section

/-! # Exact tableau-prefix consumers of the native one-off normal form -/
namespace RKResearch.Certified.Graded.OneOff.PaidProof
open RKResearch RKResearch.FiniteRootedTree Module
open scoped Classical Matrix FiniteRootedTree

variable {K : Type*} [Field K] [EightUnits K] {s : ℕ}
variable {A : Matrix (Fin s) (Fin s) K}

private theorem trees0 : treesOfOrderSucc 0 = [.leaf] := treesOfOrderSucc.eq_1
private theorem trees1 : treesOfOrderSucc 1 = [.leaf ◂ .leaf] := by
  simp [treesOfOrderSucc, List.finRange_succ]
private theorem trees2 : treesOfOrderSucc 2 =
    [.leaf ◂ (.leaf ◂ .leaf), (.leaf ◂ .leaf) ◂ .leaf] := by
  simp [treesOfOrderSucc, List.finRange_succ]

omit [EightUnits K] in
private theorem norm_two_leaf (A : Matrix (Fin s) (Fin s) K) :
    normTree A (.leaf ◂ .leaf) = nodes A := by
  rw [normTree_clock, normTree_leaf]
  ext i
  simp

private theorem norm_diff_three (A : Matrix (Fin s) (Fin s) K) :
    normTree A (.leaf ◂ (.leaf ◂ .leaf)) -
      normTree A ((.leaf ◂ .leaf) ◂ .leaf) = (2 : K) • g A := by
  rw [normTree_unary A (.leaf ◂ .leaf), normTree_clock A (.leaf ◂ .leaf), norm_two_leaf]
  ext i
  simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, diag_apply, g_apply,
    order, PNat.add_coe, PNat.one_coe]
  norm_num
  eight_ring K

/-- The only same-order difference through order three is the tall-vs-bushy
difference. This uses the checked reviewed constructor-order enumerator. -/
theorem grade_two_span (A : Matrix (Fin s) (Fin s) K) :
    zeroSpace A 2 = Submodule.span K {g A} := by
  apply le_antisymm _ ((Submodule.span_singleton_le_iff_mem ..).mpr (mDef_mem A 1))
  apply Submodule.span_le.mpr
  rintro _ ⟨t,u,e,ht,rfl⟩
  have htu : (t.order : ℕ) = (u.order : ℕ) := congrArg PNat.val e
  have inst1 (v : FiniteRootedTree) (hv : (v.order : ℕ) = 1) :
      v = .leaf := by
    simpa only [trees0, List.mem_singleton] using (mem_treesOfOrderSucc 0 v).mpr hv
  have inst2 (v : FiniteRootedTree) (hv : (v.order : ℕ) = 2) :
      v = .leaf ◂ .leaf := by
    simpa only [trees1, List.mem_singleton] using (mem_treesOfOrderSucc 1 v).mpr hv
  have inst3 (v : FiniteRootedTree) (hv : (v.order : ℕ) = 3) :
      v = .leaf ◂ (.leaf ◂ .leaf) ∨ v = (.leaf ◂ .leaf) ◂ .leaf := by
    simpa only [trees2, List.mem_cons, List.not_mem_nil, or_false] using
      (mem_treesOfOrderSucc 2 v).mpr hv
  have split : (t.order : ℕ) = 1 ∨ (t.order : ℕ) = 2 ∨ (t.order : ℕ) = 3 := by
    have := t.order.pos
    omega
  rcases split with n | n | n
  · rw [inst1 t n, inst1 u (htu.symm.trans n), sub_self]
    exact Submodule.zero_mem _
  · rw [inst2 t n, inst2 u (htu.symm.trans n), sub_self]
    exact Submodule.zero_mem _
  · rcases inst3 t n with rfl | rfl <;> rcases inst3 u (htu.symm.trans n) with rfl | rfl
    · rw [sub_self]; exact Submodule.zero_mem _
    · rw [norm_diff_three]
      exact (Submodule.span K {g A}).smul_mem _ (Submodule.mem_span_singleton_self _)
    · rw [← neg_sub, norm_diff_three]
      exact (Submodule.span K {g A}).neg_mem
        ((Submodule.span K {g A}).smul_mem _ (Submodule.mem_span_singleton_self _))
    · rw [sub_self]; exact Submodule.zero_mem _

/-- The real first clean receiver, with its complete leading submatrix and
rescaled physical incoming row, satisfies the reviewed order-two predicate. -/
theorem ConstantAmplitude.receiver_order_two {a d : K} {i j : Fin s}
    (D : ConstantAmplitude A a d i j) (ha : ∀ i j, i ≤ j → A i j = 0) :
    HasOrder 2
      ((nodes A j)⁻¹ • prefixMatrix A j.isLt.le) (fun l : Fin j.val => (nodes A j)⁻¹ * A j (Fin.castLE j.isLt.le l)) := by
  apply exact_receiver_prefix_order ha j 2 (D.node ▸ D.dn)
  intro v hv
  rw [grade_two_span] at hv
  obtain ⟨z,rfl⟩ := Submodule.mem_span_singleton.mp hv
  simp only [Pi.smul_apply, smul_eq_mul, D.clean, mul_zero]

/-- On the retained prefix the grade-three defect space is literally
generated by the restricted quadratic defect. -/
theorem ConstantAmplitude.predecessor_defect_space {a d : K} {i j : Fin s}
    (D : ConstantAmplitude A a d i j) (ha : ∀ i j, i ≤ j → A i j = 0) :
    zeroSpace (prefixMatrix A j.isLt.le) 3 =
      Submodule.span K {g (prefixMatrix A j.isLt.le)} := by
  let hj : j.val ≤ s := j.isLt.le
  have gp : prefixRestrict hj (g A) = g (prefixMatrix A hj) := by
    simpa only [g] using (mDef_prefix ha hj 1).symm
  have hp : prefixRestrict hj (h A) = 0 :=
    (h_prefix ha hj).symm.trans (D.first_h.restricted_profile ha).1
  change zeroSpace (prefixMatrix A hj) 3 = _
  rw [← zeroSpace_prefix ha hj 3, D.span_three, Submodule.map_span, Set.image_insert_eq,
    Set.image_singleton, gp, hp, Submodule.span_insert, Submodule.span_zero_singleton, sup_bot_eq]

end RKResearch.Certified.Graded.OneOff.PaidProof
