variable {K : Type*} [Field K] [CharZero K]

private def det3 (a b c d e f g h i : K) : K :=
  a*(e*i-f*h)-b*(d*i-f*g)+c*(d*h-e*g)

def M0 (g : K) : K := (4620 : K) + (-138600 : K)*g^1 + (1593900 : K)*g^2 + (-8778000 : K)*g^3 + (23409540 : K)*g^4 + (-26195400 : K)*g^5
def M1 (g : K) : K := (3960 : K) + (-115500 : K)*g^1 + (1275120 : K)*g^2 + (-6583500 : K)*g^3 + (15606360 : K)*g^4 + (-13097700 : K)*g^5
def M2 (g : K) : K := (3465 : K) + (-99000 : K)*g^1 + (1062600 : K)*g^2 + (-5266800 : K)*g^3 + (11704770 : K)*g^4 + (-8731800 : K)*g^5
def M3 (g : K) : K := (3080 : K) + (-86625 : K)*g^1 + (910800 : K)*g^2 + (-4389000 : K)*g^3 + (9363816 : K)*g^4 + (-6548850 : K)*g^5
def M4 (g : K) : K := (2772 : K) + (-77000 : K)*g^1 + (796950 : K)*g^2 + (-3762000 : K)*g^3 + (7803180 : K)*g^4 + (-5239080 : K)*g^5
def M5 (g : K) : K := (2520 : K) + (-69300 : K)*g^1 + (708400 : K)*g^2 + (-3291750 : K)*g^3 + (6688440 : K)*g^4 + (-4365900 : K)*g^5

private def D012 (g : K) : K :=
  det3 (M0 g) (M1 g) (M2 g) (M1 g) (M2 g) (M3 g) (M2 g) (M3 g) (M4 g)
private def D013 (g : K) : K :=
  det3 (M0 g) (M1 g) (M2 g) (M1 g) (M2 g) (M3 g) (M3 g) (M4 g) (M5 g)
private def U (g : K) : K := (117040760502073774342147939478508135150626919070300803685760384598614757040079342136356761139888288487305826986401730371888 : K) + (-12686111728947970970619189822912844340340203441182243568770893563571888133537626425816503276627904502216320311843481161672665 : K)*g^1 + (636248161476297340054127366115488185656560569845111232795450393727121909959669770545029301042199416508298812599281078445506136 : K)*g^2 + (-19584307349803660818244759069935179151580281752128192473905368305673743459489524254128600553184161493098924296267268465622134070 : K)*g^3 + (413686388442360284747484718920416569724034115152156298503163944905488605059222833303000249599761528744782014639624547592847289464 : K)*g^4 + (-6349935192813853736828020158242329798448032353382350284338888606752260666484125315054374780316281926314105788955598203942277868530 : K)*g^5 + (73015456234494552644268823792873955920555165248703519109084480504235019403506321629583150436455129940237723502736345050246554289624 : K)*g^6 + (-636819729427083713582323289977982054002480194768004623407685702103262136297886314890947200221827441939409605761794679642085675297080 : K)*g^7 + (4204033654630047835577286003700484206200215280839434114337930945937426351213534966496852327152420522323934396017071021694878613082960 : K)*g^8 + (-20691721075628693901304741307750418300075074772452588911532214577821219956388879982722061261144998793339195275797503079351941877858280 : K)*g^9 + (73804304399763423995460633838228957028437981221719127332154806649481928031493235856604803934387997287113193491467479165271603582115456 : K)*g^10 + (-182359981334428278985416281625869782399459156447535688625436087008001552703057209487041589465951492309176003152119520428256317979656240 : K)*g^11 + (290382612898778277470633369314742928698973902676578957120801725496513947413370209381334819714107519607075829373240096414330877815628800 : K)*g^12 + (-261903887903928699234568857978098932112268619967269948094305921881582832852368409292226808915771953825522771339053883820991838212052000 : K)*g^13 + (98668313160861829368730160926099969316918405562850652860437188923724962568226838957065028368868513747765377105619993363583664788400000 : K)*g^14
private def V (g : K) : K := (-53643681895246266496103162113560852761358034267819843374274080002172779375667210759736832465379883451426933116871753744385 : K) + (5915049779505912387166412648821958690171655994855520173150688335970934134658419991671605862841980030951160819416548125165000 : K)*g^1 + (-302275309546221086896892870235261086448068714967612275116346099255822354345160309093614749902472975169771576673893110701304550 : K)*g^2 + (9497732423637018156403398163230523078390621485346462554661740584133875572419462793480381538657594514759116091482144722838787000 : K)*g^3 + (-205215371251322381102927065841303757558716420164486922356484628869775982011261672522548734230746797970191096001942619386628485634 : K)*g^4 + (3229496892370691118774223841884815247472335250942009135436366968772358234899389808807809623671118066512824342475891989388401359320 : K)*g^5 + (-38159671774131910229225824064266693028369707291914043664968071734445644171739835991389608294479420453458329661889580214704473583288 : K)*g^6 + (342648151358406808037292308499645789523376222949982835183936104356621692419101153197329781299576201131133301382987740471138053680360 : K)*g^7 + (-2331628432540173796245205862911087912054103384330425508417091913093671403243589880839543705946031735079578760193235468663776069930408 : K)*g^8 + (11835362156035286213829585062901235270111979860564497586606527585075873641449043543469544167917224676635176294939684930936734909641680 : K)*g^9 + (-43542056378066366907919208412693039035477395737626025629448391954464471235061118297066234987478108214768940067196965391736259469117616 : K)*g^10 + (110968379456421697850482198233925309303760158002412471851864860386818269015836045525621156160614089500278120718165285299287272797627200 : K)*g^11 + (-182268749084454779233519446727929284558231578406756514619856376295419097383993123641022787018399688301023806272032537758804314240026400 : K)*g^12 + (169564019572273082035327530661009783972766375911795845889589332287127135377686720903858452114217767562594146216016507013205660551720000 : K)*g^13 + (-65778875440574552912486773950733312877945603708567101906958125949149975045484559304710018912579009165176918070413328909055776525600000 : K)*g^14

set_option maxHeartbeats 2500000 in
private theorem bezout (g : K) :
    U g * D012 g + V g * D013 g = (2344143765975545450759646019912866328631310887098950376584407414539212777037920988807268477671627022440193381926666200 : K) := by
  unfold U V D012 D013 det3 M0 M1 M2 M3 M4 M5
  ring

private theorem no_common_zero (g : K) (h1 : D012 g = 0) (h2 : D013 g = 0) : False := by
  have h := bezout g
  rw [h1,h2,mul_zero,mul_zero,add_zero] at h
  exact (by norm_num : (2344143765975545450759646019912866328631310887098950376584407414539212777037920988807268477671627022440193381926666200 : K) ≠ 0) h.symm

private theorem det3_zero_of_kernel (a b c d e f g h i v u : K)
    (h1 : u*b+v*a+c=0) (h2 : u*e+v*d+f=0) (h3 : u*h+v*g+i=0) :
    det3 a b c d e f g h i = 0 := by
  rw [eq_neg_of_add_eq_zero_right h1, eq_neg_of_add_eq_zero_right h2,
    eq_neg_of_add_eq_zero_right h3]
  unfold det3
  ring

/-- The moment of the five manufactured reflected ladder pins, with
all integral degrees interpreted algebraically in characteristic zero. -/
def raw (g : K) (j : ℕ) : K :=
  1 / (((j+5)+1 : ℕ) : K)
  - (25*g)*(1/(((j+4)+1 : ℕ) : K))
  + (230*g^2)*(1/(((j+3)+1 : ℕ) : K))
  - (950*g^3)*(1/(((j+2)+1 : ℕ) : K))
  + (1689*g^4)*(1/(((j+1)+1 : ℕ) : K))
  - (945*g^5)*(1/(((j+0)+1 : ℕ) : K))

private theorem normalize_raw (g : K) :
    27720*raw g 0 = M0 g ∧ 27720*raw g 1 = M1 g ∧ 27720*raw g 2 = M2 g ∧
    27720*raw g 3 = M3 g ∧ 27720*raw g 4 = M4 g ∧ 27720*raw g 5 = M5 g := by
  refine ⟨?_,?_,?_,?_,?_,?_⟩ <;> norm_num [raw,M0,M1,M2,M3,M4,M5] <;> ring

/-- A monic quadratic cannot cancel the ladder hull's first four exact
moments. In particular the required first six moments cannot vanish. -/
theorem no_paid_quadratic (g u v : K)
    (h : ∀ j : ℕ, j ≤ 3 → u*raw g (j+1)+v*raw g j+raw g (j+2)=0) : False := by
  obtain ⟨e0,e1,e2,e3,e4,e5⟩ := normalize_raw g
  have hom (j : ℕ) (hj : j≤3) :
      u*(27720*raw g (j+1))+v*(27720*raw g j)+27720*raw g (j+2)=0 := by
    calc
      _ = 27720*(u*raw g (j+1)+v*raw g j+raw g (j+2)) := by ring
      _ = 0 := by rw [h j hj, mul_zero]
  have z0 := hom 0 (by decide)
  have z1 := hom 1 (by decide)
  have z2 := hom 2 (by decide)
  have z3 := hom 3 (by decide)
  simp only [Nat.reduceAdd,e0,e1,e2,e3,e4,e5] at z0 z1 z2 z3
  exact no_common_zero g (det3_zero_of_kernel _ _ _ _ _ _ _ _ _ v u z0 z1 z2)
    (det3_zero_of_kernel _ _ _ _ _ _ _ _ _ v u z0 z1 z3)

def hull (g z : K) : K := (z-g)*(z-3*g)*(z-5*g)*(z-7*g)*(z-9*g)
def nodes (g a b : K) : Fin 7 → K := ![g,3*g,5*g,7*g,9*g,a,b]

private theorem weightedHull (g a b : K) (w : Fin 7 → K)
    (h : ∀ j : ℕ, j≤12 → (∑ i, w i * (nodes g a b i)^j) = 1/(((j+1 : ℕ)):K))
    (j : ℕ) (hj : j≤5) :
    (∑ i, w i * ((nodes g a b i)^j * hull g (nodes g a b i))) = raw g j := by
  calc
    _ = (∑ i, w i * (nodes g a b i)^(j+5))
        - (25*g)*(∑ i, w i * (nodes g a b i)^(j+4))
        + (230*g^2)*(∑ i, w i * (nodes g a b i)^(j+3))
        - (950*g^3)*(∑ i, w i * (nodes g a b i)^(j+2))
        + (1689*g^4)*(∑ i, w i * (nodes g a b i)^(j+1))
        - (945*g^5)*(∑ i, w i * (nodes g a b i)^(j+0)) := by
      simp only [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro i _
      simp only [hull,pow_add]
      ring
    _ = _ := by
      unfold raw
      rw [h (j+5) (by omega), h (j+4) (by omega), h (j+3) (by omega),
        h (j+2) (by omega), h (j+1) (by omega), h (j+0) (by omega)]

/-- No seven-occurrence degree-twelve quadrature can place its first five
reflected physical nodes at the odd multiples of a common diagonal.
Weights need not be positive; the theorem does not require any distinctness. -/
theorem no_seven_site_ladder (g a b : K) (w : Fin 7 → K)
    (h : ∀ j : ℕ, j ≤ 12 → (∑ i, w i * (nodes g a b i)^j) = 1/(((j+1 : ℕ)):K)) :
    False := by
  apply no_paid_quadratic g (-(a+b)) (a*b)
  intro j hj
  rw [← weightedHull g a b w h (j+1) (by omega),
    ← weightedHull g a b w h j (by omega),
    ← weightedHull g a b w h (j+2) (by omega)]
  calc
    _ = ∑ i, w i * (nodes g a b i)^j * hull g (nodes g a b i) *
      (nodes g a b i-a) * (nodes g a b i-b) := by
      simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro i _
      simp only [pow_add]
      ring
    _ = 0 := by
      apply Finset.sum_eq_zero
      intro i _
      fin_cases i <;> simp [nodes,hull]

#print axioms no_seven_site_ladder
end RKResearch.Certified.FiveLadderThirteen
