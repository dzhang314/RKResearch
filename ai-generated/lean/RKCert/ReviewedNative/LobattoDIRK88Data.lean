def deriv (i : Fin Count) : Vec := (derivativeTable[i.val]?).getD (fun _ => QExpr.zero)

def prodPacked : List (Fin Count) → Vec
  | [] => fun _ => QExpr.const 1
  | i :: is => point (deriv i) (prodPacked is)

def stage (i : Fin Count) : Vec := prodPacked (keys i).children

theorem prodPacked_val {K : Type*} [CommRing K] {s : K} (hs : s^2 = 21)
    (is : List (Fin Count)) :
    VecVal s (prodPacked is) = (is.map (fun i => VecVal s (deriv i))).prod := by
  induction is with
  | nil =>
    funext i
    exact (QExpr.val_const (0:K) s 1).trans Int.cast_one
  | cons i is ih => simp only [prodPacked, point_val hs, ih, List.map_cons, List.prod_cons]

def sumWord (v : Vec) : QExpr := QExpr.dot outerU outerV 8 rawB v

theorem sumWord_val {K : Type*} [CommRing K] {s : K} (hs : s^2 = 21) (v : Vec) :
    (sumWord v).val (0:K) s = VecVal s rawB ⬝ᵥ VecVal s v :=
  QExpr.val_dot _ _ _ _ (rootLaw hs) _ _ _

def innerMod : List ℤ := [0,1]

theorem inner_zero {K : Type*} [CommRing K] : coeval innerMod (0:K) = 0 := by
  simp [innerMod, coeval, horner]

def joinOK (i : Fin Count) : Bool :=
  (List.range (cutoff (8-(keys i).order))).all fun j =>
    decide (keys (joins i (tag j)) = merged (keys i) (keys (tag j)) (tag j))

def derivOK (i : Fin Count) : Bool :=
  QExpr.checkVec innerMod 0 (act (stage i)) (deriv i)

def payOK (i : Fin Count) : Bool :=
  QExpr.eqMod innerMod 0
    ((sumWord (stage i)).scale (.atom [((keys i).order*(keys i).forest:ℕ)]))
    (QExpr.const (weightDen*stageDen^((keys i).order-1)))

end RKResearch.Certified.LobattoDIRK88
