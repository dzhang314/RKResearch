def Vec := Fin 8 → QExpr

def VecVal {K : Type*} [CommRing K] (s : K) (v : Vec) (i : Fin 8) : K :=
  (v i).val 0 s

def numA {K : Type*} [CommRing K] (s : K) : Matrix (Fin 8) (Fin 8) K :=
  Matrix.of fun i j => (rawA i j).val 0 s

def act (v : Vec) : Vec := fun i =>
  match i.val with
  | 0 => QExpr.zero
  | 1 => (mulQ (rawA 1 0) (v 0)).add ((mulQ (rawA 1 1) (v 1)))
  | 2 => (mulQ (rawA 2 1) (v 1))
  | 3 => (mulQ (rawA 3 0) (v 0)).add ((mulQ (rawA 3 1) (v 1)).add ((mulQ (rawA 3 2) (v 2))))
  | 4 => (mulQ (rawA 4 0) (v 0)).add ((mulQ (rawA 4 1) (v 1)).add ((mulQ (rawA 4 2) (v 2)).add ((mulQ (rawA 4 3) (v 3)).add ((mulQ (rawA 4 4) (v 4))))))
  | 5 => (mulQ (rawA 5 0) (v 0)).add ((mulQ (rawA 5 1) (v 1)).add ((mulQ (rawA 5 2) (v 2)).add ((mulQ (rawA 5 3) (v 3)).add ((mulQ (rawA 5 4) (v 4)).add ((mulQ (rawA 5 5) (v 5)))))))
  | 6 => (mulQ (rawA 6 0) (v 0)).add ((mulQ (rawA 6 1) (v 1)).add ((mulQ (rawA 6 2) (v 2)).add ((mulQ (rawA 6 3) (v 3)).add ((mulQ (rawA 6 4) (v 4)).add ((mulQ (rawA 6 5) (v 5)).add ((mulQ (rawA 6 6) (v 6))))))))
  | 7 => (mulQ (rawA 7 0) (v 0)).add ((mulQ (rawA 7 1) (v 1)).add ((mulQ (rawA 7 2) (v 2)).add ((mulQ (rawA 7 3) (v 3)).add ((mulQ (rawA 7 4) (v 4)).add ((mulQ (rawA 7 5) (v 5)).add ((mulQ (rawA 7 6) (v 6))))))))
  | _ => QExpr.zero

theorem act_val {K : Type*} [CommRing K] {s : K} (hs : s^2 = 21) (v : Vec) :
    VecVal s (act v) = numA s *ᵥ VecVal s v := by
  have hm (a b : QExpr) :
      (mulQ a b).val (0:K) s = a.val 0 s * b.val 0 s :=
    QExpr.val_mul _ _ _ _ (rootLaw hs) _ _
  funext i
  fin_cases i <;> simp [act, hm, QExpr.val_add, QExpr.val_zero, numA, rawA, Matrix.mulVec,
    dotProduct, Fin.sum_univ_succ, VecVal, add_assoc]

def point (v w : Vec) : Vec := fun i => mulQ (v i) (w i)

theorem point_val {K : Type*} [CommRing K] {s : K} (hs : s^2 = 21) (v w : Vec) :
    VecVal s (point v w) = VecVal s v * VecVal s w := by
  funext i
  exact QExpr.val_mul _ _ _ _ (rootLaw hs) _ _

