def stageDen : ℤ := 60480
def weightDen : ℤ := 360

def pair (a b : ℤ) : QExpr := QExpr.atom [a] [b]

def outerU : Expr := .atom []
def outerV : Expr := .atom [-21]

def mulQ := QExpr.mul outerU outerV

theorem rootLaw {K : Type*} [CommRing K] {s : K} (hs : s^2 = 21) :
    s^2 = outerU.val (0:K) * s - outerV.val (0:K) := by
  rw [hs]
  norm_num [outerU, outerV, Expr.val, coeval, horner]

