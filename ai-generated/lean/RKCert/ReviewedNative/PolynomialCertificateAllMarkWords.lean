import Mathlib.Tactic.FinCases

@[expose] public section

namespace RKCert.ReviewedNative.PolynomialCertificate.WeakFiveCells

set_option maxRecDepth 48000
set_option maxHeartbeats 16000000

/-- The four chronological labels need not occur in any particular order.
The remaining sites in the sorted tuple are written in their canonical increasing order. -/
def wordOfMarks (u a h z : Fin 8) : PortWord :=
  ⟨(List.finRange 8).filter (fun j => decide (j ≠ u ∧ j ≠ a ∧ j ≠ h ∧ j ≠ z)), u, a, h, z⟩

theorem markWord_roots_iff {u a h z j : Fin 8} :
    j ∈ (wordOfMarks u a h z).roots ↔ j ≠ u ∧ j ≠ a ∧ j ≠ h ∧ j ≠ z := by
  simp [wordOfMarks, List.mem_filter, List.mem_finRange]

theorem markWord_roots_nodup (u a h z : Fin 8) : (wordOfMarks u a h z).roots.Nodup :=
  List.Nodup.filter _ (List.nodup_finRange 8)

