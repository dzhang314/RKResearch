def markGroupAt (j : Fin 70) : List PortWord := allMarkGroups[j.val]?.getD []

theorem markGroupAt_mem (j : Fin 70) : markGroupAt j ∈ allMarkGroups := by
  have hn : j.val < allMarkGroups.length := by simpa only [allMarkGroups_length] using j.isLt
  simpa only [markGroupAt, List.getElem?_eq_getElem hn, Option.getD_some] using
    (List.getElem_mem (l := allMarkGroups) hn)

private theorem labels0_checked : ∀ a h z : Fin 8, ([0, a, h, z] : List (Fin 8)).Nodup →
    (wordOfMarks 0 a h z).roots.length = 4 ∧
    wordOfMarks 0 a h z ∈ markGroupAt (groupIndex 0 a h z) := by decide +kernel

