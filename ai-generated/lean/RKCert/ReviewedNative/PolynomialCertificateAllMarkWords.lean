theorem all_mark_word_spec (u a h z : Fin 8) (d : ([u, a, h, z] : List (Fin 8)).Nodup) :
    (wordOfMarks u a h z).roots.length = 4 ∧ wordOfMarks u a h z ∈ allMarkGroups.flatten := by
  have aux : (wordOfMarks u a h z).roots.length = 4 ∧
      wordOfMarks u a h z ∈ markGroupAt (groupIndex u a h z) := by
    fin_cases u
    · exact labels0_checked a h z d
    · exact labels1_checked a h z d
    · exact labels2_checked a h z d
    · exact labels3_checked a h z d
    · exact labels4_checked a h z d
    · exact labels5_checked a h z d
    · exact labels6_checked a h z d
    · exact labels7_checked a h z d
  exact ⟨aux.1, List.mem_flatten.mpr ⟨_, markGroupAt_mem _, aux.2⟩⟩

