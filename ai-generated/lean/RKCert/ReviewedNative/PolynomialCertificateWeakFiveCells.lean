  lo₁ : ℚ
  hi₁ : ℚ
  lo₂ : ℚ
  hi₂ : ℚ

def CutRow.ok (r : CutRow) : Prop :=
  LaguerreIntervalCut 8 r.lo₀ r.hi₀ r.lo₁ r.hi₁ r.lo₂ r.hi₂

