theorem covers {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
    {s t : K} (hs : s ∈ Set.Icc 0 1) (ht : t ∈ Set.Icc 0 1) :
    ∃ c ∈ cellRows, InDyadicRect c s t := checkDyadicCover_covers accepted hs ht

/-- Bounds for the coefficients of 4*2145*T_y, with no omitted denominator. -/
