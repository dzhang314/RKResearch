private theorem ninth_tall_int :
    bInt ⬝ᵥ Φ (tallTree 9) AInt = ninthTallNumerator := by
  have h1 : Φ (tallTree 1) AInt = (1 : Fin 15 → ℤ) := rfl
  have h2 : Φ (tallTree 2) AInt = tallVec2 := by
    change (1 : Fin 15 → ℤ) * (AInt *ᵥ Φ (tallTree 1) AInt) = tallVec2
    simpa only [one_mul, h1] using tall_step2
  have h3 : Φ (tallTree 3) AInt = tallVec3 := by
    change (1 : Fin 15 → ℤ) * (AInt *ᵥ Φ (tallTree 2) AInt) = tallVec3
    simpa only [one_mul, h2] using tall_step3
  have h4 : Φ (tallTree 4) AInt = tallVec4 := by
    change (1 : Fin 15 → ℤ) * (AInt *ᵥ Φ (tallTree 3) AInt) = tallVec4
    simpa only [one_mul, h3] using tall_step4
  have h5 : Φ (tallTree 5) AInt = tallVec5 := by
    change (1 : Fin 15 → ℤ) * (AInt *ᵥ Φ (tallTree 4) AInt) = tallVec5
    simpa only [one_mul, h4] using tall_step5
  have h6 : Φ (tallTree 6) AInt = tallVec6 := by
    change (1 : Fin 15 → ℤ) * (AInt *ᵥ Φ (tallTree 5) AInt) = tallVec6
    simpa only [one_mul, h5] using tall_step6
  have h7 : Φ (tallTree 7) AInt = tallVec7 := by
    change (1 : Fin 15 → ℤ) * (AInt *ᵥ Φ (tallTree 6) AInt) = tallVec7
    simpa only [one_mul, h6] using tall_step7
  have h8 : Φ (tallTree 8) AInt = tallVec8 := by
    change (1 : Fin 15 → ℤ) * (AInt *ᵥ Φ (tallTree 7) AInt) = tallVec8
    simpa only [one_mul, h7] using tall_step8
  have h9 : Φ (tallTree 9) AInt = tallVec9 := by
    change (1 : Fin 15 → ℤ) * (AInt *ᵥ Φ (tallTree 8) AInt) = tallVec9
    simpa only [one_mul, h8] using tall_step9
  rw [h9] <;> decide +kernel

/-- The exact failure witness is just the next reviewed tall tree. -/
theorem ninth_tall_weight : b ⬝ᵥ Φ (tallTree 9) A = (189383 / 63417876480 : ℚ) := by
  have h := congrArg (Int.castRingHom ℚ) ninth_tall_int
  simp only [RingHom.map_dotProduct, RKResearch.map_Φ, cast_AInt, cast_bInt,
    Φ_matrix_smul, smul_dotProduct, dotProduct_smul, smul_eq_mul, order_tallTree] at h
  have scaled :
      (1540104384000 : ℚ) ^ (8 : ℕ) * ((33075 : ℚ) * (b ⬝ᵥ Φ (tallTree 9) A)) =
        (ninthTallNumerator : ℚ) := by
    first
    | exact h
    | simpa only [mul_assoc, mul_left_comm, mul_comm] using h
  have expected :
      (1540104384000 : ℚ) ^ (8 : ℕ) * ((33075 : ℚ) * (189383 / 63417876480 : ℚ)) =
        (ninthTallNumerator : ℚ) := by
    decide +kernel
  have unscale := mul_left_cancel₀ (by decide +kernel : (1540104384000 : ℚ) ^ (8 : ℕ) ≠ 0)
    (scaled.trans expected.symm)
  exact mul_left_cancel₀ (by decide +kernel : (33075 : ℚ) ≠ 0) unscale

theorem not_order_nine : ¬ HasOrder 9 A b := by
  intro h
  have paid := h (tallTree 9) (by rw [order_tallTree] <;> decide)
  rw [ninth_tall_weight] at paid
  exact (by decide +kernel : ((tallTree 9).factorial : ℚ) * (189383 / 63417876480 : ℚ) ≠ 1) paid

