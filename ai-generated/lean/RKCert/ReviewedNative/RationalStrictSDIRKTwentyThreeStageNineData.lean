def rows : Fin 23 → Row 23 :=
  joinRows (by decide : 11 ≤ 23) coreMultiplier
    RationalStrictSDIRKQ5CompressedCore.normalizedRows suffixRows

def AInt : Matrix (Fin 23) (Fin 23) ℤ :=
  Matrix.of fun i j => entry j (rows i)

def bInt : Fin 23 → ℤ := fun i => entry i weightRow

def actInt (v : Fin 23 → ℤ) : Fin 23 → ℤ :=
  joinAct (by decide : 11 ≤ 23) coreMultiplier
    RationalStrictSDIRKQ5CompressedCore.normalizedRows suffixRows v

def outInt (v : Fin 23 → ℤ) : ℤ := rowAct v weightRow

theorem actInt_eq (v : Fin 23 → ℤ) : actInt v = AInt *ᵥ v := by
  funext i
  change joinAct (by decide : 11 ≤ 23) coreMultiplier
      RationalStrictSDIRKQ5CompressedCore.normalizedRows suffixRows v i =
    (fun j => entry j (rows i)) ⬝ᵥ v
  rw [joinAct_eq_rowAct]
  exact rowAct_eq_dotProduct v (rows i)

theorem outInt_eq (v : Fin 23 → ℤ) : outInt v = bInt ⬝ᵥ v :=
  rowAct_eq_dotProduct v weightRow

def A : Matrix (Fin 23) (Fin 23) ℚ :=
  Matrix.of fun i j => (AInt i j : ℚ) / (stageScale : ℚ)

def b : Fin 23 → ℚ := fun i => (bInt i : ℚ) / (weightScale : ℚ)

theorem stageScale_ne_zero : (stageScale : ℚ) ≠ 0 := by decide +kernel
theorem weightScale_ne_zero : (weightScale : ℚ) ≠ 0 := by decide +kernel

private theorem rows_lower : lowerCheck rows = true := by
  decide +kernel

theorem lowerTriangular : A.IsLowerTriangular := by
  change ∀ i j : Fin 23, i < j → A i j = 0
  intro i j hij
  have hz : AInt i j = 0 := upper_entries_zero_of_check rows rows_lower i j hij
  change (AInt i j : ℚ) / (stageScale : ℚ) = 0
  simp only [hz, Int.cast_zero, zero_div]

private theorem check_diagonal : checkFin (fun i : Fin 23 => decide (AInt i i = diagonalInt)) = true := by
  decide +kernel

theorem common_diagonal (i : Fin 23) : A i i = 1/9 := by
  have hd : AInt i i = diagonalInt := of_decide_eq_true (checkFin_get _ check_diagonal i)
  change (AInt i i : ℚ) / (stageScale : ℚ) = 1/9
  simpa only [hd] using
    (by decide +kernel : (diagonalInt : ℚ) / (stageScale : ℚ) = 1/9)

theorem cast_AInt :
    AInt.map (Int.castRingHom ℚ) = (stageScale : ℚ) • A := by
  funext i j
  change (AInt i j : ℚ) = (stageScale : ℚ) * ((AInt i j : ℚ) / (stageScale : ℚ))
  exact (mul_div_cancel₀ (AInt i j : ℚ) stageScale_ne_zero).symm

theorem cast_bInt :
    (Int.castRingHom ℚ) ∘ bInt = (weightScale : ℚ) • b := by
  funext i
  change (bInt i : ℚ) = (weightScale : ℚ) * ((bInt i : ℚ) / (weightScale : ℚ))
  exact (mul_div_cancel₀ (bInt i : ℚ) weightScale_ne_zero).symm

def paidTree (t : FiniteRootedTree) : Bool :=
  decide ((t.factorial : ℤ) * outInt (replayStage actInt t) =
    weightScale * stageScale ^ ((t.order : ℕ)-1))

end RKResearch.Certified.RationalStrictSDIRKTwentyThreeStageNineUpper
