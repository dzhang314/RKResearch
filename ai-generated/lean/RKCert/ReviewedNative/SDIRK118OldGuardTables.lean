/-- This discharges just the oldGuards field, consuming the separately
established moment determinant sign and no affine or root premise. -/
theorem oldGuards (M : MonomialBasis) (hm : standardPowers M)
    (hD : ∀ s ∈ Set.Icc sLo sHi, ∀ t ∈ Set.Icc tLo tHi, 0 < momentDet M s t) :
    ∀ s ∈ Set.Icc sLo sHi, ∀ t ∈ Set.Icc tLo tHi,
      (∀ i : Fin 4, omegaOld M s t i ≠ 0) ∧ 0 < residualJ0 M s t :=
  oldGuards_of_receipts M hm receipts hD

