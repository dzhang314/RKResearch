/-- Missing donor tap at the first active zero: the three literal
strict moments at two predecessor clocks must satisfy their nodal relation. -/
def earlyCubic {K : Type*} [Field K] (a b x : K) : K :=
  x^3/3-x^2/2-(a+b)*(x^2/2-x/2)+a*b*(x-1/2)

theorem earlyCubic_of_two_taps {K : Type*} [Field K] (a b x p q : K)
    (h0 : p+q=x-1/2) (h1 : a*p+b*q=x^2/2-x/2) (h2 : a^2*p+b^2*q=x^3/3-x^2/2) :
    earlyCubic a b x=0 := by
  unfold earlyCubic
  linear_combination -h2+(a+b)*h1-a*b*h0

def moment {K : Type*} [Field K] (a b x : K) (j : ℕ) : K :=
  1/(j+4 : ℕ)-(a+b+x)/(j+3 : ℕ)+(a*b+a*x+b*x)/(j+2 : ℕ)-a*b*x/(j+1 : ℕ)

def nodeHankel {K : Type*} [Field K] (a b x : K) : K :=
  let m0 := moment a b x 0
  let m1 := moment a b x 1
  let m2 := moment a b x 2
  let m3 := moment a b x 3
  let m4 := moment a b x 4
  m0*m2*m4+2*m1*m2*m3-m0*m3^2-m1^2*m4-m2^3

/-- First two physical zero clocks when the active off-zero clock is 1/2.
Fix the sign at the front by naming the square root t; both rear signs
are included separately. -/
def frontPair {K : Type*} [Field K] (star : Bool) (t : K) : K × K :=
  (1+t, if star then 1-t else 3/2+2*t)

def backPair {K : Type*} [Field K] (star neg : Bool) (t : K) : K × K :=
  let a := frontPair star (if neg then -t else t)
  (1-a.1,1-a.2)

