/-- The literal early cubic and the five-site Hankel test are incompatible
in every half-diagonal front/rear phase, over any characteristic-zero field. -/
theorem noEarlyAndHankel {K : Type*} [Field K] [CharZero K]
    (fs bs neg : Bool) (t x : K) (ht : t^2-1/2=0)
    (hF : earlyCubic (frontPair fs t).1 (frontPair fs t).2 x=0)
    (hH : nodeHankel (backPair bs neg t).1 (backPair bs neg t).2 x=0) : False := by
  cases fs <;> cases bs <;> cases neg
  · exact check000 t x ht hF hH
  · exact check001 t x ht hF hH
  · exact check010 t x ht hF hH
  · exact check011 t x ht hF hH
  · exact check100 t x ht hF hH
  · exact check101 t x ht hF hH
  · exact check110 t x ht hF hH
