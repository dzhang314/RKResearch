/-- Fourth shifted Legendre polynomial, the four-site scalar nodal factor. -/
def gaussFour {K : Type*} [CommRing K] (x : K) : K :=
  70*x^4-140*x^3+90*x^2-20*x+1

theorem gaussFour_midpoint {K : Type*} [Field K] [CharZero K] :
    gaussFour (1/2 : K) ≠ 0 := by
  norm_num [gaussFour]

/-- Integrate the cubic vanishing at the three known strict-feed clocks,
and subtract the literal diagonal contribution. -/
def earlyGaussCubic {K : Type*} [Field K] (g a b x : K) : K :=
  x^4/4-g*x^3-(g+a+b)*(x^3/3-g*x^2)
      +(g*a+g*b+a*b)*(x^2/2-g*x)-g*a*b*(x-g)

theorem earlyGaussCubic_of_taps {K : Type*} [Field K] (g a b x u v w : K)
    (h0 : u+v+w=x-g)
    (h1 : g*u+a*v+b*w=x^2/2-g*x)
    (h2 : g^2*u+a^2*v+b^2*w=x^3/3-g*x^2)
    (h3 : g^3*u+a^3*v+b^3*w=x^4/4-g*x^3) :
    earlyGaussCubic g a b x=0 := by
  unfold earlyGaussCubic
  linear_combination -h3+(g+a+b)*h2-(g*a+g*b+a*b)*h1+g*a*b*h0

