section Cubic

variable {K : Type*} [CommRing K]

/-- Degree-three Sylvester determinant, with columns in descending degree. -/
def res33 (a3 a2 a1 a0 b3 b2 b1 b0 : K) : K :=
    a3^3*b0^3 - a3^2*a2*b1*b0^2 - 2*a3^2*a1*b2*b0^2 + a3^2*a1*b1^2*b0 - 3*a3^2*a0*b3*b0^2
    + 3*a3^2*a0*b2*b1*b0 - a3^2*a0*b1^3 + a3*a2^2*b2*b0^2 + 3*a3*a2*a1*b3*b0^2 - a3*a2*a1*b2*b1*b0
    - a3*a2*a0*b3*b1*b0 - 2*a3*a2*a0*b2^2*b0 + a3*a2*a0*b2*b1^2 - 2*a3*a1^2*b3*b1*b0 + a3*a1^2*b2^2*b0
    + a3*a1*a0*b3*b2*b0 + 2*a3*a1*a0*b3*b1^2 - a3*a1*a0*b2^2*b1 + 3*a3*a0^2*b3^2*b0
    - 3*a3*a0^2*b3*b2*b1 + a3*a0^2*b2^3 - a2^3*b3*b0^2 + a2^2*a1*b3*b1*b0 + 2*a2^2*a0*b3*b2*b0
    - a2^2*a0*b3*b1^2 - a2*a1^2*b3*b2*b0 - 3*a2*a1*a0*b3^2*b0 + a2*a1*a0*b3*b2*b1 + 2*a2*a0^2*b3^2*b1
    - a2*a0^2*b3*b2^2 + a1^3*b3^2*b0 - a1^2*a0*b3^2*b1 + a1*a0^2*b3^2*b2 - a0^3*b3^3

/-- Common-root obstruction for the fixed Sylvester degrees, including
degree-drop specializations. -/
theorem res33_zero_of_common_root (a3 a2 a1 a0 b3 b2 b1 b0 s : K)
    (hP : a3*s^3+a2*s^2+a1*s+a0=0)
    (hQ : b3*s^3+b2*s^2+b1*s+b0=0) :
    res33 a3 a2 a1 a0 b3 b2 b1 b0=0 := by
  unfold res33
  linear_combination
    (a3^2*b3*b2*b0*s^2 - a3^2*b3*b1^2*s^2 + a3^2*b3*b1*b0*s - a3^2*b3*b0^2 + a3^2*b2^2*b0*s
      - a3^2*b2*b1^2*s + 2*a3^2*b2*b1*b0 - a3^2*b1^3 - a3*a2*b3^2*b0*s^2 + a3*a2*b3*b2*b1*s^2
      - 2*a3*a2*b3*b2*b0*s - a3*a2*b3*b1*b0 + a3*a2*b2^2*b1*s - a3*a2*b2^2*b0 + a3*a2*b2*b1^2
      + 2*a3*a1*b3^2*b1*s^2 - a3*a1*b3^2*b0*s - a3*a1*b3*b2^2*s^2 + 2*a3*a1*b3*b2*b1*s
      + 2*a3*a1*b3*b1^2 - a3*a1*b2^3*s - a3*a1*b2^2*b1 - a3*a0*b3^2*b2*s^2 - a3*a0*b3^2*b1*s
      + 2*a3*a0*b3^2*b0 - 3*a3*a0*b3*b2*b1 + a3*a0*b2^3 - a2^2*b3^2*b1*s^2 + a2^2*b3^2*b0*s
      - a2^2*b3*b2*b1*s + a2^2*b3*b2*b0 - a2^2*b3*b1^2 + a2*a1*b3^2*b2*s^2 - a2*a1*b3^2*b0
      + a2*a1*b3*b2^2*s + a2*a1*b3*b2*b1 + a2*a0*b3^3*s^2 + 2*a2*a0*b3^2*b1 - a2*a0*b3*b2^2
      - a1^2*b3^3*s^2 - a1^2*b3^2*b2*s - a1^2*b3^2*b1 + a1*a0*b3^3*s + a1*a0*b3^2*b2 - a0^2*b3^3) * hP +
    (-a3^3*b2*b0*s^2 + a3^3*b1^2*s^2 - a3^3*b1*b0*s + a3^3*b0^2 + a3^2*a2*b3*b0*s^2
      - a3^2*a2*b2*b1*s^2 + a3^2*a2*b1^2*s - a3^2*a2*b1*b0 - 2*a3^2*a1*b3*b1*s^2 + a3^2*a1*b3*b0*s
      + a3^2*a1*b2^2*s^2 - 2*a3^2*a1*b2*b0 + a3^2*a1*b1^2 + a3^2*a0*b3*b2*s^2 + a3^2*a0*b3*b1*s
      - 2*a3^2*a0*b3*b0 - a3^2*a0*b2^2*s + a3^2*a0*b2*b1 + a3*a2^2*b3*b1*s^2 - a3*a2^2*b2*b1*s
      + a3*a2^2*b2*b0 - a3*a2*a1*b3*b2*s^2 - 2*a3*a2*a1*b3*b1*s + 3*a3*a2*a1*b3*b0 + a3*a2*a1*b2^2*s
      - a3*a2*a1*b2*b1 - a3*a2*a0*b3^2*s^2 + 2*a3*a2*a0*b3*b2*s - a3*a2*a0*b2^2 + a3*a1^2*b3^2*s^2
      - 2*a3*a1^2*b3*b1 + a3*a1^2*b2^2 - a3*a1*a0*b3^2*s + a3*a1*a0*b3*b2 + a3*a0^2*b3^2
      + a2^3*b3*b1*s - a2^3*b3*b0 - a2^2*a1*b3*b2*s + a2^2*a1*b3*b1 - a2^2*a0*b3^2*s + a2^2*a0*b3*b2
      + a2*a1^2*b3^2*s - a2*a1^2*b3*b2 - 2*a2*a1*a0*b3^2 + a1^3*b3^2) * hQ

end Cubic

section Endpoint

variable {K : Type*} [CommRing K]

def momentDet (k q : K) : K := -105*k^2*q-15*k^2+175*q^3+255*q^2+105*q+9

def chartA (k q : K) : K :=
  -63*k^4*q+21*k^4-70*k^2*q^3-210*k^2*q^2-138*k^2*q-30*k^2+
    245*q^5+805*q^4+986*q^3+546*q^2+129*q+9

def chartB (k q : K) : K :=
  -525*k^4*q+525*k^4-1750*k^2*q^3-5670*k^2*q^2-3150*k^2*q-630*k^2+
    3675*q^5+13825*q^4+17970*q^3+9990*q^2+2259*q+153

def chartDiagonal (k q g : K) : K := 180*g*chartA k q-chartB k q

def qval (k q y : K) : K := y^2+k*y+q

def secondDen (k q g : K) : K := qval k q (2*g-1)+4*g^2

def secondNum (k q g : K) : K := 2*qval k q (2*g-1)-2*g*(4*g-2+k)

def zeroCubic3 (k q : K) : K := 7*momentDet k q

def zeroCubic2 (k q : K) : K := 105*k^3-315*k*q^2-210*k*q-63*k

def zeroCubic1 (k q : K) : K := 525*k^2*q+63*k^2-735*q^3-1155*q^2-513*q-45

def zeroCubic0 (k q : K) : K := -63*k^3+105*k*q^2+126*k*q+45*k

/-- Integer multiple 7T of the reconstructed monic zero-clock cubic. -/
def zeroCubic (k q y : K) : K :=
  zeroCubic3 k q*y^3+zeroCubic2 k q*y^2+zeroCubic1 k q*y+zeroCubic0 k q

/-- Twelve times the clean endpoint's primitive minus diagonal read. -/
def endpoint (k q g y : K) : K :=
  2*y^3+(3*k-12*g)*y^2+(6*q-12*g*k)*y+2-3*k+6*q-12*g*q

def endpointRes (k q g : K) : K :=
  res33 (zeroCubic3 k q) (zeroCubic2 k q) (zeroCubic1 k q) (zeroCubic0 k q)
    2 (3*k-12*g) (6*q-12*g*k) (2-3*k+6*q-12*g*q)

theorem endpointRes_zero (k q g y : K)
    (hP : zeroCubic k q y=0) (hQ : endpoint k q g y=0) :
    endpointRes k q g=0 := by
  apply res33_zero_of_common_root _ _ _ _ _ _ _ _ y hP
  convert hQ using 1
  unfold endpoint
  ring

private def D11 (g : K) : K :=
    1411200*g^11 - 7173600*g^10 + 15758400*g^9 - 19796000*g^8 + 15414960*g^7 - 7589190*g^6
    + 2385350*g^5 - 478545*g^4 + 60195*g^3 - 4528*g^2 + 183*g - 3

private def H27 (g : K) : K :=
    26022076416000000*g^27 - 351298031616000000*g^26 + 2178884219904000000*g^25
    - 8261033434214400000*g^24 + 21496997973749760000*g^23 - 40883187670133760000*g^22
