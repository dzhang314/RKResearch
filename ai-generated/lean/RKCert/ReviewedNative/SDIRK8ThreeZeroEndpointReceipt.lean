/-- The three centered signed-moment equations (each multiplied by 105)
bind the integer cubic to a monic candidate's physical zero clock. -/
theorem zeroCubic_of_paid_moments {K : Type*} [Field K] [CharZero K]
    (k q d0 d1 d2 y : K)
    (h0 : (35+105*q)*d0+35*k*d1+(21+35*q)*d2+21*k=0)
    (h1 : 35*k*d0+(21+35*q)*d1+21*k*d2+15+21*q=0)
    (h2 : (21+35*q)*d0+21*k*d1+(15+21*q)*d2+15*k=0)
    (hy : y^3+d2*y^2+d1*y+d0=0) : zeroCubic k q y=0 := by
  have h28 : (28:K)≠0 := by norm_num
  have hC0 : (28:K)*(zeroCubic3 k q*d0-zeroCubic0 k q)=0 := by
    unfold zeroCubic3 momentDet zeroCubic0
    linear_combination
      ((21+35*q)*(15+21*q)-(21*k)^2)*h0 +
      ((21+35*q)*(21*k)-(35*k)*(15+21*q))*h1 +
      ((35*k)*(21*k)-(21+35*q)^2)*h2
  have hC1 : (28:K)*(zeroCubic3 k q*d1-zeroCubic1 k q)=0 := by
    unfold zeroCubic3 momentDet zeroCubic1
    linear_combination
      ((21+35*q)*(21*k)-(35*k)*(15+21*q))*h0 +
      ((35+105*q)*(15+21*q)-(21+35*q)^2)*h1 +
      ((21+35*q)*(35*k)-(35+105*q)*(21*k))*h2
  have hC2 : (28:K)*(zeroCubic3 k q*d2-zeroCubic2 k q)=0 := by
    unfold zeroCubic3 momentDet zeroCubic2
    linear_combination
      ((35*k)*(21*k)-(21+35*q)^2)*h0 +
      ((21+35*q)*(35*k)-(35+105*q)*(21*k))*h1 +
      ((35+105*q)*(21+35*q)-(35*k)^2)*h2
  have hE0 := sub_eq_zero.mp ((mul_eq_zero.mp hC0).resolve_left h28)
  have hE1 := sub_eq_zero.mp ((mul_eq_zero.mp hC1).resolve_left h28)
  have hE2 := sub_eq_zero.mp ((mul_eq_zero.mp hC2).resolve_left h28)
  unfold zeroCubic
  rw [← hE0,← hE1,← hE2]
  linear_combination zeroCubic3 k q*hy

/-- No centered scalar chart with zero second-row denominator has its
first physical zero at a paid clock. The reflected case is obtained by
replacing k with -k. No order or topology on the coefficient field is used. -/
theorem no_zero_second_denominator {K : Type*} [Field K] [CharZero K]
    (k q g y : K) (hg : g≠0)
    (hD : secondDen k q g=0) (hU : secondNum k q g=0)
    (hDiag : chartDiagonal k q g=0)
    (hP : zeroCubic k q y=0) (hQ : endpoint k q g y=0) : False := by
  have hR := endpointRes_zero k q g y hP hQ
  have hkl : (2*g)*(k+8*g-2)=0 := by
    simp only [secondDen,secondNum,qval] at hD hU
    linear_combination 2*hD-hU
  have hz : k+8*g-2=0 :=
    (mul_eq_zero.mp hkl).resolve_left (mul_ne_zero (by norm_num) hg)
  have hk : k=2-8*g := by linear_combination hz
  have hq : q=8*g^2-8*g+1 := by
    rw [hk] at hD
    unfold secondDen qval at hD
    linear_combination hD
  rw [hk,hq,chartDiagonal_at] at hDiag
  rw [hk,hq,endpointRes_at] at hR
  have hd : D11 g=0 := (mul_eq_zero.mp hDiag).resolve_left (by norm_num)
  have hh : H27 g=0 := (mul_eq_zero.mp hR).resolve_left (by norm_num)
  have hbez := endpoint_bezout g
  rw [hd,hh,mul_zero,mul_zero,add_zero] at hbez
  exact (show (32716681050851149995329405570700460515120228409804691813855975671751759863968558211707262831126768785408319023:K)≠0 by norm_num) hbez.symm

