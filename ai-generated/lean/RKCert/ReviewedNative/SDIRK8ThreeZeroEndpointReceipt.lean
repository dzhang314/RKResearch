    + 70652400*g^3 - 1879875*g^2 + 31500*g - 250

private theorem chartDiagonal_at (g : K) :
    chartDiagonal (2-8*g) (8*g^2-8*g+1) g = 1024*D11 g := by
  unfold chartDiagonal chartA chartB D11
  ring

