/-- Ascending coefficient arrays over the residue field, used only for
the literal finite Bézout certificates. -/
abbrev P := List Int
def norm (p : P) : P := (p.reverse.dropWhile (· == 0)).reverse
def k (i : Int) : P := norm [i % 43]
def get (p : P) (j : Nat) : Int := p[j]?.getD 0
def pAdd (a b : P) : P :=
  norm ((List.range (max a.length b.length)).map fun i => (get a i + get b i) % 43)
def pScale (a : Int) (b : P) : P := norm (b.map fun v => (a*v)%43)
def pSub (a b : P) : P := pAdd a (pScale (-1) b)
def pMul (a b : P) : P :=
  norm ((List.range (a.length + b.length - 1)).map fun j =>
    (((List.range (j+1)).map fun i => get a i * get b (j-i)).foldl (·+·) 0)%43)
structure Certificate where
  degree : Nat
  f : P
  g : P
  u : P
  v : P

def verify (c : Certificate) : Bool :=
  c.f.length == c.degree+1 && c.g.length == c.degree+1 &&
  pAdd (pMul c.u c.f) (pMul c.v c.g) == [1]

