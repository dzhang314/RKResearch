import Lean

namespace RKResearch.Certified.SDIRK9SixSiteSmallGates

abbrev P := List Int
def norm (p : P) : P := (p.reverse.dropWhile (· == 0)).reverse
def get (p : P) (j : Nat) : Int := p[j]?.getD 0
def pAdd (p : Int) (a b : P) : P :=
  norm ((List.range (max a.length b.length)).map fun i => (get a i + get b i) % p)
def pMul (p : Int) (a b : P) : P :=
  norm ((List.range (a.length + b.length - 1)).map fun j =>
    (((List.range (j+1)).map fun i => get a i * get b (j-i)).foldl (·+·) 0)%p)

structure Certificate where
  modulus : Int
  degree : Nat
  f : P
  g : P
  u : P
  v : P

def validate (C : Certificate) : Bool :=
  C.f.length == C.degree+1 && C.g.length == C.degree+1 &&
  pAdd C.modulus (pMul C.modulus C.u C.f) (pMul C.modulus C.v C.g) == [1]

