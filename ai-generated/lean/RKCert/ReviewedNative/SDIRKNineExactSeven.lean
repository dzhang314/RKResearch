private theorem seventh_phi {R : Type*} [CommRing R] {x y : R} (h : RootPair x y) :
    Φ (bushyTree 7) (numA x y) = VecVal x y f7 := by
  change Φ tree64 (numA x y) * (numA x y *ᵥ Φ tree0 (numA x y)) = _
  rw [phi64 h, phi0 h, act0 h, ← point_val h]
  exact check_vec (d := 24) h (by decide +kernel)

private theorem eighth_phi {R : Type*} [CommRing R] {x y : R} (h : RootPair x y) :
    Φ (bushyTree 8) (numA x y) = VecVal x y f8 := by
  change Φ (bushyTree 7) (numA x y) * (numA x y *ᵥ Φ tree0 (numA x y)) = _
  rw [seventh_phi h, phi0 h, act0 h, ← point_val h]
  exact check_vec (d := 24) h (by decide +kernel)

