private def bushMultiplier : ℤ := 

private def residualCoeff : QExpr :=
  (QExpr.atom bushSmall []).scale (.atom [bushMultiplier])

private theorem checked_bush {R : Type*} [CommRing R] {x y : R} (h : RootPair x y) :
    (8:R) * (VecVal x y rawB ⬝ᵥ Φ (bushyTree 8) (numA x y)) =
      (weightDen:R) * ((stageDen:R)*x)^7 + residualCoeff.val x y := by
  have hc : QExpr.eqMod innerMod 32 ((sumWord f8).scale (.atom [8]))
      ((target 7).add residualCoeff) = true := by decide +kernel
  have hh := QExpr.eqMod_sound hc (y := y) h.inner
  rw [QExpr.val_scale, QExpr.val_add, target_val] at hh
  have h8 : (Expr.atom [8]).val x = 8 := by simp [Expr.val, coeval, horner]
  rw [h8] at hh
  unfold sumWord at hh
  rw [QExpr.val_dot x y outerU outerV h.outer 9 rawB f8] at hh
  rw [eighth_phi h]
  exact hh

private theorem bushSmall_real (x : ℝ) :
    coeval bushSmall x = (bushDen:ℝ) * value bushCoeffs x := by
  norm_num [bushSmall, bushDen, coeval, horner, value,
    RKCert.ReviewedNative.PolynomialBracket.horner, bushCoeffs]
  ring

private theorem residual_nonzero_of_interval {x : ℝ} (y : ℝ)
    (hI : x ∈ Set.Ioo (lo:ℝ) (hi:ℝ)) : residualCoeff.val x y ≠ 0 := by
  rw [residualCoeff, QExpr.val_scale]
  change coeval [bushMultiplier] x * (coeval bushSmall x + y*coeval [] x) ≠ 0
  have h0 : coeval ([] : List ℤ) x = 0 := rfl
  have hm : coeval [bushMultiplier] x = (bushMultiplier:ℝ) := by simp [coeval, horner]
  rw [h0, mul_zero, add_zero, hm, bushSmall_real]
  exact mul_ne_zero (Int.cast_ne_zero.mpr (by decide +kernel))
    (mul_ne_zero (Int.cast_ne_zero.mpr (by decide +kernel)) (reduced_bush_positive hI).ne')

private theorem not_order_eight {K : Type*} [Field K] [CharZero K] {x y : K}
    (hx : x ≠ 0) (h : RootPair x y) (hr : residualCoeff.val x y ≠ 0) :
    ¬ HasOrder (A x y) (b x y) 8 := by
  intro ho
  let d : K := (stageDen:K)*x
  let e : K := weightDen
  have hd : d ≠ 0 := mul_ne_zero (Int.cast_ne_zero.mpr (by decide +kernel)) hx
  have he : e ≠ 0 := Int.cast_ne_zero.mpr (by decide +kernel)
  have hA : d • A x y = numA x y := by
    change d • (d⁻¹ • numA x y) = _
    rw [smul_smul, mul_inv_cancel₀ hd, one_smul]
  have hB : e • b x y = VecVal x y rawB := by
    change e • (e⁻¹ • VecVal x y rawB) = _
    rw [smul_smul, mul_inv_cancel₀ he, one_smul]
  have hb : (8:K) * (b x y ⬝ᵥ Φ (bushyTree 8) (A x y)) = 1 := by
    simpa only [factorial_bushyTree, show ((8 : ℕ+) : ℕ) = 8 from rfl, Nat.cast_ofNat] using
      ho (bushyTree 8) (by rw [order_bushyTree]; decide)
  have hm :
      (8:K) * (VecVal x y rawB ⬝ᵥ Φ (bushyTree 8) (numA x y)) = e*d^7 := by
    rw [← hA, ← hB, Φ_matrix_smul, order_bushyTree, smul_dotProduct, dotProduct_smul]
    change 8 * (e * (d^7 * (b x y ⬝ᵥ Φ (bushyTree 8) (A x y)))) = e*d^7
    calc
      _ = e*d^7 * (8 * (b x y ⬝ᵥ Φ (bushyTree 8) (A x y))) := by ac_rfl
      _ = _ := by rw [hb, mul_one]
  have hz : e*d^7 + residualCoeff.val x y = e*d^7 + 0 :=
    (checked_bush h).symm.trans (hm.trans (add_zero _).symm)
  exact hr (add_left_cancel hz)

theorem not_order_eight_real {x y : ℝ} (hI : x ∈ Set.Ioo (lo:ℝ) (hi:ℝ))
    (h : RootPair x y) : ¬ HasOrder (A x y) (b x y) 8 := by
  have hx : 0 < x := (show 0 < (lo:ℝ) by norm_num [lo]).trans hI.1
  exact not_order_eight hx.ne' h (residual_nonzero_of_interval y hI)

private theorem map_coeval' {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (x : R) (a : List ℤ) : f (coeval a x) = coeval a (f x) := by
  induction a with
  | nil => simp [coeval, horner]
  | cons a as ih => simp only [coeval_cons, map_add, map_mul, map_intCast, ih]

private theorem residual_map {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (x y : R) :
    f (residualCoeff.val x y) = residualCoeff.val (f x) (f y) := by
  unfold residualCoeff
  rw [QExpr.val_scale, QExpr.val_scale]
  change f (coeval [bushMultiplier] x * (coeval bushSmall x + y * coeval [] x)) =
    coeval [bushMultiplier] (f x) * (coeval bushSmall (f x) + f y * coeval [] (f x))
  simp only [map_mul, map_add, map_coeval']

theorem exists_exact_real :
    ∃ (U : Matrix (Fin 9) (Fin 9) ℝ) (w : Fin 9 → ℝ) (γ : ℝ),
      U.IsLowerTriangular ∧ (∀ i, U i i = γ) ∧ γ ≠ 0 ∧
        HasOrder U w 7 ∧ ¬ HasOrder U w 8 := by
  obtain ⟨x, v, w, hI, hx, hp, -, -, -, -, hs, hm⟩ := exists_real_parameters
  let y : ℝ := (shapeDen:ℝ)*v
  have hr : RootPair x y := realRootPair_of_parameters hp hs hm
  exact ⟨A x y, b x y, 4/x, lowerTriangular x y, diagonal hx.ne',
    div_ne_zero (by norm_num) hx.ne', order_seven hx.ne' hr, not_order_eight_real hI hr⟩

local notation "ℝₐ" => (algebraicClosure ℚ ℝ : Type)

theorem exists_exact_realAlgebraic :
    ∃ (U : Matrix (Fin 9) (Fin 9) ℝₐ) (w : Fin 9 → ℝₐ) (γ : ℝₐ),
      U.IsLowerTriangular ∧ (∀ i, U i i = γ) ∧ γ ≠ 0 ∧
        HasOrder U w 7 ∧ ¬ HasOrder U w 8 := by
  obtain ⟨x, v, w, hI, hx, hp, hax, hav, -, -, -, -, hs, hm⟩ :=
    exists_algebraic_parameters
  let xx : ℝₐ := ⟨x, mem_algebraicClosure_iff.mpr hax⟩
  let vv : ℝₐ := ⟨v, mem_algebraicClosure_iff.mpr hav⟩
  let yy : ℝₐ := (shapeDen:ℝₐ)*vv
  let f := algebraMap ℝₐ ℝ
  have hxx : xx ≠ 0 := by
    intro h
    have heq : f xx = f 0 := congrArg f h
    rw [map_zero] at heq
    exact hx.ne' heq
  have hr : RootPair xx yy := (rootPair_iff_map f f.injective).mpr (by
    rw [show yy = (shapeDen:ℝₐ)*vv from rfl, map_mul, map_intCast]
    exact realRootPair_of_parameters hp hs hm)
  have hnz : residualCoeff.val xx yy ≠ 0 := by
    intro hz
    have he := congrArg f hz
    rw [map_zero, residual_map] at he
    exact residual_nonzero_of_interval (f yy) hI he
  exact ⟨A xx yy, b xx yy, 4/xx, lowerTriangular xx yy, diagonal hxx,
    div_ne_zero (by norm_num) hxx, order_seven hxx hr, not_order_eight hxx hr hnz⟩

