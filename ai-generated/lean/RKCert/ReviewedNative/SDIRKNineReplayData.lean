/-- Values are interpreted only when both root relations hold. -/
structure RootPair {R : Type*} [CommRing R] (x y : R) : Prop where
  inner : coeval innerMod x = 0
  outer : y^2 = outerU.val x * y - outerV.val x

def Vec := Fin 9 → QExpr

def VecVal {R : Type*} [CommRing R] (x y : R) (v : Vec) : Fin 9 → R :=
  QExpr.val x y ∘ v

def numA {R : Type*} [CommRing R] (x y : R) : Matrix (Fin 9) (Fin 9) R :=
  Matrix.of fun i j => (rawA i j).val x y

def act (v : Vec) : Vec := fun i => QExpr.dot outerU outerV 9 (rawA i) v

def point (v w : Vec) : Vec := fun i => QExpr.mul outerU outerV (v i) (w i)

theorem act_val {R : Type*} [CommRing R] {x y : R} (h : RootPair x y) (v : Vec) :
    VecVal x y (act v) = numA x y *ᵥ VecVal x y v := by
  funext i
  exact QExpr.val_dot x y outerU outerV h.outer 9 (rawA i) v

theorem point_val {R : Type*} [CommRing R] {x y : R} (h : RootPair x y) (v w : Vec) :
    VecVal x y (point v w) = VecVal x y v * VecVal x y w := by
  funext i
  exact QExpr.val_mul x y outerU outerV h.outer (v i) (w i)

theorem check_vec {R : Type*} [CommRing R] {x y : R} (h : RootPair x y) {v w : Vec}
    {d : ℕ} (hc : QExpr.checkVec innerMod d v w = true) :
    VecVal x y v = VecVal x y w :=
  QExpr.checkVec_sound hc h.inner

def target (n : ℕ) : QExpr := QExpr.atom (List.replicate n 0 ++ [weightDen*stageDen^n]) []

private theorem varPower {R : Type*} [CommRing R] (x : R) (n : ℕ) (z : ℤ) :
    coeval (List.replicate n 0 ++ [z]) x = x^n*(z:R) := by
  induction n with
  | zero => simp [coeval,horner]
  | succ n ih =>
    simp only [List.replicate_succ,List.cons_append,coeval_cons,Int.cast_zero,zero_add,ih,
      pow_succ',mul_assoc]

theorem target_val {R : Type*} [CommRing R] (x y : R) (n : ℕ) :
    (target n).val x y = (weightDen:R) * ((stageDen:R)*x)^n := by
  simp only [target,QExpr.atom,QExpr.val,Expr.val,varPower,
    show coeval ([] : List ℤ) x=0 from rfl,mul_zero,add_zero,Int.cast_mul,Int.cast_pow,mul_pow]
  ac_rfl

def sumWord (v : Vec) : QExpr := QExpr.dot outerU outerV 9 rawB v

def paidCheck (t : FiniteRootedTree) (v : Vec) : Bool :=
  QExpr.eqMod innerMod 48
    ((sumWord v).scale (.atom [(t.factorial:ℤ)])) (target ((t.order:ℕ)-1))

theorem checked_weight {R : Type*} [CommRing R] {x y : R} (h : RootPair x y)
    {t : FiniteRootedTree} {v : Vec}
    (hv : Φ t (numA x y) = VecVal x y v)
    (hc : paidCheck t v = true) :
    (t.factorial:R) * ((VecVal x y rawB) ⬝ᵥ Φ t (numA x y)) =
      (weightDen:R) * ((stageDen:R)*x)^((t.order:ℕ)-1) := by
  have hk := QExpr.eqMod_sound hc (y := y) h.inner
  rw [target_val,QExpr.val_scale] at hk
  change coeval [(t.factorial:ℤ)] x * (sumWord v).val x y = _ at hk
  have hNat : coeval [(t.factorial:ℤ)] x = (t.factorial:R) := by
    simp [coeval,horner]
  rw [hNat] at hk
  rw [hv]
  unfold sumWord at hk
  rw [QExpr.val_dot x y outerU outerV h.outer 9 rawB v] at hk
  exact hk

