theorem pay69 {R : Type*} [CommRing R] {x y : R} (h : RootPair x y) : Paid x y tree69 := by
  refine checked_weight h (t := tree69) (v := point v0 v40) ?_ (by decide +kernel)
  change Φ tree0 (numA x y) * (numA x y *ᵥ Φ tree27 (numA x y)) = _
  rw [phi0 h, phi27 h, act20 h, point_val h]

