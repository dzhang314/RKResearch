module

public import RKCert.ReviewedNative.AlgebraicOrderCheck
public import Mathlib.LinearAlgebra.Matrix.Block
public import Mathlib.LinearAlgebra.Matrix.Notation
public import Mathlib.Tactic.FinCases
public import Mathlib.Tactic.IntervalCases
public import Mathlib.Tactic.LinearCombination

public section

/-!
# Classical two- and three-stage SDIRKs

The Nørsett–Crouzeix order-three and Crouzeix order-four tableaux use
`x = 2γ - 1`. Their defining relations are `x² = 1/3` and
`x³ - x = 1/3`, respectively. Positive order is certified by explicit
polynomial cofactors for **every** tree generated by the native finite
enumerator. No stability or field-order hypothesis enters those proofs.
-/

namespace RKResearch.Certified
open FiniteRootedTree
open scoped Matrix

variable {K : Type*} [Field K]

/-- The common diagonal, shared by the two published tableaux. -/
def smallSDIRKGamma (x : K) : K := (1 + x)/2

namespace NorsettCrouzeix23

def A (x : K) : Matrix (Fin 2) (Fin 2) K :=
  !![smallSDIRKGamma x, 0; -x, smallSDIRKGamma x]

def b : Fin 2 → K := ![1/2, 1/2]

theorem lowerTriangular (x : K) : (A x).IsLowerTriangular := by
  intro i j h
  change i.val < j.val at h
  fin_cases i <;> fin_cases j <;> first | rfl | norm_num at h

theorem diagonal (x : K) (i : Fin 2) : A x i i = smallSDIRKGamma x := by
  fin_cases i <;> rfl

variable [CharZero K]

theorem diagonal_ne_zero {x : K} (hx : x^2 - 1/3 = 0) : smallSDIRKGamma x ≠ 0 := by
  intro h
  have heq : x = -1 := by
    unfold smallSDIRKGamma at h
    linear_combination 2*h
  rw [heq] at hx
  norm_num at hx

private theorem residual_dvd (x : K) (n : ℕ) (hn : n < 3) (t : FiniteRootedTree)
    (ht : t ∈ treesOfOrderSucc n) :
    (x^2-1/3) ∣ (t.factorial : K) * (b ⬝ᵥ Φ t (A x)) - 1 := by
  interval_cases n <;> simp [treesOfOrderSucc, List.finRange_succ] at ht
  · subst t
    use 0
    norm_num [b, dotProduct, Fin.sum_univ_two]
  · subst t
    use 0
    simp [A, b, smallSDIRKGamma, dotProduct, Fin.sum_univ_two]
    ring
  · rcases ht with rfl | rfl
    · use -3/2
      simp [A, b, smallSDIRKGamma, dotProduct, Fin.sum_univ_two]
      ring
    · use 3/4
      simp [A, b, smallSDIRKGamma, dotProduct, Fin.sum_univ_two]
      ring

theorem order_three {x : K} (hx : x^2 - 1/3 = 0) : HasOrder (A x) b 3 :=
  hasOrder_of_finite_residual_dvd _ _ _ hx (residual_dvd x)

/-- The order-four chain is a concrete failure. -/
theorem fourth_chain_scaled {x : K} (hx : x^2 - 1/3 = 0) :
    ((tallTree 4).factorial : K) * (b ⬝ᵥ Φ (tallTree 4) (A x)) = -2*x := by
  rw [show tallTree 4 = leaf ◂ (leaf ◂ (leaf ◂ leaf)) from rfl]
  simp [A, b, smallSDIRKGamma, dotProduct, Fin.sum_univ_two]
  linear_combination (-6*x-9)*hx

theorem not_order_four {x : K} (hx : x^2 - 1/3 = 0) : ¬ HasOrder (A x) b 4 := by
  intro h
  have ht := h (tallTree 4) (by rw [order_tallTree]; decide)
  rw [fourth_chain_scaled hx] at ht
  have heq : x = -1/2 := by linear_combination (-1/2)*ht
  rw [heq] at hx
  norm_num at hx

end NorsettCrouzeix23

namespace Crouzeix34

def A (x : K) : Matrix (Fin 3) (Fin 3) K :=
  !![smallSDIRKGamma x, 0, 0; -x/2, smallSDIRKGamma x, 0; 1+x, -1-2*x, smallSDIRKGamma x]

/-- The published outer weight `1/(6x²)` in polynomial form modulo the cubic. -/
def outerWeight (x : K) : K := (3-3*x^2+x)/2

def b (x : K) : Fin 3 → K := ![outerWeight x, 1-2*outerWeight x, outerWeight x]

theorem lowerTriangular (x : K) : (A x).IsLowerTriangular := by
  intro i j h
  change i.val < j.val at h
  fin_cases i <;> fin_cases j <;> first | rfl | norm_num at h

theorem diagonal (x : K) (i : Fin 3) : A x i i = smallSDIRKGamma x := by
  fin_cases i <;> rfl

variable [CharZero K]

theorem outerWeight_eq_fraction {x : K} (hx : x^3 - x - 1/3 = 0) :
    outerWeight x = 1/(6*x^2) := by
  have hx0 : x ≠ 0 := by
    intro h
    rw [h] at hx
    norm_num at hx
  have hd : 6*x^2 ≠ 0 := mul_ne_zero (by norm_num) (pow_ne_zero _ hx0)
  apply (eq_div_iff hd).2
  unfold outerWeight
  linear_combination (-9*x+3)*hx

theorem diagonal_ne_zero {x : K} (hx : x^3 - x - 1/3 = 0) : smallSDIRKGamma x ≠ 0 := by
  intro h
  have heq : x = -1 := by
    unfold smallSDIRKGamma at h
    linear_combination 2*h
  rw [heq] at hx
  norm_num at hx

private theorem residual_dvd (x : K) (n : ℕ) (hn : n < 4) (t : FiniteRootedTree)
    (ht : t ∈ treesOfOrderSucc n) :
    (x^3-x-1/3) ∣ (t.factorial : K) * (b x ⬝ᵥ Φ t (A x)) - 1 := by
  interval_cases n <;> simp [treesOfOrderSucc, List.finRange_succ] at ht
  · subst t
    use 0
    simp [b, outerWeight, dotProduct, Fin.sum_univ_three]
    ring
  · subst t
    use 0
    simp [A, b, smallSDIRKGamma, outerWeight, dotProduct, Fin.sum_univ_three]
    ring
  · rcases ht with rfl | rfl
    · use -9*x-3/2
      simp [A, b, smallSDIRKGamma, outerWeight, dotProduct, Fin.sum_univ_three]
      ring
    · use 3/4-9*x/4
      simp [A, b, smallSDIRKGamma, outerWeight, dotProduct, Fin.sum_univ_three]
      ring
  · rcases ht with rfl | rfl | rfl | rfl | rfl
    · use -54*x^2-63*x-6
      simp [A, b, smallSDIRKGamma, outerWeight, dotProduct, Fin.sum_univ_three]
      ring
    · use -27*x^2/2-45*x/2-3/2
      simp [A, b, smallSDIRKGamma, outerWeight, dotProduct, Fin.sum_univ_three]
      ring
    · use -9*x
      simp [A, b, smallSDIRKGamma, outerWeight, dotProduct, Fin.sum_univ_three]
      ring
    · use -9*x
      simp [A, b, smallSDIRKGamma, outerWeight, dotProduct, Fin.sum_univ_three]
      ring
    · use 3/2-9*x/2
      simp [A, b, smallSDIRKGamma, outerWeight, dotProduct, Fin.sum_univ_three]
      ring

theorem order_four {x : K} (hx : x^3 - x - 1/3 = 0) : HasOrder (A x) (b x) 4 :=
  hasOrder_of_finite_residual_dvd _ _ _ hx (residual_dvd x)

/-- The order-five bush gives an exact closed expression at any root of the cubic. -/
theorem fifth_bush_scaled {x : K} (hx : x^3 - x - 1/3 = 0) :
    ((bushyTree 5).factorial : K) * (b x ⬝ᵥ Φ (bushyTree 5) (A x)) =
      5*x^2/48 + 15/16 := by
  rw [factorial_bushyTree, Φ_bushyTree]
  simp [A, b, smallSDIRKGamma, outerWeight, dotProduct, Fin.sum_univ_three]
  linear_combination (-15*x^3/16+5*x^2/16-45*x/8+15/8)*hx

theorem not_order_five {x : K} (hx : x^3 - x - 1/3 = 0) : ¬ HasOrder (A x) (b x) 5 := by
  intro h
  have ht := h (bushyTree 5) (by rw [order_bushyTree]; decide)
  rw [fifth_bush_scaled hx] at ht
  have hs : x^2 = 3/5 := by linear_combination (48/5)*ht
  have hc : x^3 = x * x^2 := by ring
  rw [hc, hs] at hx
  have heq : x = -5/6 := by linear_combination (-5/2)*hx
  rw [heq] at hs
  norm_num at hs

end Crouzeix34
end RKResearch.Certified
