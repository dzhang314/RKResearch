def literalStripPackets : List StripRowPacket := literalPacketGroups.flatten
def threeInteriorLiteralRows : List ThreeInteriorCell := literalStripPackets.map StripRowPacket.row
def threeInteriorLiteralRects : List DyadicRect := literalStripPackets.map rawStripRect

theorem literalRect_projection :
    threeInteriorLiteralRows.map ThreeInteriorCell.rect = threeInteriorLiteralRects := by
  simp only [threeInteriorLiteralRows, threeInteriorLiteralRects, List.map_map] <;> rfl

/-! Proof-only concatenation on the original list of packet groups. -/
private theorem stripPacketJoinCons (test : StripRowPacket → Bool)
    {part : List StripRowPacket} {tail : List (List StripRowPacket)}
    (ok : part.all test = true) (rest : tail.flatten.all test = true) :
    (part :: tail).flatten.all test = true := by
  simp only [List.flatten_cons, List.all_append, ok, rest, Bool.true_and]

private theorem stripPacketJoinNil (test : StripRowPacket → Bool) :
    ([] : List (List StripRowPacket)).flatten.all test = true := by
  simp only [List.flatten_nil, List.all_nil]

