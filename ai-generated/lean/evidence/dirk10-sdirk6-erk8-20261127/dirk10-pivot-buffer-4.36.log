RKResearch.Certified.Graded.CrossedOrderTen.crossed_zero_sites_buffer.{u_1} {K : Type u_1} [Field K]
  {A : Matrix (Fin 11) (Fin 11) K} {b : Fin 11 → K} (ha : A.IsLowerTriangular) (ho : RKResearch.HasOrder 10 A b) :
  ∃ i j, 0 < i ∧ ↑i + 2 ≤ ↑j ∧ j < Fin.last 10 ∧ A 0 0 = 0 ∧ A i i = 0 ∧ A j j = 0 ∧ A (Fin.last 10) (Fin.last 10) = 0
RKResearch.Certified.Graded.CrossedOrderTen.crossed_nonunit_sites_buffer.{u_2} {R : Type u_2} [CommRing R]
  [Nontrivial R] {D : Matrix (Fin 11) (Fin 11) R} {w : Fin 11 → R} (ha : D.IsLowerTriangular)
  (ho : RKResearch.HasOrder 10 D w) :
  ∃ i j,
    0 < i ∧
      ↑i + 2 ≤ ↑j ∧
        j < Fin.last 10 ∧ ¬IsUnit (D 0 0) ∧ ¬IsUnit (D i i) ∧ ¬IsUnit (D j j) ∧ ¬IsUnit (D (Fin.last 10) (Fin.last 10))
