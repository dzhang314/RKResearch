RKResearch.Certified.Graded.CrossedOrderTen.crossed_zero_sites.{u_1} {K : Type u_1} [Field K]
  {A : Matrix (Fin 11) (Fin 11) K} {b : Fin 11 → K} (ha : A.IsLowerTriangular) (ho : RKResearch.HasOrder 10 A b) :
  ∃ i j, 0 < i ∧ i < j ∧ j < Fin.last 10 ∧ A 0 0 = 0 ∧ A i i = 0 ∧ A j j = 0 ∧ A (Fin.last 10) (Fin.last 10) = 0
