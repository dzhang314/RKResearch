RKResearch.Certified.Graded.CrossedCubicChronology.adjacent_tap_and_clock {K : Type} [Lean.Grind.Field K]
  (A : ℕ → ℕ → K) (c l v : ℕ → K) (n i : ℕ) (paid : i + 1 < n) (hd : A i i = 0) (hr : A (i + 1) (i + 1) = 0)
  (left : ∀ (j : ℕ), i + 1 < j → j < n → l j = 0) (right : ∀ j < i, v j = 0) (live : v i ≠ 0)
  (kernel : VolterraZeroBridge.vol A c v (i + 1) = 0) (mu : ℕ → K) (pay : ∀ t < 10, OfNat.ofNat (t + 1) * mu t = 1)
  (a b d h f g : K) (front : a ≠ 0 ∨ b ≠ 0 ∨ d ≠ 0) (back : h ≠ 0 ∨ f ≠ 0 ∨ g ≠ 0)
  (P : CrossedCubicChronology.PaidReads A c l v n a b d (CrossedCubicPivot.moment mu h f g)) :
  A (i + 1) i ≠ 0 ∧ c (i + 1) = c i
