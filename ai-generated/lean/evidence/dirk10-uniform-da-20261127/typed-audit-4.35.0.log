RKResearch.Certified.Graded.PaidDAField.shift_cancel {K : Type} [Lean.Grind.Field K] (u v k : K) (hu : u ≠ 0)
  (hv : v - u ≠ 0) :
  have d := k / (u * (v - u));
  d * u = k / (v - u) ∧
    d * u ^ 2 - k * v / (v - u) = -k ∧ d * u ^ 3 - k * v ^ 2 / (v - u) + (v - u / 2) * k = -(u + u / 2) * k
