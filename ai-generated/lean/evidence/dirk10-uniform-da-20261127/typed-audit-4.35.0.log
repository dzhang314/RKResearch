RKResearch.Certified.Graded.PaidDAField.tapThree {K : Type} [Lean.Grind.Field K] (u v w a b c S T R : K) (hu : u ≠ 0)
  (hv : u - v ≠ 0) (hw : u - w ≠ 0) (hS : a * u + b * v + c * w = S) (hT : a * u ^ 2 + b * v ^ 2 + c * w ^ 2 = T)
