RKResearch.ERK11CleanJacobiGate.independentFour {K : Type} [Lean.Grind.Field K] (k a b c d : K) (g : 1 - k ≠ 0)
  (at0 : c = 0) (at1 : -a - k * c + d = 0) (at2 : a - b - k * d = 0) (at3 : b = 0) : a = 0 ∧ b = 0 ∧ c = 0 ∧ d = 0
RKResearch.ERK11CleanJacobiGate.paidBezout {K : Type} [Lean.Grind.Field K] (k z : K) :
  k * k * (z * (z - 1)) + (k * z + 1 - k) * (1 - k * z) = 1 - k
