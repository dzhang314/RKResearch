RKResearch.Certified.GroupedTerminalRefund.refund_rank.{u_1, u_2, u_3, u_4} {K : Type u_1} {X : Type u_2} {H : Type u_3}
  {Z : Type u_4} [Field K] [AddCommGroup X] [Module K X] [AddCommGroup H] [Module K H] [AddCommGroup Z] [Module K Z]
  [FiniteDimensional K X] [FiniteDimensional K Z] [FiniteDimensional K H] {F : H →ₗ[K] X} (hF : Function.Injective ⇑F)
  (T : Module.Dual K X →ₗ[K] Z) :
  Module.finrank K Z ≤ Module.finrank K ↥(refunded F T) + (Module.finrank K X - Module.finrank K H)
RKResearch.Certified.GroupedTerminalRefund.refunded_word_steps.{u_1, u_2, u_3, u_4, u_5, u_6} {K : Type u_1}
  {X : Type u_2} {H : Type u_3} {Z : Type u_4} {Y : Type u_5} {V : Type u_6} [Field K] [AddCommGroup X] [Module K X]
  [AddCommGroup H] [Module K H] [AddCommGroup Z] [Module K Z] [AddCommGroup Y] [Module K Y] [AddCommGroup V]
  [Module K V] (F : H →ₗ[K] X) (T : Module.Dual K X →ₗ[K] Z) (A C : V →ₗ[K] V) (M : V →ₗ[K] Z) (a : Y →ₗ[K] V)
  (idealA idealC : Y →ₗ[K] Z) (err : Y →ₗ[K] Module.Dual K X) (hpair : ∀ (w : Y), F.dualMap (err w) = 0)
  (hA : ∀ (w : Y), M (A (a w)) - idealA w = T (err w)) (hC : ∀ (w : Y), M (C (a w)) = idealC w) (l : ↥(refunded F T))
  (w : Y) : ↑l (M (A (a w))) = ↑l (idealA w) ∧ ↑l (M (C (a w))) = ↑l (idealC w)
RKResearch.Certified.GroupedTerminalRefund.four_block_floor.{u_1, u_2, u_6, u_7, u_8, u_9, u_10, u_11, u_12}
