RKCert.ReviewedNative.SDIRK8HalfQuadraticReceipts.sixPeggedHankel.{u_1} {R : Type u_1} [CommRing R] (x w : Fin 6 → R)
  (a b wa wb : R) :
  have P := fun y => ∏ i, (y - x i);
  have m := fun j => ∑ i, w i * P (x i) * x i ^ j + wa * P a * a ^ j + wb * P b * b ^ j;
  RKCert.ReviewedNative.SDIRK8HalfQuadraticReceipts.hankel3 (m 0) (m 1) (m 2) (m 3) (m 4) = 0
'RKCert.ReviewedNative.SDIRK8HalfQuadraticReceipts.sixPeggedHankel' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
