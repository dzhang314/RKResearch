RKCert.Paired.exists_causal_coord_family.{u_1} {K : Type u_1} [Field K] {s : ℕ} (H : Submodule K (Vec K s)) :
  ∃ n e w,
    (∀ (i : Fin s) (j : Fin n), i < e j → w i j = 0) ∧
      (∀ v ∈ H, ∀ (i : Fin s), ∑ j, w i j * v (e j) = v i) ∧ ∀ (i : Fin n), IsCoordPivot H (e i)
RKCert.Paired.exact_receiver_prefix_order.{u_1} {K : Type u_1} [Field K] {s : ℕ} {A : Fin s → Fin s → K}
  (ha : StrictLower A) (q : ℕ) (i : Fin s) (hu : nodes A i ≠ 0) (hi : ∀ v ∈ zeroSpace A q, v i = 0) :
  HasTreeOrderAtLeast (scaleTableau (nodes A i)⁻¹ (prefixTableau A ⋯)) (fun j => (nodes A i)⁻¹ * A i (Fin.castLE ⋯ j)) q
RKCert.Paired.invariant_forces_two_forward.{u_1} {K : Type u_1} [Field K] [CharZero K] {s : ℕ} {A : Fin s → Fin s → K}
  {j : ℕ} (ha : StrictLower A) (hj : 3 ≤ j) (hsep : Separated A j)
  (hC : ∀ v ∈ zeroSpace A j, (diag (nodes A)) v ∈ zeroSpace A j) :
  Module.finrank K ↥(zeroSpace A j) + 2 ≤ Module.finrank K ↥(zeroSpace A (j + 1))
RKCert.Paired.no_minimal_five_independent.{u_1} {K : Type u_1} [Field K] [CharZero K] {s : ℕ} {A : Fin s → Fin s → K}
  (ha : StrictLower A) (hsep : Separated A 5) (hR : Module.finrank K ↥(zeroSpace A 5) ≤ 4)
  (hrows : ∀ (i j : Fin s), i < j → ∃ t, t.order ≤ 6 ∧ stageWeight A t i ≠ stageWeight A t j)
  (hind : signal A (qdef A) 1 ∉ K ∙ qdef A) : False
RKCert.Paired.CaseII.compressed_caseII_impossible.{u_1} {K : Type u_1} [Field K] [CharZero K] {n : ℕ}
  {A : Fin n → Fin n → K} (ha : StrictLower A) (hn : 5 ≤ n) (h1 : nodes A (Fin.castLE hn 1) = 1)
  (hs : ∀ (i : Fin n), qdef A i = 0 ∨ nodes A i = 1 ∧ qdef A i = -(1 / 2))
  (h3 : zeroSpace A 3 = K ∙ qdef A ⊔ chainSpan A ((mat A) (qdef A)) 0)
  (h4 : zeroSpace A 4 = K ∙ qdef A ⊔ chainSpan A ((mat A) (qdef A)) 1)
  (h5 : zeroSpace A 5 = K ∙ qdef A ⊔ chainSpan A ((mat A) (qdef A)) 2)
  (hrows : ∀ (i j : Fin n), i < j → ∃ t, t.order ≤ 6 ∧ stageWeight A t i ≠ stageWeight A t j) : False
RKCert.Paired.grade_five_surplus.{u_1} {K : Type u_1} [Field K] [CharZero K] {s : ℕ} {A : Fin s → Fin s → K}
  (ha : StrictLower A) (hsep : Separated A 5) : 5 ≤ Module.finrank K ↥(zeroSpace A 5)
