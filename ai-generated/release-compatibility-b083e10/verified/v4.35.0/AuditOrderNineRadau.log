RKCert.Paired.order9_five_on_off_stage_five_split.{u_1} {K : Type u_1} [Field K] [CharZero K] {A : Fin 12 → Fin 12 → K}
  {b : RKCert.Paired.Vec K 12} (ha : RKCert.StrictLower A) (ho : RKCert.HasTreeOrderAtLeast A b 9)
  (hN : (RKCert.Paired.supportedNodes A (RKCert.Paired.qdef A)).card = 5) (hM : (RKCert.Paired.onNodes A).card = 5) :
