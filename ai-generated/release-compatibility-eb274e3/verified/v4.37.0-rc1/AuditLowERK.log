RKCert.Paired.order8_ten_stage_chart.{u_1} {K : Type u_1} [Field K] [CharZero K] {A : Fin 10 → Fin 10 → K}
  {b : RKCert.Paired.Vec K 10} (ha : RKCert.StrictLower A) (ho : RKCert.HasTreeOrderAtLeast A b 8) :
  b (Fin.last 9) ≠ 0 ∧
    RKCert.Paired.backSeed1 A b = 0 ∧
      RKCert.nodes A (Fin.last 9) = 1 ∧
        Pi.single (Fin.last 9) 1 ∈ RKCert.Paired.treeSpace A 4 ∧
          Pi.single (Fin.last 9) 1 ∉ RKCert.Paired.treeSpace A 3 ∧
            Module.finrank K ↥(RKCert.Paired.zeroSpace A 3) = 2 ∧
              Module.finrank K ↥(RKCert.Paired.zeroSpace A 4) = 3 ∧
                Module.finrank K ↥(RKCert.Paired.treeSpace A 3) = 6 ∧
                  Module.finrank K ↥(RKCert.Paired.treeSpace A 4) = 8 ∧
                    Module.finrank K ↥(RKCert.Paired.treeSpace A 5) ≤ 9 ∧
                      RKCert.Paired.back A b 2 = RKCert.Paired.annih (RKCert.Paired.treeSpace A 4)
RKCert.Paired.order8_treeSpace_four_not_clock_invariant.{u_1} {K : Type u_1} [Field K] [CharZero K]
  {A : Fin 10 → Fin 10 → K} {b : RKCert.Paired.Vec K 10} (ha : RKCert.StrictLower A)
  (ho : RKCert.HasTreeOrderAtLeast A b 8) :
  ¬Submodule.map (RKCert.Paired.diag (RKCert.nodes A)) (RKCert.Paired.treeSpace A 4) ≤ RKCert.Paired.treeSpace A 4
RKCert.Paired.order8_off_count_chart.{u_1} {K : Type u_1} [Field K] [CharZero K] {A : Fin 10 → Fin 10 → K}
  {b : RKCert.Paired.Vec K 10} (ha : RKCert.StrictLower A) (ho : RKCert.HasTreeOrderAtLeast A b 8) :
  have n := (RKCert.Paired.supportedNodes A (RKCert.Paired.qdef A)).card;
  n = 1 ∨ n = 4 ∨ n = 5 ∨ 7 ≤ n
RKCert.Paired.order8_five_on_of_middle_offs.{u_1} {K : Type u_1} [Field K] [CharZero K] {A : Fin 10 → Fin 10 → K}
  {b : RKCert.Paired.Vec K 10} (ha : RKCert.StrictLower A) (ho : RKCert.HasTreeOrderAtLeast A b 8)
  (hN :
    (RKCert.Paired.supportedNodes A (RKCert.Paired.qdef A)).card = 4 ∨
      (RKCert.Paired.supportedNodes A (RKCert.Paired.qdef A)).card = 5) :
  (RKCert.Paired.onNodes A).card = 5
RKCert.Paired.order9_twelve_stage_chart.{u_1} {K : Type u_1} [Field K] [CharZero K] {A : Fin 12 → Fin 12 → K}
  {b : RKCert.Paired.Vec K 12} (ha : RKCert.StrictLower A) (ho : RKCert.HasTreeOrderAtLeast A b 9) :
  b (Fin.last 11) ≠ 0 ∧
    Module.finrank K ↥(RKCert.Paired.zeroSpace A 3) = 2 ∧
      Module.finrank K ↥(RKCert.Paired.zeroSpace A 4) = 3 ∧
        Module.finrank K ↥(RKCert.Paired.treeSpace A 3) = 6 ∧
          Module.finrank K ↥(RKCert.Paired.treeSpace A 4) = 8 ∧
            9 ≤ Module.finrank K ↥(RKCert.Paired.treeSpace A 5) ∧
              Module.finrank K ↥(RKCert.Paired.treeSpace A 5) ≤ 10 ∧
                Module.finrank K ↥(RKCert.Paired.treeSpace A 6) ≤ 11
RKCert.Paired.order9_treeSpace_five_not_clock_invariant.{u_1} {K : Type u_1} [Field K] [CharZero K]
  {A : Fin 12 → Fin 12 → K} {b : RKCert.Paired.Vec K 12} (ha : RKCert.StrictLower A)
  (ho : RKCert.HasTreeOrderAtLeast A b 9) :
  ¬Submodule.map (RKCert.Paired.diag (RKCert.nodes A)) (RKCert.Paired.treeSpace A 5) ≤ RKCert.Paired.treeSpace A 5
RKCert.Paired.order9_no_four_off_nodes.{u_1} {K : Type u_1} [Field K] [CharZero K] {A : Fin 12 → Fin 12 → K}
  {b : RKCert.Paired.Vec K 12} (ha : RKCert.StrictLower A) (ho : RKCert.HasTreeOrderAtLeast A b 9) :
  (RKCert.Paired.supportedNodes A (RKCert.Paired.qdef A)).card ≠ 4
RKCert.Paired.order9_reduced_off_count_chart.{u_1} {K : Type u_1} [Field K] [CharZero K] {A : Fin 12 → Fin 12 → K}
  {b : RKCert.Paired.Vec K 12} (ha : RKCert.StrictLower A) (ho : RKCert.HasTreeOrderAtLeast A b 9) :
  have n := (RKCert.Paired.supportedNodes A (RKCert.Paired.qdef A)).card;
  n = 1 ∨ 5 ≤ n
