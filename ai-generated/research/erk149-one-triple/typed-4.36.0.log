@early_defect_plane : ∀ {K : Type u_1} [inst : Field K] [CharZero K] (a w v k : K),
  -(a ^ 2 * w / 2) * -(a ^ 3 * v / 6) - (k * a * w - a ^ 2 * v / 2) * -(a ^ 3 * w / 6) = k * a ^ 4 * w ^ 2 / 6
@post_triple_anchor_first_resonance : ∀ {K : Type u_1} [inst : Field K] [CharZero K] (a c t nu lam : K),
  t ≠ 0 →
    nu * a ^ 3 + 3 * a * lam * c ^ 2 - 2 * lam * c ^ 3 = 0 →
      nu * a ^ 2 + lam * c ^ 2 = t ^ 3 / 3 → nu * a ^ 3 + lam * c ^ 3 = t ^ 4 / 4 → t = 2 * a
@internal_anchor_first_resonance : ∀ {K : Type u_1} [inst : Field K] [CharZero K] (a c t nu lam x z : K),
  a ≠ 0 →
    t ≠ 0 →
      -nu * a ^ 2 / 2 + a * x + c * z = 0 →
        -a ^ 2 * x / 2 - lam * a * c ^ 2 / 4 = 0 →
          -nu * a ^ 3 / 3 + a ^ 2 * x + c ^ 2 * z + lam * c ^ 2 * (3 * a - 2 * c) / 6 = 0 →
            nu * a ^ 2 + lam * c ^ 2 = t ^ 3 / 3 → nu * a ^ 3 + lam * c ^ 3 = t ^ 4 / 4 → t = 2 * c
'RKResearch.Certified.ERK149TripleDormant.early_defect_plane' depends on axioms: [propext, Classical.choice, Quot.sound]
'RKResearch.Certified.ERK149TripleDormant.post_triple_anchor_first_resonance' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'RKResearch.Certified.ERK149TripleDormant.internal_anchor_first_resonance' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
