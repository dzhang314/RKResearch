@one_weighted_site_two_moments : ∀ {K : Type u_1} [inst : Field K] [CharZero K] (a t m : K),
  t ≠ 0 → m * a = t ^ 2 / 2 → m * a ^ 2 = t ^ 3 / 3 → t = 3 * a / 2
@early_ghost_second_remainder : ∀ {K : Type u_1} [inst : Field K] [CharZero K] (a s : K),
  a ≠ 0 →
    have t := 3 * a / 2;
    (a + t) * s ^ 3 / 3 - a * t * s ^ 2 / 2 - s ^ 4 / 4 + a ^ 3 / 8 * (s ^ 2 * (3 * t - 2 * s) / (6 * a * (t - a))) =
      -s ^ 2 * (2 * s - 3 * a) ^ 2 / 16
@middle_ghost_resonance : ∀ {K : Type u_1} [inst : Field K] [CharZero K] (c b t : K),
  c ≠ 0 → t ≠ 0 → (t - 2 * c) * t ^ 3 = 0 → 6 * b * c - 4 * (b + c) * t + 3 * t ^ 2 = 0 → t = 2 * c ∧ b = 2 * c
@doubled_site_cubic : ∀ {K : Type u_1} [inst : Field K] [CharZero K] (c s : K),
  (c + 2 * c) * s ^ 3 / 3 - c * (2 * c) * s ^ 2 / 2 - s ^ 4 / 4 = -s ^ 2 * (s - 2 * c) ^ 2 / 4
