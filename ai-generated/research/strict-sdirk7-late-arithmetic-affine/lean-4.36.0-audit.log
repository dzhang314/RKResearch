RKResearch.Certified.SDIRKSevenLateArithmeticAffine.terminal_identity (u i j k : ℚ) :
  terminalRaw u i j k =
    2 * RKResearch.Certified.SDIRKSevenDirtyArithmeticAtlas.T u * (u - 1) ^ 3 *
