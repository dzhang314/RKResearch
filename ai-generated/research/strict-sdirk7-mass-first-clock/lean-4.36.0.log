RKResearch.Certified.SDIRKSevenChristoffelAlternativeF19.q_profile_schedule {x : ℚ} (h₁ : x ≠ 1)
  (hM : x ^ 2 - 4 * x + 2 ≠ 0) :
  (2 - qTap x) * qFirst x + qTap x - 1 = 0 ∧ x ^ 2 - 3 * x + 1 - qTap x * (x ^ 2 - 4 * x + 2) / 2 = 0
