RKResearch.Certified.SDIRKSevenTwoGhostScalar.seven_active_rank.{u_1} {K : Type u_1} [Field K] {b : Fin 7 → K}
  (hb : ∀ (i : Fin 7), b i ≠ 0) {P W : Submodule K (Fin 7 → K)} (p : Module.finrank K ↥P = 4) (dis : Disjoint P W)
  (orth : Submodule.map (RKResearch.Certified.Graded.diag b) W ≤ RKResearch.Certified.Graded.Reverse.annih (P ⊔ W)) :
  Module.finrank K ↥W ≤ 1
RKResearch.Certified.SDIRKSevenTwoGhostScalar.gram_kernel.{u_2} {R : Type u_2} [CommRing R] {a b c : R}
