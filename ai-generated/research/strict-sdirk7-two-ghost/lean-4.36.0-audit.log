RKResearch.Certified.SDIRKSevenTwoGhostScalar.centered_radius_pivot {A B r s : ℚ} (hb : B ≠ 0)
  (h :
    A * RKResearch.Certified.SDIRKSevenPairedClean.momNum r s -
        B * RKResearch.Certified.SDIRKSevenPairedClean.momDen r s =
      0) :
  A * (s / 3 - 1 / 5) - B * (s - 1 / 3) ≠ 0
RKResearch.Certified.SDIRKSevenTwoGhostScalar.parity_det (a b m₀ m₂ m₄ : ℚ) :
  (a ^ 2 * m₀ + b ^ 2 * m₂) * (a ^ 2 * m₂ + b ^ 2 * m₄) - (2 * a * b * m₂) ^ 2 =
    a ^ 4 * m₀ * m₂ + a ^ 2 * b ^ 2 * (m₀ * m₄ - 3 * m₂ ^ 2) + b ^ 4 * m₂ * m₄
RKResearch.Certified.SDIRKSevenTwoGhostScalar.crt_gram_det (s p u₄ v₀ v₁ : ℚ) :
  v₁ * (u₄ + s * v₀ + (s ^ 2 - p) * v₁) - (v₀ + s * v₁) ^ 2 = v₁ * u₄ - v₀ ^ 2 - s * v₀ * v₁ - p * v₁ ^ 2
